() {\n    var base = JSON.parse(JSON.stringify((S.data && S.data.settings) || DEF_SETTINGS)); if (!root) return base;\n    root.querySelectorAll('[data-set]').forEach(function (el) { var path = el.getAttribute('data-set').split('.'); var o = base; for (var i = 0; i < path.length - 1; i++) o = o[path[i]] = o[path[i]] || {}; var k = path[path.length - 1]; o[k] = el.type === 'checkbox' ? el.checked : (el.type === 'number' ? (el.value === '' ? '' : +el.value) : el.value); });\n    return base;\n  }\n\n  /* ---------- show mode ---------- */\n  function showPrice(l, n) { var it = l.item; var base = it.promo || it.list; var w = DB.settings.show; var bundle = n >= (+w.bundleMin || 1e9); var auto = bundle ? Math.round(base * (1 - (+w.bundlePct || 0) / 100)) : base; return { base: base, auto: auto, bundle: bundle }; }\n  function vShow() {\n    var sh = S.show, n = sh.lines.length, r = role(), w = DB.settings.show;\n    var h = '<div class=\"sjST_ey\">Trade-show mode</div><h1 class=\"sjST_h1\">Scan it. It\u2019s in their cart.</h1><p class=\"sjST_sub\">Promo and bundle prices apply on scan. You can move a price down to your floor; past that, an owner signs off.</p><div class=\"sjST_split\"><div>';\n    h += '<div class=\"sjST_scanw\" style=\"background:#261d3d\"><label for=\"sjST_scan\">Scan a tag or type a stock number</label><input id=\"sjST_scan\" class=\"sjST_scan\" data-scan=\"show\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"SJT-\u2026\" data-autofocus><div class=\"sjST_left\"><b>' + n + '</b><small>PIECES</small></div></div>';\n    if (n >= (+w.bundleMin || 1e9)) h += '<div class=\"sjST_flash ok\">Bundle on: ' + w.bundlePct + '% off every piece (' + w.bundleMin + '+ pieces).</div>'; else if (n) h += '<div class=\"sjST_flash ask\">' + ((+w.bundleMin) - n) + ' more piece(s) and the whole cart drops ' + w.bundlePct + '%.</div>';\n    h += '<div class=\"sjST_card\">' + (n ? sh.lines.map(function (l, i) { var p = showPrice(l, n); var fl = floorFor(l.item, p.au