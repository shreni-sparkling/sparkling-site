 */\n  function tourSteps() {\n    var all = [\n      ['overview', '[data-tab=overview]', 'Home', 'Your day at a glance: new requests, emails waiting for approval, stones that came back, sync health. Everything here links to its section. The date range at the top applies to every report.'],\n      ['orders', '[data-tab=orders]', 'Orders', 'Every request from every page \u2014 diamonds, gemstones and jewelry offers, including the ones imported from the promo page. Click a row to open it: set the status (New \u2192 Contacted \u2192 Confirmed \u2192 Paused \u2192 In progress \u2192 Fulfilled / Not fulfilled / Cancelled), add a memo that goes into the customer email, verify RJO / NIJA membership, see the exact filters the buyer used and where they came from. Known customers (linked to an ERP # with KYC on file) show a green VERIFIED badge \u2014 no re-checking. Questions about a stone (video, photos, details) arrive here too, marked QUESTION, with the reply waiting in the Outbox. MINE shows only your own customers.'],\n      ['vmatch', '[data-tab=vmatch]', 'Video matches', 'Diamonds with no video of their own borrow the photo and video of their closest twin, labelled \u201csimilar diamond shown\u201d and never with a link to the real video. Twins and good matches switch on automatically every time inventory updates. The rest wait here: USE THIS VIDEO or DON\u2019T USE, and the site picks it up within 5 minutes.'],\n      ['outbox', '[data-tab=outbox]', 'Outbox \u00b7 approve emails', 'No customer email leaves without a person looking at it. Open an email to see it exactly as the customer will, edit the text, reassign it to a colleague, then APPROVE & SEND or REJECT. Automatic emails (still interested?, last call, a wanted stone is back, similar stones) all land here first.'],\n      ['follow', '[data-tab=follow]', 'Follow-ups', 'Stones buyers asked for while they were on hold, and sourcing requests. When a stone frees up or a match arrives, the buyer\u2019s email is drafted for you. NOTIFY / SEND SIMILAR do it by hand.'],\n      ['customers', '[data-tab=customers]', 'Customers', 'One line per buyer with order count, open orders and value, their owner, and the channel they use (WhatsApp / email). LINK attaches their ERP customer # and KYC status, or paste the whole ERP customer export once \u2014 from then on their orders are verified automatically. Below: anonymous carts \u2014 people who added stones but never sent \u2014 and the Mailchimp match-up that puts names on them.'],\n      ['inventory', '[data-tab=inventory]', 'Inventory & sync', 'What the page shows right now, the OneDrive workbook sync (every 15 min, 24/7), TEST CONNECTION, SYNC NOW, and a manual CSV upload. \u201cValue fixes\u201d is where you tell the page what an unknown shape code or availability word means \u2014 it emails you once when the sheet says something new.'],\n      ['promos', '[data-tab=promos]', 'Promotions & sale', 'Flag stock numbers as PROMO or SALE (fixed price or % off). The page highlights them; members never get an extra discount on promoted stones.'],\n      ['pricing', '[data-tab=pricing]', 'Pricing \u00b7 groups \u00b7 bundles', 'Adjust every price by a %, hide prices unless someone has a price-list link, one-off overrides, RJO / NIJA rules (6% off loose, tiers, $35 shipping), bundles (N stones for one price), and the stud / tennis-bracelet prices for the Jewelry Offers tab \u2014 lower one and the page shows the old price struck through.'],\n      ['insights', '[data-tab=insights]', 'Insights', 'What buyers do on the page: visits, funnel and drop-off, every filter option (demand vs what you stock), searches that found nothing, popular stones, page UX problems, and smart suggestions for buying and promoting. Jewelry-page activity is included.'],\n      ['posthog', '[data-tab=posthog]', 'PostHog', 'If you connect PostHog, its dashboard and quick numbers show here next to the Google Sheet tracking.'],\n      ['emails', '[data-tab=emails]', 'Email design', 'The templates for every automatic email with a live preview, your own HTML signature, the company signature, logo and footer, and the sales@ sending address.'],\n      ['settings', '[data-tab=settings]', 'Automation & settings', 'Link the other pages\u2019 Google Sheets so their orders and visits flow in; hold rules; the \u201cstill interested?\u201d and last-call timing; shipping fees; sync interval; PostHog and Mailchimp keys; the API key for Sparkling Intelligence.'],\n      ['pages', '[data-tab=pages]', 'Page designs', 'Drop a new Claude Design export here. It is prepared automatically and can be published to Netlify with one click. Every version is kept \u2014 roll back any time. Orders and data are never inside the HTML, so a new design never loses anything.'],\n      ['team', '[data-tab=team]', S.role === 'owner' ? 'Team & security' : 'My account', S.role === 'owner' ? 'Add or remove staff, decide who may publish inventory (max 2), require 2-step verification, reset logins, sign people out everywhere, and print offline recovery codes for yourself.' : 'Change your password, set up 2-step verification and your email signature.']\n    ];\n    return all.filter(function (st) { return tabsFor().some(function (t) { return t[0] === st[0]; }); });\n  }\n  function tourStart() { S.tour = 0; var st = tourSteps()[0]; if (st && S.tab !== st[0]) { S.tab = st[0]; } render(); }\n  function tourStop(done) { S.tour = null; try { if (done) localStorage.setItem('sj_admin_tour', '1'); } catch (e) {} render(); }\n  function tourGo(d) { var steps = tourSteps(); var n = (S.tour || 0) + d; if (n < 0) n = 0; if (n >= steps.length) { tourStop(true); return; } S.tour = n; var st = steps[n]; if (S.tab !== st[0]) { S.tab = st[0]; var tb = root.querySelector('[data-tab=\"' + st[0] + '\"]'); if (tb) { tb.click(); return; } } render(); }\n  function tourDraw() {\n    if (S.tour == null || !S.token) return; var steps = tourSteps(); var st = steps[S.tour]; if (!st) return;\n    