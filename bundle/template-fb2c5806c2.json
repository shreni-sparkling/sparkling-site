); }); };\n\n  /* ---------------------------------------------------------------- staff: leads + abandoned carts */\n  var rLeads = function () {\n    loading();\n    api('vf_leads', {}).then(function (r) {\n      if (!r.ok) return setBody('<p class=\"sjVF_err\">' + esc(r.error) + '</p>');\n      var h = '<h1 class=\"sjVF_h1\">Saved leads and carts</h1><p class=\"sjVF_lede\">People who gave us an email but have not ordered. A nudge goes to Email approvals first; nothing sends on its own.' + (r.scope === 'assigned' ? ' You see the ones linked to your clients.' : '') + '</p>' +\n        '<div class=\"sjVF_filters\"><button type=\"button\" class=\"sjVF_chip\" data-act=\"ltab\" data-v=\"carts\" aria-pressed=\"' + (S.leadsTab === 'carts') + '\">Abandoned carts \u00b7 ' + r.carts.length + '</button><button type=\"button\" class=\"sjVF_chip\" data-act=\"ltab\" data-v=\"leads\" aria-pressed=\"' + (S.leadsTab === 'leads') + '\">Saved leads \u00b7 ' + r.leads.length + '</button></div>';\n      if (S.leadsTab === 'carts') h += r.carts.length ? '<table class=\"sjVF_tbl\"><thead><tr><th>Who</th><th>In the cart</th><th>Value</th><th>Account</th><th>Last touched</th><th></th></tr></thead><tbody>' + r.carts.map(function (c) { return '<tr><td data-l=\"Who\"><b style=\"color:#fff\">' + esc(c.email) + '</b><br><span class=\"sjVF_note\">' + esc([c.contact, c.company].filter(Boolean).join(' \u00b7 ') || 'No name given') + '</span></td><td data-l=\"In the cart\">' + c.items.map(function (i) { return esc(i.k + ': ' + i.d); }).join('<br>') + '</td><td data-l=\"Value\">' + money(c.total) + '</td><td data-l=\"Account\">' + esc(c.account) + '</td><td data-l=\"Last touched\">' + esc(when(c.at)) + (c.nudged ? '<br><span class=\"sjVF_note\">Nudged ' + esc(when(c.nudged)) + '</span>' : '') + '</td><td><button type=\"button\" class=\"sjVF_btn s\" data-act=\"nudge\" data-k=\"cart\" data-id=\"' + esc(c.id) + '\">Send a nudge</button></td></tr>'; }).join('') + '</tbody></table>' : '<div class=\"sjVF_card\"><p style=\"margin:0\">No saved carts right now.</p></div>';\n      else h += r.leads.length ? '<table class=\"sjVF_tbl\"><thead><tr><th>Email</th><th>Phone</th><th>Where they signed up</th><th>Account</th><th>When</th><th></th></tr></thead><tbody>' + r.leads.map(function (l) { return '<tr><td data-l=\"Email\"><b style=\"color:#fff\">' + esc(l.email) + '</b></td><td data-l=\"Phone\">' + esc(l.phone || '\u2014') + '</td><td data-l=\"Where they signed up\">' + esc(l.source) + ' \u00b7 ' + esc(l.page) + '</td><td data-l=\"Account\">' + esc(l.account) + '</td><td data-l=\"When\">' + esc(when(l.at)) + (l.nudged ? '<br><span class=\"sjVF_note\">Nudged ' + esc(when(l.nudged)) + '</span>' : '') + '</td><td><button type=\"button\" class=\"sjVF_btn s\" data-act=\"nudge\" data-k=\"lead\" data-id=\"' + esc(l.id) + '\">Send a nudge</button></td></tr>'; }).join('') + '</tbody></table>' : '<div class=\"sjVF_card\"><p style=\"margin:0\">No saved leads yet.</p></div>';\n      setBody(h);\n    });\n  };\n  var nudgeModal = function (kind, id) {\n    api('vf_nudge_preview', { kind: kind, id: id }).then(function (p) {\n      if (!p.ok) return toast(p.error);\n      var m = document.createElement('div'); m.className = 'sjVF_modal'; m.setAttribute('role', 'dialog'); m.setAttribute('aria-modal', 'true'); m.setAttribute('aria-label', 'Send a nudge');\n      m.innerHTML = '<form class=\"bx\"><div class=\"sjVF_ey\">Nudge \u00b7 goes to Email approvals</div><h2 class=\"sjVF_h1\" style=\"font-size:24px\">To ' + esc(p.to) + '</h2><label class=\"sjVF_f\"><span>Subject</span><input name=\"subject\" value=\"' + esc(p.subject) + '\"></label><label class=\"sjVF_f\"><span>Message</span><textarea name=\"body\" rows=\"9\" style=\"min-height:200px\">' + esc(p.body) + '</textarea></label><p class=\"sjVF_note\">An owner approves it before it goes out.</p><div class=\"sjVF_row\" style=\"margin-top:12px\"><button class=\"sjVF_btn p\" type=\"submit\">Queue for approval</button><button class=\"sjVF_btn\" type=\"button\" data-x>Cancel</button></div></form>';\n      document.body.appendChild(m); var f = m.querySelector('form'); f.querySelector('input').focus();\n      m.addEventListener('click', function (e) { if (e.target === m || e.target.hasAttribute('data-x')) m.remove(); });\n      m.addEventListener('keydown', function (e) { if (e.key === 'Escape') m.remove(); });\n      f.addEventListener('submit', function (e) { e.preventDefault(); api('vf_nudge', { kind: kind, id: id, subject: f.subject.value, body: f.body.value }).then(function (r) { m.remove(); if (!r.ok) return toast(r.error); toast('Queued for approval: ' + r.queued.id); rLeads(); }); });\n    });\n  };\n\n  /* ---------------------------------------------------------------- staff: RJO */\n  var rRjo = function () {\n    loading();\n    api('vf_rjo', {}).then(function (r) {\n      if (!r.ok) return setBody('<p class=\"sjVF_err\">' + esc(r.error) + '</p>');\n      var R = r.rule;\n      var h = '<h1 class=\"sjVF_h1\">RJO members</h1><p class=\"sjVF_lede\">Every application is checked against this list, by member number and by store name and city, so a member who forgets to say so still gets flagged.</p>' +\n        '<div class=\"sjVF_card\"><h3>Flagged applications</h3>' + (r.flagged.length ? '<table class=\"sjVF_tbl\"><thead><tr><th>Applicant</th><th>Number given</th><th>Result</th><th>How we matched</th><th>Status</th></tr></thead><tbody>' + r.flagged.map(function (f) { return '<tr><td data-l=\"Applicant\"><a href=\"#vf-queue\" data-act=\"openreq\" data-id=\"' + esc(f.id) + '\" style=\"color:#fff;font-weight:800\">' + esc(f.company) + '</a></td><td data-l=\"Number given\">' + esc(f.claimed || 'Did not say') + '</td><td data-l=\"Result\">' + rjoTag(f.result) + '</td><td data-l=\"How we matched\">' + esc(f.how) + '</td><td data-l=\"Status\">' + statusTag(f.status) + '</td></tr>'; }).join('') + '</tbody></table>' : '<p class=\"sjVF_note\">No RJO hits yet.</p>') + '</div>' +\n        '<form class=\"sjVF_card\" data-form=\"rjorule\"><h3>RJO terms and memo credit</h3><p class=\"sjVF_note\" style=\"margin:0 0 12px\">The memo credit rule is not final. The numbers below are placeholders until confirmed.</p><div class=\"sjVF_grid2\">' +\n        '<label class=\"sjVF_f\"><span>Starting memo credit ($)</span><input name=\"startCredit\" inputmode=\"numeric\" value=\"' + esc(R.startCredit) + '\"></label>' +\n        '<label class=\"sjVF_f\"><span>Match invoiced + paid over (months)</span><input name=\"months\" inputmode=\"numeric\" value=\"' + esc(R.months) + '\"></label>' +\n        '<label class=\"sjVF_f\"><span>Match at (% of invoiced + paid)</span><input name=\"matchPct\" inputmode=\"numeric\" value=\"' + esc(R.matchPct) + '\"></label>' +\n        '<label class=\"sjVF_f\"><span>Locked memo term (days)</span><input name=\"memoDays\" inputmode=\"numeric\" value=\"' + esc(R.memoDays) + '\"></label></div>' +\n        '<label class=\"sjVF_chk\"><input type=\"checkbox\" name=\"on\"' + (R.on ? ' checked' : '') + '> Grow the memo credit with invoiced + paid orders</label><label class=\"sjVF_chk\"><input type=\"checkbox\" name=\"lockShipping\"' + (R.lockShipping ? ' checked' : '') + '> Lock shipping for RJO members</label><label class=\"sjVF_chk\"><input type=\"checkbox\" name=\"lockMemo\"' + (R.lockMemo ? ' checked' : '') + '> Lock memo terms for RJO members</label>' +\n        '<p class=\"sjVF_note\">Example: a member who invoiced and paid ' + money(8000) + ' in the last ' + esc(R.months) + ' months gets a memo line of ' + money(R.on ? Math.max(R.startCredit, 8000 * R.matchPct / 100) : R.startCredit) + '.</p><div class=\"sjVF_err\" aria-live=\"polite\"></div><button class=\"sjVF_btn p\" type=\"submit\">Save RJO rule</button></form>' +\n        '<form class=\"sjVF_card\" data-form=\"rjoupload\"><h3>Update the member list</h3><p class=\"sjVF_note\" style=\"margin:0 0 10px\">Paste rows from the RJO list: member number, store name, city, status (active, on hold or inactive). One row per line. Existing numbers are updated.</p><label class=\"sjVF_f\"><span>Rows</span><textarea name=\"text\" placeholder=\"RJO-T-5601, New Test Store, Testtown OH, active\"></textarea></label><div class=\"sjVF_err\" aria-live=\"polite\"></div><button class=\"sjVF_btn\" type=\"submit\">Update the list</button></form>' +\n        '<div class=\"sjVF_card\"><h3>On the list \u00b7 ' + r.members.length + '</h3><table class=\"sjVF_tbl\"><thead><tr><th>Number</th><th>Store</th><th>City</th><th>Status</th></tr></thead><tbody>' + r.members.map(function (m) { return '<tr><td data-l=\"Number\">' + esc(m.no) + '</td><td data-l=\"Store\">' + esc(m.store) + '</td><td data-l=\"City\">' + esc(m.city) + '</td><td data-l=\"Status\">' + rjoTag(m.status) + '</td></tr>'; }).join('') + '</tbody></table></div>';\n      setBody(h);\n    });\n  };\n\n  /* ---------------------------------------------------------------- staff: companies */\n  var permChips = function (u) { if (u.owner) return '<span class=\"sjVF_tag sv\">Account owner \u00b7 full access</span>'; var P = u.perms || []; if (P.length === PERM_KEYS.length) return '<span class=\"sjVF_tag ok\">Full access</span>'; return P.length ? P.map(function (k) { return '<span class=\"sjVF_tag\">' + esc(PERM_LABEL[k]) + '</span>'; }).join('') : '<span class=\"sjVF_tag warn\">Browse and favorite only</span>'; };\n  var liabLine = function (L) { return L ? 'Liability notice accepted by ' + esc(L.by) + ' \u00b7 ' + esc(new Date(L.at).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })) + ' \u00b7 wording ' + esc(L.wording) : ''; };\n  var rCompanies = function () {\n    loading();\n    api('vf_companies', {}).then(function (r) {\n      if (!r.ok) return setBody('<p class=\"sjVF_err\">' + esc(r.error) + '</p>');\n      var h = '<h1 class=\"sjVF_h1\">Company accounts</h1><p class=\"sjVF_lede\">Logins grouped by company. The first login is the account owner and approves colleagues. Every login is tracked on its own, with who added it and when they accepted responsibility for its orders.</p>' +\n        r.companies.map(function (c) { return '<div class=\"sjVF_card\"><div class=\"sjVF_row\" style=\"justify-content:space-between\"><div><div class=\"sjVF_ey\">' + esc(c.id) + ' \u00b7 customer ' + esc(c.customer) + '</div><b style=\"color:#fff;font-size:17px\">' + esc(c.name) + '</b><p class=\"sjVF_note\">' + esc(c.address) + (c.domain ? ' \u00b7 @' + esc(c.domain) : ' \u00b7 personal email domain: colleagues must match the address to ask to join') + '</p></div><span class=\"sjVF_tag ' + (c.mgmt ? 'sv' : '') + '\">Per-login limits ' + (c.mgmt ? 'on' : 'off') + '</span></div>' +\n          '<table class=\"sjVF_tbl\" style=\"margin-top:10px\"><thead><tr><th>Login</th><th>Status</th><th>Can do</th><th>Added</th></tr></thead><tbody>' + c.users.map(function (u) { return '<tr><td data-l=\"Login\"><b style=\"color:#fff\">' + esc(u.name) + '</b><br><span class=\"sjVF_note\">' + esc(u.email) + '</span></td><td data-l=\"Status\">' + statusTag(u.status === 'active' ? 'Active' : 'With account owner') + (u.accessAsk ? '<span class=\"sjVF_tag warn\">Asked to order</span>' : '') + (u.via ? '<br><span class=\"sjVF_note\">Matched on: ' + esc(u.via) + '</span>' : '') + '</td><td data-l=\"Can do\">' + permChips(u) + '</td><td data-l=\"Added\">' + (u.owner ? 'Opened the account' : u.added ? 'By ' + esc(u.added.by) + ' \u00b7 ' + esc(when(u.added.at)) + '<br><span class=\"sjVF_note\">' + liabLine(u.added.liability) + '</span>' : '\u2014') + '</td></tr>'; }).join('') + '</tbody></table>' +\n          ((c.invites || []).length ? '<h3 style=\"margin-top:14px\">Invites</h3>' + c.invites.map(function (x) { return '<p style=\"margin:0 0 6px\">' + esc(x.name || x.email) + ' \u00b7 ' + esc(x.email) + ' \u00b7 ' + esc(x.status) + ' \u00b7 sent by ' + esc(x.by) + ' ' + esc(when(x.at)) + '<br><span class=\"sjVF_note\">' + liabLine(x.liability) + '</span></p>'; }).join('') : '') + '</div>'; }).join('');\n      setBody(h);\n    });\n  };\n\n  /* ---------------------------------------------------------------- staff: email approvals (outbox) */\n  var rOutbox = function () {\n    loading();\n    api('vf_outbox', {}).then(function (r) {\n      if (!r.ok) return setBody('<p class=\"sjVF_err\">' + esc(r.error) + '</p>');\n      var pend = r.outbox.filter(function (o) { return o.status === 'Pending'; });\n      var h = '<h1 class=\"sjVF_h1\">Email approvals</h1><p class=\"sjVF_lede\">Customer emails from verification and nudges wait here. ' + (isOwner() ? 'Approve to send, edit first, or reject.' : 'An owner approves them.') + (LIVE() ? '' : ' Demo: approving sends nothing.') + '</p>';\n      h += r.outbox.length ? r.outbox.map(function (o) { return '<div class=\"sjVF_card\"><div class=\"sjVF_row\" style=\"justify-content:space-between\"><div class=\"sjVF_ey\" style=\"margin:0\">' + esc(o.id) + ' \u00b7 ' + esc(o.kind) + (o.ref ? ' \u00b7 ' + esc(o.ref) : '') + ' \u00b7 by ' + esc(o.by) + ' \u00b7 ' + esc(when(o.at)) + '</div>' + statusTag(o.status === 'Pending' ? 'Waiting for approval' : o.status === 'Approved' ? 'Approved' : 'Declined') + '</div><p style=\"margin:8px 0 2px;color:#fff;font-weight:800\">' + esc(o.subject) + '</p><p class=\"sjVF_note\" style=\"margin:0 0 8px\">To ' + esc(o.to) + '</p><pre style=\"white-space:pre-wrap;font:inherit;font-size:13px;color:#CFC5DB;margin:0 0 10px;max-height:180px;overflow:auto\">' + esc(o.body) + '</pre>' + (o.status === 'Pending' && isOwner() ? '<div class=\"sjVF_row\"><button type=\"button\" class=\"sjVF_btn s p\" data-act=\"ob\" data-op=\"approve\" data-id=\"' + esc(o.id) + '\">Approve and send</button><button type=\"button\" class=\"sjVF_btn s d\" data-act=\"ob\" data-op=\"reject\" data-id=\"' + esc(o.id) + '\">Reject</button></div>' : o.result ? '<p class=\"sjVF_note\">' + esc(o.result) + '</p>' : '') + '</div>'; }).join('') : '<div class=\"sjVF_card\"><p style=\"margin:0\">Nothing waiting. Approve someone or send a nudge and it lands here.</p></div>';\n      setBody(h); if (pend.length) { var b = document.getElementById('sjVF_obn'); if (b) b.textContent = pend.length; }\n    });\n  };\n\n  /* ---------------------------------------------------------------- staff: settings */\n  var rSettings = function () {\n    loading();\n    api('vf_settings', {}).then(function (r) {\n      if (!r.ok) return setBody('<p class=\"sjVF_err\">' + esc(r.error) + '</p>');\n      var s = r.settings, d = s.defaults;\n      setBody('<h1 class=\"sjVF_h1\">Approval settings</h1><p class=\"sjVF_lede\">These fill in the approval form for every new account. You can change them per account when you approve.</p>' +\n        '<form class=\"sjVF_card\" data-form=\"settings\"><h3>Defaults for new accounts</h3><div class=\"sjVF_grid2\"><label class=\"sjVF_f\"><span>Memo cap ($)</span><input name=\"memoCap\" inputmode=\"numeric\" value=\"' + esc(d.memoCap) + '\"></label><label class=\"sjVF_f\"><span>Deposit (%)</span><input name=\"deposit\" inputmode=\"numeric\" value=\"' + esc(d.deposit) + '\"></label><label class=\"sjVF_f\"><span>Payment terms (staff only)</span><input name=\"terms\" value=\"' + esc(d.terms) + '\"></label><label class=\"sjVF_f\"><span>Order cap ($)</span><input name=\"orderCap\" inputmode=\"numeric\" value=\"' + esc(d.orderCap) + '\"></label></div>' +\n        '<label class=\"sjVF_chk\"><input type=\"checkbox\" name=\"orderCapOn\"' + (d.orderCapOn ? ' checked' : '') + '> Use an order cap by default</label><label class=\"sjVF_chk\"><input type=\"checkbox\" name=\"card\"' + (d.card ? ' checked' : '') + '> Accept credit card by default</label>' +\n        '<h3 style=\"margin-top:18px\">Verification</h3><div class=\"sjVF_grid2\"><label class=\"sjVF_f\"><span>Trade references needed</span><input name=\"refsNeeded\" inputmode=\"numeric\" value=\"' + esc(s.refsNeeded) + '\"></label></div>' +\n        '<label class=\"sjVF_chk\"><input type=\"checkbox\" name=\"autoApproveRjo\"' + (s.autoApproveRjo ? ' checked' : '') + '> RJO members on the list and active can shop right away</label><label class=\"sjVF_chk\"><input type=\"checkbox\" name=\"notifyOwners\"' + (s.notifyOwners ? ' checked' : '') + '> Alert owners the moment someone asks to be verified</label>' +\n        '<h3 style=\"margin-top:18px\">Joining a company account</h3><p class=\"sjVF_note\" style=\"margin:0 0 10px\">Always on: a matching email domain alone never qualifies. Business email domain + same company name can ask to join. Personal email + same company name must also match the address on file. The account owner approves every join.</p><label class=\"sjVF_chk\"><input type=\"checkbox\" name=\"privateNameNeedsAddress\"' + ((s.match || {}).privateNameNeedsAddress !== false ? ' checked' : '') + '> Same company name but a different business domain must also match the address on file</label>' +\n        '<label class=\"sjVF_f\"><span>Personal email domains (never used to match a company)</span><textarea name=\"generic\">' + esc(s.generic) + '</textarea></label><div class=\"sjVF_err\" aria-live=\"polite\"></div><button class=\"sjVF_btn p\" type=\"submit\">Save settings</button></form>');\n    });\n  };\n\n  /* ---------------------------------------------------------------- buyer: get access (sign-up paths) */\n  var PATHS = [['new', 'New to Sparkling', 'Full trade application. About ten minutes, then we check your references.'], ['existing', 'I already buy from you', 'Tell us who you are. No paperwork again: we match you to your account.'], ['rjo', 'I am an RJO member', 'Give us your RJO number. If you are on the list, you can shop today.']];\n  var rStart = function () {\n    var d = S.startData || {};\n    var h = '<div style=\"max-width:860px;margin:0 auto\"><div class=\"sjVF_ey\">Sparkling access awaits</div><h1 class=\"sjVF_h1\">How do you buy with us?</h1><p class=\"sjVF_lede\">Wholesale only. Pick the one that fits and we take it from there.</p>' +\n      '<div class=\"sjVF_paths\" role=\"group\" aria-label=\"How do you buy with us\">' + PATHS.map(function (p) { return '<button type=\"button\" class=\"sjVF_path\" data-act=\"path\" data-v=\"' + p[0] + '\" aria-pressed=\"' + (S.path === p[0]) + '\"><b>' + esc(p[1]) + '</b><span>' + esc(p[2]) + '</span></button>'; }).join('') + '</div>';\n    if (S.path) {\n      h += '<form class=\"sjVF_card\" data-form=\"start\"><h3>' + ({ new: 'Start with the basics', existing: 'Tell us who you are', rjo: 'Your RJO membership' })[S.path] + '</h3><div class=\"sjVF_grid2\">' +\n        '<label class=\"sjVF_f\"><span>Your name</span><input name=\"contact\" autocomplete=\"name\" value=\"' + esc(d.contact || '') + '\" required></label>' +\n        '<label class=\"sjVF_f\"><span>Work email</span><input name=\"email\" type=\"email\" autocomplete=\"email\" value=\"' + esc(d.email || '') + '\" required></label>' +\n        '<label class=\"sjVF_f\"><span>Store or company name</span><input name=\"company\" autocomplete=\"organization\" value=\"' + esc(d.company || '') + '\" required></label>' +\n        '<label class=\"sjVF_f\"><span>Phone</span><input name=\"phone\" type=\"tel\" autocomplete=\"tel\" value=\"' + esc(d.phone || '') + '\"></label>' +\n        '<label class=\"sjVF_f\"><span>Street address</span><input name=\"street\" autocomplete=\"address-line1\" value=\"' + esc(d.street || '') + '\"></label>' +\n        '<label class=\"sjVF_f\"><span>City</span><input name=\"city\" autocomplete=\"address-level2\" value=\"' + esc(d.city || '') + '\"></label>' +\n        '<label class=\"sjVF_f\"><span>State</span><input name=\"state\" autocomplete=\"address-level1\" value=\"' + esc(d.state || '') + '\"></label>' +\n        '<label class=\"sjVF_f\"><span>ZIP</span><input name=\"zip\" autocomplete=\"postal-code\" inputmode=\"numeric\" value=\"' + esc(d.zip || '') + '\"></label>' +\n        (S.path === 'existing' ? '<label class=\"sjVF_f\" style=\"grid-column:1/-1\"><span>Who\\'s your Sparkling salesperson? (optional)</span><input name=\"repTyped\" autocomplete=\"off\" placeholder=\"First name is fine\" value=\"' + esc(d.repTyped || '') + '\"><small class=\"sjVF_note\" style=\"display:block;margin-top:6px\">Not sure? Skip it. Filling it in just gets you set up faster.</small></label>' + '<label class=\"sjVF_f\" style=\"grid-column:1/-1\"><span>Anything that helps us find you (optional)</span><input name=\"hint\" placeholder=\"Customer number or a recent invoice number\" value=\"' + esc(d.hint || '') + '\"></label>' : '') +\n        (S.path === 'rjo' ? '<label class=\"sjVF_f\"><span>RJO member number</span><input name=\"rjo\" value=\"' + esc(d.rjo || '') + '\" required></label>' : '') + '</div>' +\n        (S.path === 'existing' ? '<p class=\"sjVF_note\" style=\"margin:0 0 10px\">No uploads, no forms to sign again. We already have your paperwork.</p>' : '') +\n        '<div class=\"sjVF_err\" aria-live=\"polite\"></div><button class=\"sjVF_btn p\" type=\"submit\">' + ({ new: 'Continue', existing: 'Match my account', rjo: 'Check my membership' })[S.path] + '</button></form>';\n    }\n    if (S.join) h += joinPrompt();\n    h += '<p class=\"sjVF_note\" style=\"margin-top:16px\">Questions? Call ' + PHONE + ' or email ' + ACCT + '.</p></div>';\n    setBody(h);\n  };\n  var joinPrompt = function () {\n    var j = S.join;\n    if (j.verify) return '<div class=\"sjVF_modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Confirm the store address\"><form class=\"bx\" data-form=\"addrcheck\"><div class=\"sjVF_ey\">Are you with ' + esc(j.name) + '?</div><h2 class=\"sjVF_h1\" style=\"font-size:24px\">Confirm the store address on file</h2><p>' + esc(j.name) + ' already buys with us. To ask to join their account, enter the store address we have on file for them.' + (j.retry ? ' <b style=\"color:#F3B8B8\">That address did not match.</b>' : '') + '</p><label class=\"sjVF_f\"><span>Street address</span><input name=\"street\" autocomplete=\"address-line1\"></label><label class=\"sjVF_f\"><span>ZIP</span