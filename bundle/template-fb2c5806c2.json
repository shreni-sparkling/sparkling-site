rderCap || '') + '\" placeholder=\"No limit\"><small>Largest single order. Leave empty for no limit.</small></label></div>' +\n        '<label class=\"sjTM_f\"><span>Internal note</span><textarea name=\"note\" placeholder=\"Staff only. Never shown to the customer.\">' + esc(c.note) + '</textarea></label><button type=\"button\" class=\"sjTM_btn\" data-tm-do=\"save\">SAVE TERMS</button><span class=\"sjTM_err\" style=\"margin-left:12px\"></span></div></div>';\n      var w = shell('ACCOUNT TERMS', 'terms', '<h1 class=\"sjTM_h1\">Account terms</h1><p class=\"sjTM_sub\">Per-customer memo cap, deposit and pricing. The customer only ever sees \"pay now\" or \"memo\", never the full rule set.' + (ROLE() === 'sales' ? ' You see your assigned customers.' : '') + '</p><div class=\"sjTM_grid\"><div class=\"sjTM_card\"><div class=\"sjTM_scroll\"><table class=\"sjTM_tbl stack\"><thead><tr><th>CUSTOMER</th><th>TERMS</th><th>MEMO CAP</th><th>ON MEMO NOW</th><th>DEPOSIT</th><th>DAYS</th></tr></thead><tbody>' + (rows || '<tr><td colspan=\"6\">No customers assigned to you yet.</td></tr>') + '</tbody></table></div></div><div>' + form + '</div></div>');\n      w.addEventListener('click', function (e) { var t = e.target.closest('[data-tm-c],[data-tm-do]'); if (!t) return; if (t.hasAttribute('data-tm-c')) return scrTerms(t.getAttribute('data-tm-c'));\n        var f = w.querySelector('#sjTM_tf'); var g = function (n) { var el = f.querySelector('[name=\"' + n + '\"]'); return el.type === 'checkbox' ? el.checked : el.value; };\n        api('tm_terms_save', { id: c.id, payNowOnly: g('payNowOnly'), memoAllowed: g('memoAllowed'), memoCap: g('memoCap'), depositPct: g('depositPct'), pricing: g('pricing'), markupPct: g('markupPct'), days: g('days'), orderCap: g('orderCap') || 0, note: g('note') }).then(function (x) { if (!x.ok) { f.querySelector('.sjTM_err').textContent = x.error; return; } scrTerms(c.id); }); });\n    });\n  };\n\n  /* ================= STAFF: settings (owner) ================= */\n  var scrSettings = function () {\n    if (!can.settings(ROLE())) return gate('Settings', 'Owners only.');\n    loading('SETTINGS', 'settings');\n    api('tm_settings_get').then(function (r) {\n      if (!r.ok) return gate('Settings', r.error); var s = r.settings;\n      var num = function (n, l, h) { return '<label class=\"sjTM_f\"><span>' + l + '</span><input name=\"' + n + '\" type=\"number\" min=\"0\" value=\"' + esc(s[n]) + '\">' + (h ? '<small>' + h + '</small>' : '') + '</label>'; };\n      var txt = function (n, l, h) { return '<label class=\"sjTM_f\"><span>' + l + '</span><textarea name=\"' + n + '\">' + esc(s[n]) + '</textarea>' + (h ? '<small>' + h + '</small>' : '') + '</label>'; };\n      var w = shell('SETTINGS', 'settings', '<h1 class=\"sjTM_h1\">Memo and invoice defaults</h1><p class=\"sjTM_sub\">Used for new accounts and anywhere an account has no override. Last saved by ' + esc(s.updatedBy) + ' on ' + fmtD(s.updatedAt) + '.</p><div class=\"sjTM_card\"><div class=\"hd\"><span class=\"sjTM_lab\">Numbers</span></div><div class=\"bd\" id=\"sjTM_sf\"><div class=\"sjTM_3\">' + num('memoMarkupPct', 'Memo price markup (%)', 'Memo = pay-now price + this.') + num('depositPct', 'Default deposit (%)', 'Taken when the memo is signed.') + num('memoDays', 'Memo days', 'Return or invoice within this.') + '</div><div class=\"sjTM_3\"><label class=\"sjTM_f\"><span>Clock starts on</span><select name=\"memoStart\"><option value=\"ship\"' + (s.memoStart === 'ship' ? ' selected' : '') + '>Ship date</option><option value=\"delivery\"' + (s.memoStart === 'delivery' ? ' selected' : '') + '>Delivery date</option></select></label>' + num('restockAfterDays', 'Restocking fee after (days)', 'Counted from the ship date.') + num('restockPct', 'Restocking fee (%)', 'Legal review pending.') + '</div><div class=\"sjTM_3\">' + num('nearCapPct', 'Warn near cap at (%)', 'Cart shows a heads-up.') + num('memoShipping', 'Memo shipping ($)', 'Shown in the cart note.') + num('extMaxDays', 'Longest extension (days)', 'Most a buyer can ask for.') + '</div></div></div>' +\n        '<div class=\"sjTM_card\"><div class=\"hd\"><span class=\"sjTM_lab\">Payment hand-off</span></div><div class=\"bd\"><div class=\"sjTM_2\"><label class=\"sjTM_f\"><span>Processor name</span><input name=\"payProcessor\" value=\"' + esc(s.payProcessor) + '\"></label><label class=\"sjTM_f\"><span>Payment page link</span><input name=\"payUrl\" value=\"' + esc(s.payUrl) + '\" placeholder=\"https://\u2026 (empty = not connected)\"><small>The site never shows card fields. Pay sends the buyer here.</small></label></div>' + txt('payAlt', 'Other ways to pay (shown under Pay)', 'Zelle / wire instructions. Never paste full account numbers here.') + '</div></div>' +\n        '<div class=\"sjTM_card\"><div class=\"hd\"><span class=\"sjTM_lab\">Wording \u00b7 needs attorney review</span><span class=\"sjTM_pill warn\">Placeholder</span></div><div class=\"bd\">' + txt('esignText', 'E-signature consent (sign panel)') + txt('restockText', 'Restocking fee line', 'Use {days} and {pct}.') + txt('memoTerms', 'Memo terms (printed memo)') + txt('extText', 'Extension pop-up') + '<button type=\"button\" class=\"sjTM_btn\" data-tm-do=\"save\">SAVE SETTINGS</button><span class=\"sjTM_err\" style=\"margin-left:12px\"></span></div></div>');\n      w.querySelector('[data-tm-do=\"save\"]').onclick = function () { var p = {}; [].forEach.call(w.querySelectorAll('[name]'), function (el) { p[el.name] = el.value; }); api('tm_settings_save', p).then(function (x) { w.querySelector('.sjTM_err').textContent = x.ok ? 'Saved.' : x.error; }); };\n    });\n  };\n\n  /* ================= STAFF: memo builder (create from order, upload ERP memo, versions, replace flags, send) ================= */\n  var draft = null;\n  var scrBuilder = function (id) {\n    var r0 = ROLE(); if (!can.memoEdit(r0) && !can.scanIn(r0)) return gate('Memos', 'This login does not work on memos.');\n    loading('MEMOS', 'builder');\n    api('tm_memo_list').then(function (r) {\n      if (!r.ok) return gate('Memos', r.error);\n      if (id && id !== 'NEW') return api('tm_memo_get', { id: id }).then(function (x) { if (!x.ok) return gate('Memo', x.error); builderOne(x.memo, x.settings); });\n      if (id === 'NEW' && draft) return builderEdit(draft, r);\n      var ed = can.memoEdit(ROLE());\n      var rows = r.memos.map(function (m) { return '<tr><td data-l=\"Memo\"><a class=\"sjTM_lnk\" href=\"#tm-builder-' + esc(m.id.toLowerCase()) + '\">' + esc(m.id) + '</a> <span style=\"font-size:11.5px;color:#6b657a\">v' + m.v + '</span></td><td data-l=\"Customer\">' + esc(m.company || m.client) + '</td><td data-l=\"Status\">' + statusPill(m.status) + (m.replaced ? ' <span class=\"sjTM_pill warn\">' + m.replaced + ' replaced</span>' : '') + (m.returning ? ' <span class=\"sjTM_pill warn\">' + m.returning + ' returning</span>' : '') + '</td><td data-l=\"Due\">' + (m.due ? fmtD(m.due) : '\u2014') + '</td><td data-l=\"Open\">' + money0(m.open) + '</td></tr>'; }).join('');\n      var ords = r.orders.map(function (o) { return '<div style=\"display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;border-top:1px solid #ece6f1;flex-wrap:wrap\"><div><b>' + esc(o.id) + '</b> \u00b7 ' + esc(o.company) + '<div style=\"font-size:12px;color:#6b657a\">' + o.lines.length + ' lines \u00b7 ' + money0(sumOf(o.lines)) + '</div></div><div style=\"display:flex;gap:6px;flex-wrap:wrap\"><button type=\"button\" class=\"sjTM_btn sm\" data-tm-from=\"' + esc(o.id) + '\">BUILD MEMO</button><button type=\"button\" class=\"sjTM_btn sm alt\" data-tm-inv=\"' + esc(o.id) + '\">SEND TO INVOICE</button></div></div>'; }).join('');\n      var w = shell('MEMOS', 'builder', '<h1 class=\"sjTM_h1\">Memos</h1><p class=\"sjTM_sub\">Build a memo from an order or upload one written in the ERP. Every save is a new version; the buyer signs the latest.</p><div class=\"sjTM_grid\"><div class=\"sjTM_card\"><div class=\"sjTM_scroll\"><table class=\"sjTM_tbl stack\"><thead><tr><th>MEMO</th><th>CUSTOMER</th><th>STATUS</th><th>DUE</th><th>OPEN</th></tr></thead><tbody>' + rows + '</tbody></table></div></div><div>' + (ed ? '<div class=\"sjTM_card\"><div class=\"hd\"><span class=\"sjTM_lab\">Orders waiting for a memo</span></div><div class=\"bd\">' + (ords || '<div style=\"font-size:13px;color:#6b657a\">All caught up.</div>') + '</div></div><div class=\"sjTM_card\"><div class=\"hd\"><span class=\"sjTM_lab\">Upload an ERP memo</span></div><div class=\"bd\"><p style=\"margin:0 0 10px;font-size:12.5px;color:#4a4458\">Export the memo from the ERP as CSV (or paste it). One line per piece: SKU, description, qty, price. We convert it to the new memo design.</p><label class=\"sjTM_f\"><span>Customer</span><select id=\"sjTM_uc\">' + DB.clients.filter(function (c) { return ROLE() !== 'sales' || c.rep === demoStaff(); }).map(function (c) { return '<option value=\"' + esc(c.id) + '\">' + esc(c.company) + '</option>'; }).join('') + '</select></label><label class=\"sjTM_f\"><span>ERP memo file (CSV or TXT)</span><input type=\"file\" id=\"sjTM_uf\" accept=\".csv,.txt,text/csv,text/plain\"></label><label class=\"sjTM_f\"><span>Or paste the lines</span><textarea id=\"sjTM_ut\" placeholder=\"LG-TEST-033, 3.05 ct Emerald \u00b7 G \u00b7 VS1, 1, 396.50\"></textarea></label><button type=\"button\" class=\"sjTM_btn\" data-tm-do=\"upload\">CONVERT TO MEMO</button><div class=\"sjTM_err\"></div></div></div>' : '') + '</div></div>');\n      w.addEventListener('click', function (e) {\n        var t = e.target.closest('[data-tm-from],[data-tm-inv],[data-tm-do]'); if (!t) return;\n        if (t.hasAttribute('data-tm-from')) { var o = r.orders.filter(function (x) { return x.id === t.getAttribute('data-tm-from'); })[0]; draft = { order: o.id, client: o.client, company: o.company, source: 'order', lines: clone(o.lines), note: 'Built from order ' + o.id }; return go('tm-builder-new'); }\n        if (t.hasAttribute('data-tm-inv')) return api('tm_invoice_create', { from: t.getAttribute('data-tm-inv') }).then(function (x) { if (x.ok) go('tm-invoice-' + x.id.toLowerCase()); });\n        if (t.getAttribute('data-tm-do') === 'upload') { var er = w.querySelector('.sjTM_err'); var f = w.querySelector('#sjTM_uf').files[0]; var cid = w.querySelector('#sjTM_uc').value;\n          var run = function (text, name) { api('tm_memo_upload', { text: text, name: name }).then(function (x) { if (!x.ok) { er.textContent = x.error; return; } var c = DB.clients.filter(function (y) { return y.id === cid; })[0] || {}; draft = { order: '', client: cid, company: c.company, source: 'erp', lines: x.lines, note: 'Uploaded from ERP' + (name ? ' (' + name + ')' : '') }; go('tm-builder-new'); }); };\n          if (f) { var rd = new FileReader(); rd.onload = function () { run(String(rd.result || ''), f.name); }; rd.readAsText(f); } else run(w.querySelector('#sjTM_ut').value, ''); }\n      });\n    });\n  };\n  var editRows = function (lines) {\n    return lines.map(function (l, i) { return '<div class=\"sjTM_card\" data-i=\"' + i + '\" style=\"margin:0 0 10px\"><div class=\"bd\"><div class=\"sjTM_3\"><label class=\"sjTM_f\"><span>SKU</span><input data-k=\"sku\" value=\"' + esc(l.sku) + '\"></label><label class=\"sjTM_f\"><span>Type</span><select data-k=\"kind\"><option value=\"diamond\"' + (l.kind === 'diamond' ? ' selected' : '') + '>Loose diamond</option><option value=\"jewelry\"' + (l.kind === 'jewelry' ? ' selected' : '') + '>Jewelry</option><option value=\"bundle\"' + (l.kind === 'bundle' ? ' selected' : '') + '>Bundle (one block)</option></select></label><label class=\"sjTM_f\"><span>Price ($)</span><input data-k=\"price\" type=\"number\" step=\"0.01\" min=\"0\" value=\"' + esc(l.price) + '\"></label></div><div class=\"sjTM_2\"><label class=\"sjTM_f\"><span>Title</span><input data-k=\"title\" value=\"' + esc(l.title) + '\"></label><label class=\"sjTM_f\"><span>Details</span><input data-k=\"spec\" value=\"' + esc(l.spec) + '\"></label></div>' +\n      (l.replaced ? '<div class=\"sjTM_flag\" style=\"margin:0 0 10px\"><b>REPLACED \u00b7 SHOWN TO THE BUYER</b><div class=\"sjTM_2\" style=\"margin-top:8px\"><label class=\"sjTM_f\"><span>Original SKU they asked for</span><input data-r=\"orig\" value=\"' + esc(l.replaced.orig) + '\"></label><label class=\"sjTM_f\"><span>Original description</span><input data-r=\"origDesc\" value=\"' + esc(l.replaced.origDesc) + '\"></label></div><label class=\"sjTM_f\" style=\"margin:0\"><span>Why (the buyer reads this)</span><input data-r=\"why\" value=\"' + esc(l.replaced.why) + '\"></label></div>' : '') +\n      '<div style=\"display:flex;gap:6px;flex-wrap:wrap\"><button type=\"button\" class=\"sjTM_btn sm alt\" data-tm-rep=\"' + i + '\">' + (l.replaced ? 'REMOVE REPLACED FLAG' : 'WE REPLACED THIS') + '</button><button type=\"button\" class=\"sjTM_btn sm alt\" data-tm-del=\"' + i + '\">REMOVE LINE</button></div></div></div>'; }).join('');\n  };\n  var readRows = function (w, lines) { [].forEach.call(w.querySelectorAll('[data-i]'), function (el) { var l = lines[+el.getAttribute('data-i')]; [].forEach.call(el.querySelectorAll('[data-k]'), function (f) { var k = f.getAttribute('data-k'); l[k] = k === 'price' ? +f.value : f.value; }); if (l.kind === 'bundle') l.count = l.count || 20; [].forEach.call(el.querySelectorAll('[data-r]'), function (f) { l.replaced[f.getAttribute('data-r')] = f.value; }); }); };\n  var builderEdit = function (d, r, existing) {\n    var w = shell(existing ? 'EDIT ' + existing.id : 'NEW MEMO', 'builder', '<div style=\"margin:0 0 10px\"><a class=\"sjTM_lnk\" href=\"#tm-builder' + (existing ? '-' + esc(existing.id.toLowerCase()) : '') + '\">\u2039 Back</a></div><h1 class=\"sjTM_h1\">' + (existing ? 'New version of ' + esc(existing.id) : 'New memo for ' + esc(d.company || d.client)) + '</h1><p class=\"sjTM_sub\">' + (existing && existing.sig ? '<b>Already signed.</b> Saving creates version ' + (existing.versionsAll.length + 1) + ' and the buyer must sign again before it ships.' : 'Check each line. Flag anything you swapped so the buyer sees it before signing.') + '</p><div class=\"sjTM_grid\"><div id=\"sjTM_rows\">' + editRows(d.lines) + '<button type=\"button\" class=\"sjTM_btn sm alt\" data-tm-do=\"add\">+ ADD LINE</button></div><div><div class=\"sjTM_card\"><div class=\"hd\"><span class=\"sjTM_lab\">Save</span></div><div class=\"bd\"><label class=\"sjTM_f\"><span>What changed (internal)</span><input id=\"sjTM_vn\" value=\"' + esc(d.note || '') + '\"></label><div style=\"font-size:13px;margin:0 0 12px\">Total <b id=\"sjTM_bt\">' + money(sumOf(d.lines)) + '</b> \u00b7 ' + d.lines.length + ' lines</div><button type=\"button\" class=\"sjTM_btn wide\" data-tm-do=\"save\">SAVE ' + (existing ? 'NEW VERSION' : 'MEMO') + '</button><div class=\"sjTM_err\"></div></div></div></div></div>');\n    var redraw = function () { readRows(w, d.lines); w.querySelector('#sjTM_rows').innerHTML = editRows(d.lines) + '<button type=\"button\" class=\"sjTM_btn sm alt\" data-tm-do=\"add\">+ ADD LINE</button>'; w.querySelector('#sjTM_bt').textContent = money(sumOf(d.lines)); };\n    w.addEventListener('click', function (e) {\n      var t = e.target.closest('[data-tm-rep],[data-tm-del],[data-tm-do]'); if (!t) return;\n      if (t.hasAttribute('data-tm-rep')) { readRows(w, d.lines); var l = d.lines[+t.getAttribute('data-tm-rep')]; l.replaced = l.replaced ? null : { orig: '', origDesc: '', why: 'It sold before we could pull it, so we matched it as closely as we could.' }; return redraw(); }\n      if (t.hasAttribute('data-tm-del')) { readRows(w, d.lines); d.lines.splice(+t.getAttribute('data-tm-del'), 1); return redraw(); }\n      var a = t.getAttribute('data-tm-do');\n      if (a === 'add') { readRows(w, d.lines); d.lines.push({ sku: '', kind: 'diamond', shape: '', title: '', spec: '', qty: 1, price: 0, unit: '', replaced: null }); return redraw(); }\n      if (a === 'save') { readRows(w, d.lines); api('tm_memo_save', { id: existing ? existing.id : '', order: d.order, client: d.client, source: d.source, lines: d.lines, note: w.querySelector('#sjTM_vn').value }).then(function (x) { if (!x.ok) { w.querySelector('.sjTM_err').textContent = x.error; return; } draft = null; go('tm-builder-' + x.id.toLowerCase()); }); }\n    });\n  };\n  var builderOne = function (m, s) {\n    var latest = m.versionsAll[m.versionsAll.length - 1]; var ed = can.memoEdit(ROLE()); var signedLatest = m.sigFull && m.sigFull.v === latest.v;\n    var vlist = m.versionsAll.slice().reverse().map(function (v) { return '<div style=\"padding:8px 0;border-top:1px solid #ece6f1;font-size:12.5px\"><b>v' + v.v + '</b> \u00b7 ' + fmtDT(v.at) + ' \u00b7 ' + esc(v.by) + (m.sigFull && m.sigFull.v === v.v ? ' <span class=\"sjTM_pill ok\">Signed</span>' : '') + '<div style=\"color:#4a4458\">' + esc(v.note) + '</div></div>'; }).join('');\n    var fbOf = function (sk) { return (m.feedback || []).filter(function (f) { return f.sku === sk; }).map(function (f) { return '<div class=\"sjTM_note\" style=\"margin:4px 0 0;width:100%\"><b>' + (f.kind === 'keep' ? 'BUYER NOTE (KEPT)' : 'WHY IT CAME BACK') + '</b> \u00b7 ' + esc(f.reasons.map(reasonLabel).join(', ')) + (f.note ? (f.reasons.length ? ' \u00b7 ' : '') + '\u201c' + esc(f.note) + '\u201d' : '') + ' <span style=\"color:#6b657a\">' + fmtD(f.at) + '</span></div>'; }).join(''); };\n    var ctl = function (l) { var st = m.lineState[l.sku] || 'out'; var fb = fbOf(l.sku); var c = fb + (can.scanIn(ROLE()) && m.status === 'shipped' && (st === 'return' || st === 'out') ? '<button type=\"button\" class=\"sjTM_btn sm alt\" data-tm-scan=\"' + esc(l.sku) + '\">SCAN IN (RECEIVED)</button>' : ''); return { state: st, ctl: c }; };\n    var ext = (m.extAll || []).filter(function (x) { return x.status === 'pending'; });\n    var w = shell('MEMO ' + m.id, 'builder', '<div style=\"margin:0 0 10px\"><a class=\"sjTM_lnk\" href=\"#tm-builder\">\u2039 All memos</a></div><h1 class=\"sjTM_h1\">' + esc(m.id) + ' \u00b7 ' + es