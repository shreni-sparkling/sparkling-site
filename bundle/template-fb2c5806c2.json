    return '<div style=\"font-size:15px;font-weight:800;margin:8px 0\">New walk-up</div><label class=\"sjST_f\"><span>Name</span><input id=\"sjST_nc_contact\" value=\"' + esc(n.contact || '') + '\" data-autofocus></label><label class=\"sjST_f\"><span>Store (optional)</span><input id=\"sjST_nc_company\" value=\"' + esc(n.company || '') + '\"></label><label class=\"sjST_f\"><span>Email</span><input id=\"sjST_nc_email\" type=\"email\" value=\"' + esc(n.email || '') + '\"></label><label class=\"sjST_f\"><span>Phone / WhatsApp</span><input id=\"sjST_nc_phone\" type=\"tel\" value=\"' + esc(n.phone || '') + '\"></label>' +\n      '<label class=\"sjST_chk\"><input type=\"checkbox\" id=\"sjST_nc_optin\"' + (n.optin !== false ? ' checked' : '') + '> Send them the invoice and picks by email</label><label class=\"sjST_chk\"><input type=\"checkbox\" id=\"sjST_nc_whatsapp\"' + (n.whatsapp ? ' checked' : '') + '> Prefers WhatsApp</label><label class=\"sjST_chk\"><input type=\"checkbox\" id=\"sjST_nc_cash\"' + (n.cash ? ' checked' : '') + '> Paying cash and taking the goods (no trade application)</label><label class=\"sjST_chk\"><input type=\"checkbox\" id=\"sjST_nc_declined\"' + (n.declined ? ' checked' : '') + '> They\u2019d rather not share contact details</label>' + (n.err ? '<div class=\"sjST_flash bad\">' + esc(n.err) + '</div>' : '') + '<div class=\"sjST_row\"><button class=\"sjST_b\" data-a=\"ssave\">Add customer</button><button class=\"sjST_b g\" data-a=\"scancel\">Back</button></div>';\n  }\n\n  /* ---------- stock count ---------- */\n  function vCount(d) {\n    var t = d.trays || {}, cs = S.count; var h = '<div class=\"sjST_ey\">Stock count \u00b7 RFID or scanner</div><h1 class=\"sjST_h1\">What\u2019s on the tray?</h1><p class=\"sjST_sub\">Pick a tray, then scan or let the RFID reader sweep it. A bulk read pastes many tags at once \u2014 that works too.</p><div class=\"sjST_row\">' + Object.keys(t).sort().map(function (k) { return '<button class=\"sjST_b ' + (cs.tray === k ? '' : 'g') + '\" data-a=\"tray\" data-x=\"' + k + '\">' + k + ' \u00b7 ' + t[k].length + '</button>'; }).join('') + '</div>';\n    if (!cs.tray) return h + (d.history && d.history.length ? '<div class=\"sjST_h2\">Recent counts</div>' + histTable(d.history) : '');\n    var exp = t[cs.tray] || [], found = exp.filter(function (x) { return cs.found[x.sku]; }), missing = exp.filter(function (x) { return !cs.found[x.sku]; });\n    h += '<div class=\"sjST_scanw\" style=\"margin-top:14px\"><label for=\"sjST_scan\">Scan tags on ' + esc(cs.tray) + '</label><input id=\"sjST_scan\" class=\"sjST_scan\" data-scan=\"count\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"SJT-\u2026 or RFID tag\" data-autofocus>' + (window.SJ_API_LIVE === true ? '' : '<button class=\"sjST_b s\" data-a=\"rfid\">TEST \u00b7 RFID sweep</button>') + '</div>';\n    var handBad = cs.hand !== '' && +cs.hand !== found.length + cs.extra.length;\n    h += '<div class=\"sjST_cnt\"><div><small>Expected</small><b>' + exp.length + '</b></div><div class=\"ok\"><small>Found</small><b>' + found.length + '</b></div><div class=\"' + (missing.length ? 'bad' : '') + '\"><small>Missing</small><b>' + missing.length + '</b></div><div class=\"' + (cs.extra.length ? 'bad' : '') + '\"><small>Not on this tray</small><b>' + cs.extra.length + '</b></div></div>';\n    h += '<div class=\"sjST_card\" style=\"margin-bottom:12px\"><div class=\"sjST_row\"><label class=\"sjST_f\" style=\"margin:0;width:200px\"><span>Pieces counted by hand</span><input id=\"sjST_hand\" type=\"number\" inputmode=\"numeric\" value=\"' + esc(cs.hand) + '\"></label><div class=\"sjST_sp\" style=\"font-size:13px;' + (handBad ? 'color:#B3261E;font-weight:800' : 'color:#4a4458') + '\">' + (cs.hand === '' ? 'Optional. Catches a tag that came without its piece.' : handBad ? 'Hand count (' + cs.hand + ') \u2260 scanned (' + (found.length + cs.extra.length) + '). Look for a tag with no piece, or a piece with no tag.' : 'Hand count matches the scan.') + '</div></div></div>';\n    var row = function (x, kind) { var pb = cs.problems[x.sku]; return '<div class=\"sjST_ln ' + (kind === 'ok' ? 'found' : kind === 'miss' ? 'missing' : 'replaced') + '\">' + pic(x.cat) + '<div class=\"sjST_ld\"><b>' + esc(x.desc) + '</b><small>' + esc(x.sku) + (x.home ? ' \u00b7 belongs on ' + esc(x.home) : '') + '</small>' + (pb ? '<span class=\"sjST_tag bad\">' + esc(pb) + '</span>' : '') + '</div>' + (kind === 'ok' ? '<div class=\"sjST_la\"><button class=\"sjST_b g sm\" data-a=\"prob\" data-x=\"' + esc(x.sku) + '\">' + (pb ? 'Change problem' : 'Problem') + '</button></div>' : '') + '</div>'; };\n    if (missing.length) h += '<div class=\"sjST_cat\">Missing \u00b7 ' + missing.length + '</div>' + missing.map(function (x) { return row(x, 'miss'); }).join('');\n    if (cs.extra.length) h += '<div class=\"sjST_cat\">Not on this tray \u00b7 ' + cs.extra.length + '</div>' + cs.extra.map(function (x) { return row(x, 'extra'); }).join('');\n    if (found.length) h += '<div class=\"sjST_cat\">Found \u00b7 ' + found.length + '</div>' + found.map(function (x) { return row(x, 'ok'); }).join('');\n    return h + '<div class=\"sjST_row\" style=\"margin-top:14px\"><button class=\"sjST_b\" data-a=\"csave\">Save count</button><button class=\"sjST_b g\" data-a=\"creset\">Start over</button></div>';\n  }\n  function histTable(hs) { return '<div class=\"sjST_tw\"><table class=\"sjST_tbl\"><tr><th>When</th><th>Tray</th><th>Expected</th><th>Found</th><th>Missing</th><th>Extra</th><th>Problems</th><th>By</th></tr>' + hs.map(function (c) { return '<tr><td>' + esc(c.at) + '</td><td>' + esc(c.tray) + '</td><td>' + c.expected + '</td><td>' + c.found + '</td><td>' + c.missing + '</td><td>' + c.extra + '</td><td>' + Object.keys(c.problems || {}).length + '</td><td>' + esc(c.by) + '</td></tr>'; }).join('') + '</table></div>'; }\n\n  /* ---------- accounting ---------- */\n  function vBooks(d) { return '<div class=\"sjST_ey\">Accounting</div><h1 class=\"sjST_h1\">Money in, verified.</h1><p class=\"sjST_sub\">Mark an invoice paid only once the money is in the bank. Card payments confirm themselves through the processor.</p>' + booksTable(d.invoices || []); }\n  function booksTable(L) { if (!L.length) return '<div class=\"sjST_empty\">No invoices.</div>'; return '<div class=\"sjST_tw\"><table class=\"sjST_tbl\"><tr><th>Invoice</th><th>Order</th><th>Customer</th><th>Items</th><th>Amount</th><th>Status</th><th>Method / note</th><th></th></tr>' + L.map(function (i) { return '<tr><td><b>' + esc(i.inv) + '</b></td><td>' + esc(i.ref) + '</td><td>' + esc(i.company || '') + '<br><small>' + esc(i.cust) + '</small></td><td>' + i.items + '</td><td><b>' + money(i.amount) + '</b></td><td><span class=\"sjST_tag ' + (i.status === 'Paid' ? 'ok' : i.status === 'Payment claimed' ? 'warn' : i.status === 'Not received' ? 'bad' : '') + '\">' + esc(i.status) + '</span></td><td>' + esc([i.method, i.note].filter(Boolean).join(' \u00b7 ')) + '</td><td>' + (i.status === 'Payment claimed' ? '<div class=\"sjST_row\" style=\"flex-wrap:nowrap\"><button class=\"sjST_b sm\" data-a=\"pay\" data-x=\"' + esc(i.inv) + '\">Money\u2019s in</button><button class=\"sjST_b d sm\" data-a=\"paybad\" data-x=\"' + esc(i.inv) + '\">Not received</button></div>' : '') + '</td></tr>'; }).join('') + '</table></div>'; }\n\n  /* ---------- sales: clients ---------- */\n  function vClients(d) {\n    var r = role(); if (r === 'owner') return '<div class=\"sjST_ey\">Clients</div><h1 class=\"sjST_h1\">Assign clients on the Staff screen.</h1><p class=\"sjST_sub\">Owners see every client; reps see only theirs.</p><button class=\"sjST_b\" data-a=\"go\" data-x=\"users\">Open Staff</button>';\n    var C = d.clients || []; return '<div class=\"sjST_ey\">My clients</div><h1 class=\"sjST_h1\">' + C.length + ' clients are yours.</h1><p class=\"sjST_sub\">Anyone not on this list shows as a customer number only. Ask an owner to reassign.</p>' + (C.length ? '<div class=\"sjST_tw\"><table class=\"sjST_tbl\"><tr><th>No.</th><th>Store</th><th>Contact</th><th>Email</th><th>Phone</th><th>City</th></tr>' + C.map(function (c) { return '<tr><td>' + esc(c.no) + '</td><td><b>' + esc(c.company) + '</b></td><td>' + esc(c.contact) + '</td><td>' + esc(c.email) + '</td><td>' + esc(c.phone) + '</td><td>' + esc([c.city, c.st].filter(Boolean).join(', ')) + '</td></tr>'; }).join('') + '</table></div>' : '<div class=\"sjST_empty\">No clients assigned yet.</div>');\n  }\n\n  /* ---------- users (owners) ---------- */\n  function vUsers(d) {\n    var U = d.users || [], C = d.customers || [], meU = meFor('owner').user;\n    var h = '<div class=\"sjST_ey\">Owners only</div><h1 class=\"sjST_h1\">Who gets in, and what they see.</h1><p class=\"sjST_sub\">Switch a login off and it\u2019s out on its next click. Every sign-in needs a code from their email. Passwords are never shown \u2014 people set their own.</p>';\n    h += '<div class=\"sjST_tw\"><table class=\"sjST_tbl\"><tr><th>Person</th><th>Role</th><th>On</th><th>2-step</th><th>Assigned clients (sales)</th></tr>' + U.map(function (u) { return '<tr><td><b>' + esc(u.name) + '</b><br><small>' + esc(u.user) + ' \u00b7 ' + esc(u.email) + '</small></td><td><select data-urole=\"' + esc(u.user) + '\" aria-label=\"Role for ' + esc(u.name) + '\"' + (u.user === meU ? ' disabled' : '') + '>' + STAFF.map(function (r) { return '<option value=\"' + r + '\"' + (u.role === r ? ' selected' : '') + '>' + ROLE_NAME[r] + '</option>'; }).join('') + '</select></td><td><button class=\"sjST_tog' + (u.active ? ' on' : '') + '\" data-a=\"uact\" data-x=\"' + esc(u.user) + '\" aria-pressed=\"' + u.active + '\" aria-label=\"' + (u.active ? 'Switch off ' : 'Switch on ') + esc(u.name) + '\"' + (u.user === meU ? ' disabled title=\"You can\u2019t switch yourself off\"' : '') + '></button></td><td>' + (u.twofa ? '<span class=\"sjST_tag ok\">On</span>' : '<span class=\"sjST_tag warn\">At next sign-in</span>') + '</td><td>' + (u.role === 'sales' ? '<div class=\"sjST_cbx\">' + C.map(function (c) { return '<label><input type=\"checkbox\" data-uc=\"' + esc(u.user) + '\" value=\"' + esc(c.no) + '\"' + (u.clients.indexOf(c.no) >= 0 ? ' checked' : '') + '>' + esc(c.no) + ' ' + esc(c.company) + '</label>'; }).join('') + '</div>' : '<small style=\"color:#6b6478\">' + (u.role === 'owner' ? 'All clients' : u.role === 'orderproc' ? 'Customer numbers only' : u.role === 'shipping' ? 'Ship-to addresses only' : 'Invoices and amounts') + '</small>') + '</td></tr>'; }).join('') + '</table></div>';\n    h += '<div class=\"sjST_h2\">Add a staff login</div><div class=\"sjST_card\"><div class=\"sjST_g2\"><label class=\"sjST_f\"><span>Full name</span><input id=\"sjST_nu_name\"></label><label class=\"sjST_f\"><span>Username</span><input id=\"sjST_nu_user\" autocomplete=\"off\"></label><label class=\"sjST_f\"><span>Work email (gets sign-in codes)</span><input id=\"sjST_nu_email\" type=\"email\"></label><label class=\"sjST_f\"><span>Role</span><select id=\"sjST_nu_role\">' + STAFF.map(function (r) { return '<option value=\"' + r + '\"' + (r === 'sales' ? ' selected' : '') + '>' + ROLE_NAME[r] + '</option>'; }).join('') + '</select></label></div><button class=\"sjST_b\" data-a=\"uadd\">Add login</button><div style=\"font-size:12px;color:#6b6478;margin-top:8px\">They get an email to set their own password, then a code every time they sign in.</div></div>';\n    h += '<div class=\"sjST_h2\">Sign-ins \u00b7 every person, every device</div><div class=\"sjST_tw\"><table class=\"sjST_tbl\"><tr><th>When</th><th>Login</th><th>Device</th><th>Where (approx.)</th><th>Result</th></tr>' + (d.signins || []).map(function (s) { return '<tr><td>' + esc(s[0]) + '</td><td>' + esc(s[1]) + '</td><td>' + esc(s[2]) + '</td><td>' + esc(s[3]) + '</td><td>' + (/Signed in/.test(s[4]) ? '<span class=\"sjST_tag ok\">' : '<span class=\"sjST_tag bad\">') + esc(s[4]) + '</span></td></tr>'; }).join('') + '</table></div>';\n    return h;\n  }\n\n  /* ---------- modals ---------- */\n  function modal(html, onOk) { S.modal = { html: html, ok: onOk }; render(); }\n  function closeModal() { S.modal = null; render(); }\n  function subModal(ref, sku, desc, candidates, lines) {\n    var opts = candidates.map(function (id, i) { var l = lines.filter(function (z) { return z.id === id; })[0]; return '<label class=\"sjST_chk\"><input type=\"radio\" name=\"sjST_subl\" value=\"' + id + '\"' + (i === 0 ? ' checked' : '') + '> ' + esc(l.sku) + ' \u2014 ' + esc(l.desc) + (l.state === 'missing' ? ' (marked can\u2019t find)' : '') + '</label>'; }).join('');\n    modal('<div class=\"sjST_ey\">Not on this order</div><h2 style=\"margin:6px 0 4px;font-size:22px\">' + esc(sku) + '</h2><p style=\"margin:0 0 12px;color:#4a4458\">' + esc(desc) + '<br>Packing it instead of something? Pick the line it replaces.</p>' + opts + '<label class=\"sjST_f\" style=\"margin-top:12px\"><span>Note for the seller (required)</span><textarea id=\"sjST_subn\" placeholder=\"e.g. Put the 10.25 in place of the 10.02 \u2014 closest weight on the tray\"></textarea></label><div class=\"sjST_row\"><button class=\"sjST_b\" data-a=\"subok\" data-x=\"' + esc(sku) + '\">Use it \u00b7 flag as replaced</button><button class=\"sjST_b g\" data-a=\"mclose\">Wrong piece, cancel</button></div>');\n  }\n\n  /* ---------- scanning ---------- */\n  function handleScan(kind, raw) {\n    var codes = String(raw || '').toUpperCase().split(/[\\s,;]+/).filter(Boolean); if (!codes.length) return;\n    if (kind === 'count') { countScan(codes); return; }\n    var code = codes[0];\n    if (kind === 'pick' || kind === 'check') {\n      api('st_scan', { ref: S.ref, code: code }).then(function (r) {\n        if (!r.ok) { SND.error(); flash('bad', r.error); return render(); }\n        if (r.match === 'line') { SND.ding(); S.data.order = r.order; S.flashLine = r.line; var l = r.order.lines.filter(function (z) { return z.id === r.line; })[0]; flash('ok', '\u2713 ' + (l.got || l.sku) + (kind === 'check' ? ' checked' : ' pulled') + ' \u2014 ' + (l.gotDesc || l.desc)); S.resetScroll = false; render(); S.flashLine = null; return; }\n        if (r.match === 'sub') { SND.ask(); flash('ask', code + ' isn\u2019t on this order.'); return subModal(S.ref, r.sku, r.desc, r.candidates, S.data.order.lines); }\n        SND.error(); flash('bad', r.match === 'dup' ? code + ' is already scanned on this order.' : r.match === 'unknown' ? code + ' isn\u2019t in inventory. Check the tag.' : code + ' isn\u2019t on this order.' + (kind === 'check' ? ' Put it back.' : '')); render();\n      });\n    }\n    if (kind === 'box') { api('st_ship_count', { ref: S.ref, code: code }).then(function (r) { if (!r.ok || r.match !== 'line') { SND.error(); flash('bad', !r.ok ? r.error : r.match === 'dup' ? code + ' is already in the box.' : code + ' doesn\u2019t belong in this order. Pull it out.'); return render(); } SND.ding(); var bx = S.boxed[S.ref] = S.boxed[S.ref] || {}; r.boxed.forEach(function (id) { bx[id] = 1; }); S.data.order = r.order; flash('ok', '\u2713 ' + code + ' in the box' + (r.order.counted ? ' \u2014 all pieces counted.' : '')); render(); }); }\n    if (kind === 'show') { api('st_show_scan', { code: code }).then(function (r) { if (!r.ok || r.match !== 'item') { SND.error(); flash('bad', !r.ok ? r.error : code + ' isn\u2019t in inventory.'); return render(); } if (S.show.lines.some(function (l) { return l.item.sku === r.item.sku; })) { SND.error(); flash('bad', r.item.sku + ' is already in the cart.'); return render(); } SND.ding(); S.show.lines.unshift({ item: r.item, price: 0, touched: false }); repriceShow(); flash('ok', '\u2713 ' + r.item.sku + ' added at ' + money(S.show.lines[0].price)); render(); }); }\n  }\n  function repriceShow() { var n = S.show.lines.length; S.show.lines.forEach(function (l) { if (!l.touched) l.price = showPrice(l, n).auto; }); }\n  function countScan(codes) {\n    var cs = S.count, t = (S.data.trays || {}), exp = t[cs.tray] || [], good = 0, bad = 0, homeOf = {};\n    Object.keys(t).forEach(function (k) { t[k].forEach(function (x) { homeOf[x.sku] = k; homeOf[x.epc] = k; }); });\n    codes.forEach(function (code) { var x = exp.filter(function (e) { return e.sku === code || e.epc === code; })[0]; if (x) { if (!cs.found[x.sku]) { cs.found[x.sku] = 1; good++; } return; } var other = null; Object.keys(t).forEach(function (k) { t[k].forEach(function (e) { if (e.sku === code || e.epc === code) other = e; }); }); if (other) { if (!cs.extra.some(function (e) { return e.sku === other.sku; })) cs.extra.push(Object.assign({ home: homeOf[other.sku] }, other)); } else cs.extra.push({ sku: code, desc: 'Unknown tag', cat: 'Loose', home: '?' }); bad++; });\n    if (bad) { SND.error(); flash('bad', bad + ' tag(s) don\u2019t belong on ' + cs.tray + (good ? ' \u00b7 ' + good + ' found' : '') + '.'); } else if (good) { SND.ding(); flash('ok', '\u2713 ' + good + ' found on ' + cs.tray + '.'); } else { SND.error(); flash('bad', 'Already counted.'); }\n    render();\n  }\n\n  /* ---------- events ---------- */\n  function onKey(e) {\n    var t = e.target; if (e.key === 'Escape' && S.modal) { closeModal(); return; }\n    if (t.matches && t.matches('[data-scan]') && e.key === 'Enter') { e.preventDefault(); var v = t.value; t.value = ''; handleScan(t.getAttribute('data-scan'), v); return; }\n    if (t.id === 'sjST_cq' && e.key === 'Enter') { e.preventDefault(); }\n  }\n  var cqTimer = null;\n  function onInput(e) {\n    var t = e.target;\n    if (t.id === 'sjST_cq') { S.show.q = t.value; clearTimeout(cqTimer); cqTimer = setTimeout(function () { api('st_cust_find', { q: S.show.q }).then(function (r) { S.show.results = r.results || []; render(); var q = document.getElementById('sjST_cq'); if (q) { q.focus(); q.setSelectionRange(q.value.length, q.value.length); } }); }, 250); }\n    if (S.screen === 'settings') settingsLive();\n    if (t.id === 'sjST_hand') { S.count.hand = t.value; clearTimeout(cqTimer); cqTimer = setTimeout(function () { render(); var h = document.g