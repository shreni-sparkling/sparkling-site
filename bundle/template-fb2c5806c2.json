=\"liability\"> <span>' + esc(LIAB_TEXT) + '</span></label>'; };\n  var rTeam = function () {\n    if (LIVE()) return setBody('<div style=\"max-width:760px;margin:0 auto\"><h1 class=\"sjVF_h1\">Manage users</h1><p class=\"sjVF_lede\">Manage users lives in your account settings.</p><a class=\"sjVF_btn p\" href=\"#/account/team\" data-act=\"close\">Open account settings</a></div>');\n    loading();\n    api('vf_team', {}).then(function (r) {\n      if (!r.ok) return setBody('<div style=\"max-width:760px;margin:0 auto\"><h1 class=\"sjVF_h1\">Manage users</h1><p class=\"sjVF_lede\">' + esc(r.error) + '</p><a class=\"sjVF_btn\" href=\"#vf-status\">Account status</a></div>');\n      if (r.none) return setBody('<div style=\"max-width:760px;margin:0 auto\"><h1 class=\"sjVF_h1\">Manage users</h1><p class=\"sjVF_lede\">You are not on a company account yet.</p></div>');\n      var c = r.company, pend = c.users.filter(function (u) { return u.status === 'pending'; }), act = c.users.filter(function (u) { return u.status === 'active' && !u.owner; });\n      var h = '<div style=\"max-width:900px;margin:0 auto\"><p class=\"sjVF_note\" style=\"border:1px dashed #6d497e;padding:8px 10px;margin:0 0 14px\">Demo stand-in. The real screen is Settings \u203a Team (account builder).</p><div class=\"sjVF_ey\">' + esc(c.name) + '</div><h1 class=\"sjVF_h1\">Your team</h1><p class=\"sjVF_lede\">Everyone gets their own login, so you can see who did what.</p>';\n      h += '<div class=\"sjVF_card\"><h3>Waiting for you \u00b7 ' + pend.length + '</h3>' + (pend.length ? pend.map(function (u) { return '<div class=\"sjVF_cand\"><div class=\"sjVF_row\" style=\"justify-content:space-between\"><div><b style=\"color:#fff\">' + esc(u.name) + '</b><p class=\"sjVF_note\">' + esc(u.email) + ' \u00b7 asked ' + esc(when(u.at)) + (u.via ? ' \u00b7 matched on: ' + esc(u.via) : '') + '</p></div><div class=\"sjVF_row\"><button type=\"button\" class=\"sjVF_btn s p\" data-act=\"tapprove\" data-e=\"' + esc(u.email) + 