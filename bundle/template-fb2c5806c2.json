ype) + '</b>' + (p.photo ? '<br><img alt=\"\" src=\"' + p.photo + '\" style=\"width:60px;height:60px;object-fit:cover;margin-top:4px\">' : '') + '</td><td data-l=\"Note\">' + esc(p.note || '\u2014') + '</td><td data-l=\"Decision\">' + esc(p.outcome) + '</td></tr>'; }).join('') + '</tbody></table>' : '<div class=\"sjMT_empty\">No problems logged. Keep it that way.</div>');\n      }\n      bd.innerHTML = h;\n      $$('[data-vu]', bd).forEach(function (b) { b.onclick = function () { var id = b.getAttribute('data-vu'); api('mt_vendor_update', { id: id, status: $('[data-vs=\"' + id + '\"]').value, promise: $('[data-vp=\"' + id + '\"]').value, note: $('[data-vn=\"' + id + '\"]').value }).then(function () { VIEWS.vendor(); setTimeout(function () { flash($('.sjMT_bd'), 'Update sent to Sparkling.', 'ok'); }, 120); }).catch(fail); }; });\n      $$('[data-ph]', bd).forEach(function (i) { i.onchange = function () { readFile(i.files[0]).then(function (src) { return api('mt_vendor_photo', { id: i.getAttribute('data-ph'), src: src, name: i.files[0].name }); }).then(function () { VIEWS.vendor(); }).catch(fail); }; });\n      $$('[data-qs]', bd).forEach(function (b) { b.onclick = function () { var id = b.getAttribute('data-qs'); api('mt_vendor_quote', { id: id, price: $('[data-qp=\"' + id + '\"]').value, days: $('[data-qd=\"' + id + '\"]').value, note: $('[data-qn=\"' + id + '\"]').value }).then(function () { VIEWS.vendor(); setTimeout(function () { flash($('.sjMT_bd'), 'Quote sent.', 'ok'); }, 120); }).catch(fail); }; });\n      $$('[data-cad]', bd).forEach(function (b) { b.onclick = function () { open('cad', { id: b.getAttribute('data-cad') }); }; });\n    }).catch(fail);\n  };\n\n  /* ---------- COORDINATOR ---------- */\n  VIEWS.coord = function () {\n    loading(); var tab = tabState.coord || 'todo';\n    api('mt_coord').then(function (d) {\n      var T = d.todo; var todoN = T.owed.length + T.waitingUs.length + T.stale.length + T.diamonds.length;\n      tabs([['todo', 'To-do', 