el ? ' selected' : '') + '>Email</option><option value=\"sms\"' + (ce.channel === 'sms' ? ' selected' : '') + '>Text</option><option value=\"both\"' + (ce.channel === 'both' ? ' selected' : '') + '>Both</option></select></label><label style=\"display:flex;align-items:center;gap:8px\"><input type=\"checkbox\" id=\"sjCSms\" ' + (ce.sms ? 'checked' : '') + '> Agreed to texts</label><label class=\"muted\" style=\"grid-column:1/-1\">Notes<input class=\"in\" id=\"sjCNotes\" value=\"' + esc(ce.custNotes || ce.notes || '') + '\" style=\"width:100%\"></label>' +\n      '<label style=\"grid-column:1/-1;display:flex;align-items:center;gap:8px\"><input type=\"checkbox\" id=\"sjCKyc\" ' + (ce.kyc ? 'checked' : '') + '> KYC on file in the ERP \u2014 treat their orders as verified</label>' +\n      '<div style=\"grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap\"><button class=\"b pri\" type=\"submit\" ' + (S.busy ? 'disabled' : '') + '>SAVE</button><button class=\"b\" type=\"button\" data-a=\"custcancel\">CANCEL</button>' + (ce.row ? '<button class=\"b danger\" type=\"button\" data-a=\"custdel\" data-row=\"' + ce.row + '\">UNLINK</button>' : '') + '</div></form></div>'; }\n    h += '<div class=\"card\" style=\"margin-top:16px\"><h2>LINK YOUR ERP CUSTOMER LIST' + (o.customersDir ? ' \u00b7 ' + o.customersDir + ' LINKED' : '') + '</h2><div class=\"muted\" style=\"margin-bottom:8px\">Export customers from the ERP (Excel/CSV), copy the cells including the header row, paste here. Columns are recognised by their header: customer # / ERP, company or store, contact, email, phone, KYC (yes/no \u2014 blank means yes), program (RJO/NIJA), member #. Existing links are updated, new ones added \u2014 nothing is deleted.</div><form data-form=\"custimport\" style=\"display:grid;gap:8px\"><label class=\"muted\" style=\"display:grid;gap:4px\">UPLOAD THE FILE (CSV)<input class=\"in\" type=\"file\" id=\"sjCustFile\" accept=\".csv,.txt,.tsv\" style=\"padding:6px\"></label><div class=\"muted\">\u2026or paste:</div><textarea class=\"in\" id=\"sjCustPaste\" rows=\"4\" style=\"height:auto;padding:8px;font-family:ui-monospace,monospace;font-size:12px\" placeholder=\"Customer #\\tCompany\\tContact\\tEmail\\tPhone\\tKYC\\tProgram\\tMember #\\n10234\\tGold & Co\\tAnn Lee\\tann@goldco.com\\t213 555 1212\\tyes\\tRJO\\t4471\"></textarea><div><button class=\"b pri\" type=\"submit\" ' + (S.busy ? 'disabled' : '') + '>IMPORT / UPDATE LINKS</button></div></form></div>';\n    var ca = S.carts;\n    h += '<div class=\"card\" style=\"margin-top:16px\"><h2>ANONYMOUS CARTS \u00b7 ADDED STONES, NEVER SENT A REQUEST</h2><div class=\"muted\" style=\"margin-bottom:8px\">Visitors who put stones in the bag but never told us who they are. If they arrived from a Mailchimp campaign link, Mailchimp can tell us their name and email \u2014 press IDENTIFY. Otherwise you can attach a name by hand (e.g. after a call).</div>' +\n      '<div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px\"><button class=\"b pri\" data-a=\"mcresolve\" ' + (ca && ca.mcReady ? '' : 'disabled title=\"Connect Mailchimp first\"') + '>IDENTIFY VIA MAILCHIMP' + (ca && ca.unresolved ? ' \u00b7 ' + ca.unresolved + ' POSSIBLE' : '') + '</button><button class=\"b\" data-a=\"cartsload\">RELOAD</button></div>' +\n      (!ca ? '<div class=\"muted\">' + (S.cartsBusy ? 'Loading\u2026' : 'Press RELOAD.') + '</div>' : (ca.carts.length ? '<div class=\"tw\"><table><tr><th>LAST SEEN</th><th>WHO</th><th>STONES IN BAG</th><th>VISITS</th><th>DEVICE</th><th>FROM</th><th></th></tr>' + ca.carts.map(function (c) { return '<tr><td style=\"white-space:nowrap\">' + esc(c.last) + '</td><td>' + (c.email ? '<b>' + esc(c.name || '') + '</b><br>' + esc(c.email) + (c.company ? '<br>' + esc(c.company) : '') : '<span class=\"muted\">unknown \u00b7 ' + esc(c.visitor) + '</span>' + (c.mc ? '<br><span class=\"pill\" style=\"border-color:#B8860B;color:#B8860B\">CAME FROM MAILCHIMP</span>' : '')) + '</td><td>' + c.added.map(function (a) { r