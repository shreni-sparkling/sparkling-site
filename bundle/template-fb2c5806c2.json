r u = b.getAttribute('data-ua'); var st = $('[data-us=\"' + u + '\"]', c).value; api('mt_update_decide', { id: id, uid: u, approve: true, stage: st }).then(function () { redo('Update approved.'); }).catch(fail); }; });\n        on('move', function () { var v = $('#sjMT_mv', c).value; if (!v) return fail(new Error('Pick a vendor.')); api('mt_job_move', { id: id, vendorId: v }).then(function (x) { redo('Moved \u00b7 their SKU: ' + x.vendorSku); }).catch(fail); });\n        on('stage', function () { api('mt_job_stage', { id: id, stage: $('#sjMT_sg', c).value }).then(function () { redo('Stage saved.'); }).catch(fail); });\n        on('cad', function () { open('cad', { id: id }); });\n        if (owner) chatBox($('#sjMT_chatbox', c), id, null);\n      }).catch(fail);\n    }).catch(fail);\n  };\n\n  var chatBox = function (box, id, thread) {\n    if (!box) return;\n    api('mt_chat_get', { id: id }).then(function (d) {\n      var r = ROLE(), me = who(); var th = thread || (r === 'owner' ? me : 'Shreni');\n      var list = d.chat.filter(function (m) { return m.thread === th; });\n      box.innerHTML = (r === 'coordinator' ? '<div class=\"sjMT_chips\">' + OWNERS.map(function (o) { var n = d.chat.filter(function (m) { return m.thread === o; }).length; return '<button class=\"sjMT_chip ' + (o === th ? 'on' : '') + '\" data-th=\"' + o + '\">' + o + (n ? ' \u00b7 ' + n : '') + '</button>'; }).join('') + '</div>' : '<p style=\"font-size:12px;color:#4a4458;margin:0 0 6px\">Your own thread with Sudhir on this job (Shreni, Nirav and Swani each have one).</p>') +\n        '<div class=\"sjMT_chat\">' + (list.length ? list.map(function (m) { return '<div class=\"b ' + (m.by === me ? 'me' : '') + '\"><small>' + esc(m.by) + ' \u00b7 ' + fmtD(m.at) + '</small>' + esc(m.text) + '</div>'; }).join('') : '<div style=\"color:#6b657a;font-size:12.5px\">No messages yet.</div>') + '</div><div class=\"sjMT_row\" style=\"margin-top:6px\"><input placeholder=\"Message\" style=\"flex:1 1 200px\" clas