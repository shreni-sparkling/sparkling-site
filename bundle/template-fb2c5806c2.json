id: 'c', price: 3550, state: 'x' }, { id: 'd', price: 1890, state: 'x' }, { id: 'e', price: 1450, state: 'x' }], +s.parcelCap || 1).length + '</b> parcel(s).</div></div></div></div>';\n    h += '<div class=\"sjST_h2\">Carrier by order value</div><div class=\"sjST_card\"><div class=\"sjST_g3\">' + f('lowValueMax', 'Low-value orders are under ($)', '', 'number') + f('lowCarrier', 'Low-value carrier', '') + f('lowPrice', 'Customer pays (low value, $)', '', 'number') + '</div><div class=\"sjST_g3\">' + f('lowService', 'Low-value service', 'What we book with the carrier.') + f('stdCarrier', 'Everything else ships with', '') + f('stdPrice', 'Customer pays (standard, $)', '', 'number') + '</div><div class=\"sjST_g3\">' + f('stdService', 'Standard service', '') + f('caPrice', 'California price ($)', 'Blank = same as above.', 'number') + f('satSurcharge', 'Saturday delivery adds ($)', 'Blank until you give us the number.', 'number') + '</div><div class=\"sjST_g3\">' + f('intlPrice', 'International ($)', 'Blank = quote by hand.', 'number') + '<div></div><div></div></div><label class=\"sjST_chk\"><input type=\"checkbox\" data-set=\"ship.signature\"' + (s.signature ? ' checked' : '') + '> Signature required on delivery (every label)</label>' +\n      '<div class=\"sjST_card\" style=\"margin-top:10px;background:#FBFAFC\"><div class=\"sjST_ey\">Try the rule</div><div class=\"sjST_row\" style=\"margin-top:8px\"><label class=\"sjST_f\" style=\"margin:0;flex:1;min-width:120px\"><span>Order value ($)</span><input id=\"sjST_tv\" type=\"number\" value=\"180\"></label><label class=\"sjST_f\" style=\"margin:0;width:90px\"><span>State</span><input id=\"sjST_ts\" value=\"TX\" maxlength=\"2\"></label></div><div id=\"sjST_tr\" style=\"margin-top:8px;font-weight:800\"></div></div></div>';\n    h += '<div class=\"sjST_h2\">Label wording</div><div class=\"sjST_card\"><label class=\"sjST_f\"><span>Recipient name on the label</span><select data-set=\"ship.labelMode\"><option value=\"person\"' + (