rd\" style=\"grid-column:1/-1\"><h2>VERSION HISTORY</h2><div class=\"muted\" style=\"margin-bottom:8px\">Every save keeps the previous file. Roll back restores it to the site files (then press PUBLISH).</div>' + (p && p.history.length ? '<div class=\"tw\"><table><tr><th>WHEN</th><th>FILE</th><th>SIZE</th><th></th></tr>' + p.history.map(function (f) { return '<tr><td>' + esc(f.when) + '</td><td>' + esc(f.name) + '</td><td>' + Math.round(f.size / 1024) + ' KB</td><td><button class=\"b\" type=\"button\" data-pageroll=\"' + esc(f.id) + '\">ROLL BACK</button></td></tr>'; }).join('') + '</table></div>' : '<div class=\"muted\">No previous versions yet.</div>') + '</div>';\n    return h + '</div>';\n  }\n  function loadPages() { if (!has('inventory')) return; post('admin_pages', { act: 'status' }).then(function (j) { if (j.ok) S.pages = j; if (S.tab === 'pages') render(); }).catch(function () {}); }\n  function pagesCall(type, data) { S.busy = true; render(); post(type, data).then(function (j) { S.busy = false; S.opsErr = !j.ok; S.opsMsg = j.ok ? (j.msg || 'Done.') : j.error; if (j.ok && j.files) S.pages = j; render(); }).catch(function () { S.busy = false; S.opsErr = true; S.opsMsg = 'Could not reach the Google Script.'; render(); }); }\n  function buildPage(file) {\n    if (!file) return; var r = new FileReader();\n    r.onload = function () {\n      var html = String(r.result || ''); var P = window.SparklingPatcher;\n      if (!P) { S.pageBuild = { ok: false, error: 'The page builder is not available in this copy of the page.', report: [] }; render(); return; }\n      window.__SJ_PATCHER_SRC = srcOf('sj-patcher-src');\n      S.opsMsg = 'Preparing ' + file.name + '\u2026'; S.opsErr = false; render();\n      Promise.resolve(P.patch(html, { api: API(), adminJs: srcOf('sj-admin-src'), pageJs: srcOf('sj-page-src'), uxJs: srcOf('sj-ux-src'), version: file.name.replace(/\\.html?$/i, '') + ' \u00b7 ' + new Date().toISOString().slice(0, 10) })).then(function (res) {\n        var 