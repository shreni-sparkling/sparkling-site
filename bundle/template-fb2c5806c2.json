-l=\"\"><button class=\"sjMT_btn alt sm\" data-mv=\"' + v.id + '\">Move all open\u2026</button></td>' : '') + '</tr>'; }).join('') + '</tbody></table>' +\n        '<p style=\"font-size:12px;color:#4a4458\">Real turnaround = days from order to the day it shipped to LA, across finished jobs. Vendors who keep missing their promise are the ones to replace.</p><div id=\"sjMT_mvbox\"></div>';\n      $$('[data-pd]', bd).forEach(function (i) { i.onchange = function () { api('mt_vendor_set', { id: i.getAttribute('data-pd'), promisedDays: i.value }).then(function () { flash(bd, 'Promise saved.', 'ok'); }).catch(fail); }; });\n      $$('[data-mv]', bd).forEach(function (b) { b.onclick = function () { var from = b.getAttribute('data-mv'); var box = $('#sjMT_mvbox'); box.innerHTML = '<h2>Move everything open from ' + esc(d.vendors.filter(function (v) { return v.id === from; })[0].name) + '</h2><div class=\"sjMT_row\"><select id=\"sjMT_mvto\">' + d.vendors.filter(function (v) { return v.id !== from; }).map(function (v) { return '<option value=\"' + v.id + '\">' + esc(v.name) + '</option>'; }).join('') + '</select><button class=\"sjMT_btn warn\" id=\"sjMT_mvgo\">Move all open jobs</button></div>'; $('#sjMT_mvgo').onclick = function () { api('mt_vendor_move_all', { from: from, to: $('#sjMT_mvto').value }).then(function (x) { VIEWS.vendors(); setTimeout(function () { flash($('.sjMT_bd'), x.moved + ' job(s) moved. The new vendor was emailed.', 'ok'); }, 150); }).catch(fail); }; box.scrollIntoView({ behavior: 'smooth' }); }; });\n    }).catch(fail);\n  };\n\n  /* ---------- VENDOR PORTAL ---------- */\n  VIEWS.vendor = function () {\n    loading(); var tab = tabState.vendor || 'orders';\n    api('mt_vendor_jobs').then(function (d) {\n      $('h1').textContent = d.vendor.name + ' \u00b7 your pieces';\n      tabs([['orders', 'To make', d.jobs.length], ['quotes', 'Quote requests', d.quotes.filter(function (q) { return !q.myQuote; }).length], ['cad', 'CAD', d.cadQueue.length], ['problems', 'Problems', d.problems.filter(function (p) { return p.outcome === 'Waiting on Sparkling' || !p.outcome; }).length]], tab, function (k) { tabState.vendor = k; VIEWS.vendor(); });\n      var bd = $('.sjMT_bd'); var h = '';\n      if (tab === 'orders') {\n        h = '<p style=\"margin:0 0 12px;color:#4a4458\">Paid orders are marked PRIORITY: do those first. Your promised date is what we hold you to; change it here if it moves.</p>' + (d.jobs.length ? d.jobs.sort(function (a, b) { return (b.priority ? 1 : 0) - (a.priority ? 1 : 0); }).map(function (j) {\n          return '<div class=\"sjMT_card ' + (j.late ? 'late' : j.priority ? 'prio' : '') + '\" style=\"margin-bottom:12px;flex-wrap:wrap\"><img class=\"th\" alt=\"\" src=\"' + j.img + '\" style=\"width:160px;height:120px\"><div class=\"bd\" style=\"flex:1 1 260px\"><div class=\"sjMT_lab\">Design #' + esc(j.design) + (j.vendorSku ? ' \u00b7 your SKU ' + esc(j.vendorSku) : '') + '</div><div class=\"t\">' + esc(j.title) + ' \u00d7 ' + j.qty + '</div><div class=\"m\">' + esc(j.specs) + '</div><div class=\"m\">Ordered ' + fmtD(j.orderedAt) + ' \u00b7 you promised <b>' + fmtD(j.vendorPromise) + '</b></div><div class=\"pl\">' + (j.priority ? '<span class=\"sjMT_pill dk\">Paid \u00b7 priority</span>' : '<span class=\"sjMT_pill\">Stock</span>') + (j.reorder ? '<span class=\"sjMT_pill\">Reorder</span>' : '') + (j.late ? '<span class=\"sjMT_pill red\">Past your date</span>' : '') + (j.vendorStatus ? '<span class=\"sjMT_pill sil\">' + esc(j.vendorStatus) + '</span>' : '') + (j.pendingCount ? '<span class=\"sjMT_pill amb\">' + j.pendingCount + ' update(s) with Sparkling</span>' : '') + '</div>' +\n            (j.tags.length ? '<div class=\"sjMT_msg amb\" style=\"margin:8px 0 0\"><b>TAG BEFORE SHIPPING:</b> ' + j.tags.map(function (t) { return 'tag ' + t.qty + ' of these with <b>' + esc(t.tag) + '</b>'; }).join(' \u00b7 ') + '. The rest ship untagged.</div>' : '') +\n            '<div class=\"sjMT_row\" style=\"margin-top:10px\">