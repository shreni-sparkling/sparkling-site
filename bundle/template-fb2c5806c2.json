  /* ---------------------------------------------------------------- buyer: status */\n  var rStatus = function () {\n    loading();\n    api('vf_status', {}).then(function (r) {\n      if (!r.ok) return setBody('<p class=\"sjVF_err\">' + esc(r.error) + '</p>');\n      if (r.none) return setBody('<div style=\"max-width:760px;margin:0 auto\"><h1 class=\"sjVF_h1\">No application yet</h1><p class=\"sjVF_lede\">Tell us how you buy with us and we will get you set up.</p><a class=\"sjVF_btn p\" href=\"#vf-start\">Get access</a></div>');\n      var st = r.status, appr = st === 'Approved', dec = st === 'Declined', wait = st === 'Waiting on customer', owner = st === 'With account owner';\n      var head = appr ? (r.kind === 'rjo' ? \"You're in. RJO member pricing is on.\" : \"You're verified. Wholesale pricing is on.\") : dec ? 'We could not open this account' : wait ? 'One more thing from you' : owner ? 'Waiting on your account owner' : r.kind === 'rjo' ? 'Checking your RJO membership' : r.kind === 'existing' ? \"We're matching your account\" : \"We're checking your account\";\n      var lede = appr ? (r.detailsDone ? 'All set. Go shopping.' : 'Last step: confirm your details so orders and memos land in the right place.') : dec ? 'We sent you an email with the details. If something has changed, call ' + PHONE + '.' : wait ? 'We are nearly done. Here is what we still need.' : owner ? 'We let the ' + esc(r.company) + ' account owner know. You will get an email the moment they answer.' : \"Here's what happens next. Most accounts are done within one business day.\";\n      var steps = r.kind === 'existing' ? [['Request received', 'We have your details.'], ['We match you to your account', 'Someone on our team confirms it is you. No paperwork again.'], ['You are verified', 'Wholesale pricing switches on.'], ['Confirm your details', 'A quick check that your phone, email and addresses are current.']]\n        : r.kind === 'rjo' ? [['Request received', 'We have your RJO number.'], 