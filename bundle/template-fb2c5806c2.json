k the seven parts' test panels so they don't sit on top of each other */\n(function () {\n  var ids = ['sjVF_demo', 'sjTM_demo', 'sjST_demo', 'sjMT_demo', 'sjPR_demo', 'sjIN_demo'];\n  var css = ids.map(function (id, i) { return '#' + id + '{left:12px!important;right:auto!important;top:auto!important;bottom:' + (84 + i * 40) + 'px!important;z-index:99000}#' + id + ':hover,#' + id + ':focus-within{z-index:99400}'; }).join('');\n  var st = document.createElement('style'); st.textContent = css; (document.head || document.documentElement).appendChild(st);\n  document.addEventListener('click', function (e) { ids.forEach(function (id) { var el = document.getElementById(id); if (el) el.style.zIndex = el.contains(e.target) ? '99400' : ''; }); }, true);\n})();\n\n} catch (e) { (window.__sjModErr = window.__sjModErr || []).push('f_dock.js' + \": \" + (e && e.message)); }\n\n</script>\n<script id=\"sj-ux-src\">\n/* ===== SPARKLING UX TRACKER \u00b7 works on any page version (reads the DOM, not app internals) =====\n   Captures how people physically use the page so the admin can see what to simplify:\n   clicks (by element + section), rage clicks, dead clicks, section visibility time, scroll reach,\n   form-field focus / fill / abandonment, JS errors, load speed, device + viewport.\n   Delivery: batched to the Sparkling Admin Google Script, kept in localStorage until the script\n   acknowledges receipt (retry with backoff), de-duplicated by event id on the server. */\n(function () {\n  if (window.__sjUX) return; window.__sjUX = true;\n  var API = function () { return window.__SJ_ADMIN_API || ''; };\n  var staff = function () { try { return !!localStorage.getItem('sj_staff'); } catch (e) { return false; } };\n  var rid = function (n) { var c = 'abcdefghijkmnpqrstuvwxyz23456789', s = ''; for (var i = 0; i < n; i++) s += c[Math.floor(Math.random() * c.length)]; return s; };\n  var LS = 'sj_ux_q', sid = rid(12), seq = 0, q = [];\n  try { q = JSON.parse(localStorage.getItem(LS) || '[]') || []; } catch (e) { q = []; }\n  var vis = null; try { vis = localStorage.getItem('sj_visitor'); } catch (e) {}\n  var ver = (document.querySelector('meta[name=\"sj-version\"]') || {}).content || document.title;\n  function save() { try { localStorage.setItem(LS, JSON.stringify(q.slice(-400))); } catch (e) {} }\n  function push(type, d) {\n    if (staff()) return;\n    d = d || {};\n    q.push({ id: sid + '.' + (++seq), t: Date.now(), type: type, sec: d.sec || '', el: (d.el || '').slice(0, 80), val: d.val == null ? '' : String(d.val).slice(0, 120), n: d.n || 0 });\n    if (q.length > 400) q = q.slice(-400);\n    save();\n  }\n  // ---- helpers ----\n  function section(el) { var s = el && el.closest && el.closest('[data-screen-label]'); return s ? s.getAttribute('data-screen-label') : (el && el.closest && el.closest('#sjA') ? 'Admin' : 'Page'); }\n  function label(el) {\n    if (!el) return '';\n    var t = el.closest('button,a,label,input,select,textarea,summary,[role=button],[data-tab],th,td') || el;\n    var s = t.getAttribute('aria-label') || t.getAttribute('title') || t.getAttribute('placeholder') || t.getAttribute('name') || (t.id ? '#' + t.id : '') || '';\n    var txt = (t.innerText || t.value || '').replace(/\\s+/g, ' ').trim();\n    if (t.tagName === 'INPUT' && (t.type === 'password' || /phone|email|name|company|card/i.test(t.name + t.placeholder + t.autocomplete))) txt = '';   // never capture what people type\n    if (t.tagName === 'INPUT' && t.type !== 'checkbox' && t.type !== 'radio' && t.type !== 'button' && t.type !== 'submit') txt = '';\n    return (t.tagName.toLowerCase() + ':' + (txt.slice(0, 40) || s)).trim();\n  }\n  function interactive(el) { return !!(el && el.closest && el.closest('button,a,input,select,textarea,label,summary,[role=button],[onclick],[data-tab],[data-a],th,[sc-camel-on-click],[style*=\"cursor:pointer\"],[style*=\"cursor: pointer\"]')); }\n  // ---- page + device ----\n  var nav = (performance.getEntriesByType && performance.getEntriesByType('navigation')[0]) || {};\n  push('page', { val: [window.innerWidth + 'x' + window.innerHeight, (navigator.maxTouchPoints > 0 ? 'touch' : 'mouse'), /Mobi|Android|iPhone/i.test(navigator.userAgent) ? 'mobile' : 'desktop', ver].join(' | '), el: document.referrer ? document.referrer.replace(/^https?:\\/\\//, '').split('/')[0] : 'direct' });\n  window.addEventListener('load', function () { setTimeout(function () { var n = (performance.getEntriesByType && performance.getEntriesByType('navigation')[0]) || nav; push('load', { n: Math.round((n.loadEventEnd || performance.now()) - (n.startTime || 0)) }); }, 0); });\n  // inventory ready = first time the results sheet has rows\n  var t0 = performance.now(), readyTimer = setInterval(function () { var r = document.querySelector('[data-screen-label=\"Results sheet\"] tr, [data-screen-label=\"Results sheet\"] [role=row], [role=row], table tbody tr'); if (r) { clearInterval(readyTimer); push('ready', { n: Math.round(performance.now() - t0) }); } else if (performance.now() - t0 > 60000) { clearInterval(readyTimer); push('ready_timeout', { n: 60000 }); } }, 400);\n  // ---- clicks, rage clicks, dead clicks ----\n  var last = [];\n  document.addEventListener('click', function (e) {\n    var el = e.target, sec = section(el), lb = label(el), now = Date.now();\n    push('click', { sec: sec, el: lb });\n    last = last.filter(function (c) { return now - c.t < 1200 && Math.abs(c.x - e.clientX) < 30 && Math.abs(c.y - e.clientY) < 30; });\n    last.push({ t: now, x: e.clientX, y: e.clientY });\n    if (last.length === 3) push('rage', { sec: sec, el: lb, n: 3 });\n    if (!interactive(el)) {\n      var before = document.body.innerHTML.length, y = window.scrollY;\n      setTimeout(function () { if (Math.abs(document.body.innerHTML.length - before) < 2 && window.scrollY === y) push('dead', { sec: sec, el: (el.tagName || '').toLowerCase() + ':' + (el.innerText || '').replace(/\\s+/g, ' ').trim().slice(0, 40) }); }, 700);\n    }\n  }, true);\n  // ---- section visibility time + order ----\n  var seen = {}, visStart = {};\n  function flushSec(name) { if (visStart[name]) { var ms = Date.now() - visStart[name]; delete visStart[name]; if (ms > 800) push('section_time', { sec: name, n: Math.round(ms / 1000) }); } }\n  var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (ents) {\n    ents.forEach(function (en) {\n      var name = en.target.getAttribute('data-screen-label'); if (!name) return;\n      if (en.isIntersecting && en.intersectionRatio >= 0.35) { if (!visStart[name]) visStart[name] = Date.now(); if (!seen[name]) { seen[name] = 1; push('section_view', { sec: name, n: Object.keys(seen).length }); } }\n      else flushSec(name);\n    });\n  }, { threshold: [0, 0.35, 0.7] }) : null;\n  function observe() { if (!io) return; document.querySelectorAll('[data-screen-label]').forEach(function (el) { if (!el.__sjIO) { el.__sjIO = 1; io.observe(el); } }); }\n  setInterval(observe, 2000); observe();\n  // ---- scroll reach ----\n  var maxPct = 0, marks = {};\n  window.addEventListener('scroll', function () { var h = document.documentElement, pct = Math.min(100, Math.round(window.scrollY / Math.max(1, h.scrollHeight - innerHeight) * 100)); if (pct > maxPct) maxPct = pct; [10, 25, 50, 75, 90, 100].forEach(function (m) { if (pct >= m && !marks[m]) { marks[m] = 1; push('scroll', { n: m }); } }); }, { passive: true });\n  // ---- forms: focus, fill (never the value), abandonment ----\n  var fields = {};\n  function fname(el) { return (el.getAttribute('name') || el.getAttribute('aria-label') || el.getAttribute('placeholder') || el.id || el.type || 'field').slice(0, 40); }\n  document.addEventListener('focusin', function (e) { var el = e.target; if (!/INPUT|TEXTAREA|SELECT/.test(el.tagName) || el.closest('#sjA')) return; var k = section(el) + '\u203a' + fname(el); if (!fields[k]) { fields[k] = { f: 1, filled: 0 }; push('field_focus', { sec: section(el), el: fname(el) }); } });\n  document.addEventListener('change', function (e) { var el = e.target; if (!/INPUT|TEXTAREA|SELECT/.test(el.tagName) || el.closest('#sjA')) return; var k = section(el) + '\u203a' + fname(el); if (fields[k] && !fields[k].filled && String(el.value || '').trim()) { fields[k].filled = 1; push('field_filled', { sec: section(el), el: fname(el) }); } });\n  // invalid fields shown to the user (validation friction)\n  document.addEventListener('invalid', function (e) { push('field_invalid', { sec: section(e.target), el: fname(e.target) }); }, true);\n  // ---- errors ----\n  window.addEventListener('error', function (e) { if (e.message) push('js_error', { el: (e.filename || '').split('/').pop().slice(0, 40), val: e.message.slice(0, 120) }); });\n  window.addEventListener('unhandledrejection', function (e) { push('js_error', { el: 'promise', val: String(e.reason && e.reason.message || e.reason).slice(0, 120) }); });\n  // ---- exit summary ----\n  function exitSummary() {\n    Object.keys(visStart).forEach(flushSec);\n    var abandoned = Object.keys(fields).filter(function (k) { return !fields[k].filled; });\n    push('exit', { n: maxPct, val: abandoned.slice(0, 6).join(', '), el: Object.keys(seen).slice(-1)[0] || '' });\n    send(true);\n  }\n  document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') exitSummary(); });\n  window.addEventListener('pagehide', exitSummary);\n  // ---- delivery with acknowledgement ----\n  var busy = false, backoff = 15000, timer = null;\n  var mc = {}; try { var sp = new URLSearchParams(location.search); if (sp.get('mc_eid')) { mc = { mc_eid: sp.get('mc_eid'), mc_cid: sp.get('mc_cid') || '' }; localStorage.setItem('sj_mc', JSON.stringify(mc)); } else mc = JSON.parse(localStorage.getItem('sj_mc') || '{}'); } catch (e) { mc = {}; }\n  function body(batch) { return JSON.stringify({ type: 'ux', sid: sid, visitor: vis || '', ver: ver, mc_eid: mc.mc_eid || '', mc_cid: mc.mc_cid || '', events: batch }); }\n  function send(final) {\n    if (staff()) { if (q.length) { q = []; save(); } return; }\n    if (!API() || !q.length) return;\n    var batch = q.slice(0, 120);\n    if (final) { try { navigator.sendBeacon && navigator.sendBeacon(API(), new Blob([body(batch)], { type: 'text/plain;charset=utf-8' })); } catch (e) {} return; }  // stays queued; server de-dupes if resent\n    if (busy) return; busy = true;\n    fetch(API(), { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: body(batch) })\n      .then(function (r) { return r.json(); })\n      .then(function (j) { busy = false; if (j && j.ok && j.ack) { var ids = {}; j.ack.forEach(function (i) { ids[i] = 1; }); q = q.filter(function (x) { return !ids[x.id]; }); save(); backoff = 15000; if (q.length) setTimeout(send, 500); } else backoff = Math.min(backoff * 2, 300000); })\n      .catch(function () { busy = false; backoff = Math.min(backoff * 2, 300000); });\n  }\n  (function loop() { timer = setTimeout(function () { send(false); loop(); }, backoff); })();\n  setTimeout(function () { send(false); }, 4000);\n})();\n\n</script>\n<script id=\"sj-patcher-src\">\n/* Sparkling Admin patcher \u2014 applies the Admin / live-inventory / analytics add-on to ANY\n   Claude Design export of the Diamond Order Page. Same code runs in the browser tool and in Node.\n   Every step uses tolerant patterns; a step that can't find its spot is reported, never silently\n   half-applied. Steps marked core must succeed or the output is refused. */\n(function (root) {\n  var ADMIN_API_DEFAULT = 'https://script.google.com/macros/s/AKfycbwDTqbIWOZR35RpffTaB1BxKN3kxmkunDQglouPXhfICBuW0gzV8Z1DoqTLh-bUYu77sg/exec';\n\n  var SC = String.fromCharCode(60) + '/script>'; var SCE = '\\n' + SC + '\\n'; var SCM = '\\n' + SC + '\\n<script>\\n';\n  function SCRIPTS(adminJs, pageJs, uxJs) { return '\\n<script id=\"sj-admin-src\">\\n' + adminJs + SCE + (pageJs ? '<script id=\"sj-page-src\">\\n' + pageJs + SCE : '') + '<script id=\"