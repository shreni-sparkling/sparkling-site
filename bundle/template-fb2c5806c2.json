rint th{color:#6d497e;font-size:10px;letter-spacing:1.5px;text-transform:uppercase}#sjST_print table{width:100%;border-collapse:collapse}#sjST_print td,#sjST_print th{padding:8px;border-bottom:1px solid #DDD3E4;text-align:left;font-size:12.5px}#sjST_print tr.hi td{background:#EDE7F2;font-weight:800}#sjST_print tr.lo td{color:#8b8496}',\n    '@media(max-width:900px){.sjST_cols{grid-template-columns:repeat(2,minmax(0,1fr))}.sjST_split{grid-template-columns:1fr}}',\n    '@media(max-width:600px){.sjST_cols,.sjST_g2,.sjST_g3{grid-template-columns:1fr}.sjST_cnt{grid-template-columns:repeat(2,minmax(0,1fr))}.sjST_ln{flex-wrap:wrap}.sjST_la{width:100%;justify-content:flex-start}.sjST_scan{font-size:16px;height:50px}.sjST_left{min-width:0;text-align:left}.sjST_who .nm{display:none}.sjST_sl{flex-wrap:wrap}.sjST_sl .sjST_ld{flex:1 1 calc(100% - 70px)}.sjST_sl .p{flex:1;width:auto;text-align:left}.sjST_tile b{font-size:28px}}'\n  ].join('\\n'); document.head.appendChild(css);\n\n  var S = { screen: 'home', data: null, msg: null, ref: null, modal: null, sign: { step: 1 }, show: { cust: null, lines: [], q: '', results: null, newc: null }, count: { tray: '', found: {}, extra: [], problems: {}, hand: '' } };\n  var root = null;\n  function flash(kind, text) { S.msg = { k: kind, t: text }; }\n  function ensureRoot() { if (root && document.body.contains(root)) return root; root = document.createElement('div'); root.id = 'sjST_app'; root.setAttribute('role', 'dialog'); root.setAttribute('aria-label', 'Staff'); document.body.appendChild(root); root.addEventListener('click', onClick); root.addEventListener('keydown', onKey); root.addEventListener('change', onChange); root.addEventListener('input', onInput); root.addEventListener('submit', function (e) { e.preventDefault(); }); root.addEventListener('paste', function (e) { var t = e.target; if (!t.matches || !t.matches('[data-scan]')) return; var tx = (e.clipboardData || window.clipboardData).getData('text'); if (/[\\s,;]/.test(tx.trim())) { e.preventDefault(); t.value = ''; handleScan(t.getAttribute('data-scan'), tx); } }); return root; }\n  function allowed(scr) { if (scr === 'signin') return true; var a = ACCESS[scr]; return !!a && a.indexOf(role()) >= 0; }\n\n  function open(scr, opts) {\n    scr = scr || 'home'; opts = opts || {}; S.msg = opts.keepMsg ? S.msg : null;\n    if (!isStaff() && scr !== 'signin') scr = 'signin';\n    S.screen = scr; S.ref = opts.ref || null;\n    ensureRoot(); document.body.style.overflow = 'hidden'; document.documentElement.style.overflow = 'hidden';\n    var h = '#st-' + scr; if (location.hash !== h) { try { history.replaceState(null, '', h); } catch (e) {} }\n    return load().then(render);\n  }\n  function close() { if (root) { root.remove(); root = null; } document.body.style.overflow = ''; document.documentElement.style.overflow = ''; if (/^#st-/.test(location.hash)) { try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {} } }\n  function load() {\n    var s = S.screen; if (!allowed(s)) return Promise.resolve(S.data = { denied: true });\n    var m = { home: ['st_home'], users: ['st_users'], board: S.ref ? ['st_order', { ref: S.ref }] : ['st_board'], ship: S.ref ? ['st_order', { ref: S.ref }] : ['st_ship_queue'], settings: ['st_settings'], show: ['st_me'], count: ['st_trays'], books: ['st_books'], clients: ['st_home'], signin: null }[s];\n    if (!m) return Promise.resolve(S.data = {});\n    return api(m[0], m[1]).then(function (d) { S.data = d || {}; if (s === 'ship' && S.ref && d.ok) return carrier('status').then(function (c) { S.data.carriers = c; }); });\n  }\n  function reload() { return load().then(render); }\n\n  /* ---------- render ---------- */\n  function render() {\n    ensureRoot(); var r = role(), s = S.screen; root.className = s === 'show' ? 'dark' : '';\n    var me = meFor(r); var html = '';\n    if (s !== 'signin' || isStaff()) {\n      html += '<div class=\"sjST_top\"><div class=\"sjST_brand\"><b>SPARKLING</b> \u00b7 STAFF</div><div class=\"sjST_who\">' + (isStaff() ? '<span class=\"sjST_role\">' + esc(ROLE_NAME[r] || r) + '</span><span class=\"nm\">' + esc(me.name) + '</span>' : '') + '<button class=\"sjST_x\" data-a=\"close\" aria-label=\"Close staff screens\">Close</button></div></div>';\n      if (isStaff()) { html += '<nav class=\"sjST_nav\" aria-label=\"Staff screens\">'; NAV.forEach(function (n) { if (allowed(n[0])) html += '<button data-a=\"go\" data-x=\"' + n[0] + '\" class=\"' + (s === n[0] ? 'on' : '') + '\">' + esc(n[1]) + '</button>'; }); html += '</nav>'; }\n    } else html += '<div class=\"sjST_top\"><div class=\"sjST_brand\"><b>SPARKLING</b> \u00b7 STAFF</div><div class=\"sjST_who\"><button class=\"sjST_x\" data-a=\"close\">Close</button></div></div>';\n    html += '<main class=\"sjST_main\" id=\"sjST_main\">';\n    if (S.msg) html += '<div class=\"sjST_flash ' + S.msg.k + '\" role=\"status\">' + esc(S.msg.t) + '</div>';\n    var d = S.data || {};\n    if (d.denied) html += vDenied(); else if (d.ok === false && s !== 'signin') html += '<div class=\"sjST_flash bad\">' + esc(d.error || 'Something went wrong.') + '</div>';\n    else html += ({ home: vHome, users: vUsers, board: S.ref ? vPick : vBoard, ship: S.ref ? vShipOne : vShip, settings: vSettings, show: vShow, count: vCount, books: vBooks, clients: vClients, signin: vSignin }[s] || vHome)(d);\n    html += '</main>';\n    if (S.modal) html += '<div class=\"sjST_modal\" role=\"dialog\" aria-modal=\"true\"><div>' + S.modal.html + '</div></div>';\n    var keep = document.activeElement && document.activeElement.id; var st = (document.getElementById('sjST_main') || {}).scrollTop || 0;\n    root.innerHTML = html;\n    var mn = document.getElementById('sjST_main'); if (mn && !S.resetScroll) mn.scrollTop = st; S.resetScroll = false;\n    var f = root.querySelector('[data-autofocus]') || (keep && document.getElementById(keep)); if (f && !S.modal) try { f.focus({ preventScroll: true }); } catch (e) {}\n    if (S.modal) { var mf = root.querySelector('.sjST_modal input,.sjST_modal textarea'); if (mf) mf.focus(); }\n    if (s === 'settings' && !(S.data || {}).denied) settingsLive();\n  }\n  var tag = function (k) { return k === 'invoice' ? '<span class=\"sjST_tag inv\">Invoiced \u00b7 pull first</span>' : '<span class=\"sjST_tag memo\">Memo</span>'; };\n  var custLine = function (c) { if (!c) return ''; return c.company ? esc(c.company) + ' \u00b7 ' + esc(c.no) : 'Customer ' + esc(c.no); };\n  function vDenied() { return '<div class=\"sjST_ey\">Not your queue</div><h1 class=\"sjST_h1\">This one belongs to another team.</h1><p class=\"sjST_sub\">Your role (' + esc(ROLE_NAME[role()] || role()) + ') doesn\u2019t open this screen. Your own work is one tap away.</p><button class=\"sjST_b\" data-a=\"go\" data-x=\"home\">Go to my queue</button>'; }\n\n  /* ---------- sign-in (UI; two-step with emailed code) ---------- */\n  function vSignin() {\n    var g = S.sign; var h = '<div class=\"sjST_sign\">';\n    if (g.step === 1) h += '<div class=\"sjST_ey\" style=\"color:#c9cdd3\">Staff sign-in \u00b7 step 1 of 2</div><h1 class=\"sjST_h1\">Back of house.</h1><p class=\"sjST_sub\">Team members only. Customers sign in from the main site.</p><form data-f=\"sign1\" autocomplete=\"on\"><label class=\"sjST_f\"><span>Username</span><input id=\"sjST_su\" name=\"username\" autocomplete=\"username\" value=\"' + esc(g.user || '') + '\" data-autofocus></label><label class=\"sjST_f\"><span>Password</span><input id=\"sjST_sp\" type=\"password\" name=\"password\" autocomplete=\"current-password\"></label><div class=\"er\" role=\"alert\">' + esc(g.err || '') + '</div><button class=\"sjST_b\" type=\"submit\">Continue</button></form><small>Every sign-in is logged with device and approximate location. Owners are alerted to new devices.</small>' + (window.SJ_API_LIVE === true ? '' : '<small>TEST logins: owner.test \u00b7 sales.test \u00b7 picker.test \u00b7 ship.test \u00b7 books.test \u2014 any password.</small>');\n    else h += '<div class=\"sjST_ey\" style=\"color:#c9cdd3\">Staff sign-in \u00b7 step 2 of 2</div><h1 class=\"sjST_h1\">Check your email.</h1><p class=\"sjST_sub\">We sent a 6-digit code to <b>' + esc(g.sentTo) + '</b>. It works once, for 10 minutes.</p>' + (g.demoCode ? '<div class=\"sjST_testc\">Test mode \u00b7 code is ' + esc(g.demoCode) + '</div>' : '') + '<form data-f=\"sign2\"><label class=\"sjST_f\"><span>Sign-in code</span><input id=\"sjST_sc\" class=\"sjST_code\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" pattern=\"[0-9]*\" data-autofocus></label><div class=\"er\" role=\"alert\">' + esc(g.err || '') + '</div><button class=\"sjST_b\" type=\"submit\">Verify and sign in</button></form><button class=\"lnk\" data-a=\"resend\">' + (g.cool ? 'Resend available in ' + g.cool + 's' : 'Resend code') + '</button><button class=\"lnk\" data-a=\"askowner\">No email access? Ask an owner for a code</button><button class=\"lnk\" data-a=\"signback\">Use a different login</button>' + (g.ask ? '<small>An owner can read your pending code from Staff \u2192 Sign-ins and tell you by phone. Never share a code over text or email.</small>' : '');\n    return h + '</div>';\n  }\n\n  /* ---------- home per role ---------- */\n  function vHome(d) {\n    var r = role(), h = '<div class=\"sjST_ey\">' + esc(ROLE_NAME[r]) + ' \u00b7 ' + new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' }) + '</div>';\n    if (r === 'owner') {\n      h += '<h1 class=\"sjST_h1\">Everything, at a glance.</h1><p class=\"sjST_sub\">You see every queue, every customer and cost. Nobody else does.</p><div class=\"sjST_tiles\">' +\n        tile('board', d.toPull, 'To pull', d.toPullInv + ' invoiced first') + tile('board', d.inCheck, 'Pulled \u00b7 checking', '') + tile('ship', d.toShip, 'Ready to ship', '') + tile('ship', d.inTransit, 'In transit', '') + tile('books', d.toVerify, 'Payments to verify', '') + tile('users', d.staffOn + '/' + d.staffAll, 'Staff logins on', '', true) + '</div>';\n      if (d.no2fa && d.no2fa.length) h += '<div class=\"sjST_flash ask\" style=\"margin-top:14px\">Not on 2-step yet: ' + esc(d.no2fa.join(', ')) + '. They\u2019ll be asked at next sign-in.</div>';\n      h += '<div class=\"sjST_h2\">Pick queue</div>' + queueTable(d.queue || [], true);\n      h += '<div class=\"sjST_h2\">Customer emails from these screens</div>' + (d.emails && d.emails.length ? '<div class=\"sjST_tw\"><table class=\"sjST_tbl\"><tr><th>When</th><th>Order</th><th>To</th><th>Subject</th><th>Status</th></tr>' + d.emails.map(function (e) { return '<tr><td>' + esc(e.at) + '</td><td>' + esc(e.ref) + '</td><td>' + esc(e.to) + '</td><td>' + esc(e.subject) + '</td><td><span class=\"sjST_tag warn\">' + esc(e.status) + '</span></td></tr>'; }).join('') + '</table></div>' : '<div class=\"sjST_empty\">No emails yet. Ship something.</div>');\n      return h;\n    }\n    if (r === 'orderproc') { var q = d.queue || []; var next = q.filter(function (o) { return o.stage === 'topull'; })[0]; h += '<h1 class=\"sjST_h1\">' + (d.toPull ? d.toPull + ' to pull. Invoiced first.' : 'Queue\u2019s clear. Nice.') + '</h1><p class=\"sjST_sub\">You see order numbers and customer numbers only. Scan every piece; the screen tells you what\u2019s left.</p>' + (next ? '<button class=\"sjST_b sjST_big\" style=\"max-width:420px\" data-a=\"pick\" data-x=\"' + esc(next.ref) + '\">Start pulling ' + esc(next.ref) + '</button>' : '') + '<div class=\"sjST_h2\">Your queue</div>' + queueTable(q, false); return h; }\n    if (r === 'shipping') { var sq = d.queue || []; h += '<h1 class=\"sjST_h1\">' + (d.toShip ? d.toShip + ' ready to box.' : 'Nothing waiting. Go stretch.') + '</h1><p class=\"sjST_sub\">Count every piece into its parcel, print labels, mark shipped when the carrier has it.</p><div class=\"sjST_h2\">Ready to ship</div>' + shipTable(sq); return h; }\n    if (r === 'sales') { h += '<h1 class=\"sjST_h1\">Your clients, your sales.</h1><p class=\"sjST_sub\">You see your assigned clients in full. Everyone else shows as a customer number (' + (d.others || 0) + ' others).</p><div class=\"sjST_tiles\">' + tile('clients', (d.clients || []).length, 'My clients', '', true) + tile('clients', money(d.sales), 'Open order value', '', true) + tile('show', '\u25b6', 'Show mode', 'Scan-to-cart at the booth') + '</div><div class=\"sjST_h2\">My clients\u2019 orders</div>' + salesOrders(d.orders || []); return h; }\n    if (r === 'accounting') { h += '<h1 class=\"sjST_h1\">' + (d.toVerify ? d.toVerify + ' payments to verify.' : 'Books are square.') + '</h1><p class=\"sjST_sub\">Sold items and amounts. Confirm money actually landed before anything is marked paid.</p>' + booksTable(d.invoices || []); return h; }\n    return h;\n  }\n  function tile(go, n, label, sub, light) { return '<button class=\"sjST_tile' + (light ? ' lt' : '') + '\" data-a=\"go\" data-x=\"' + go + '\"><small>' + esc(label) + '</small><b>' + esc(n == null ? '\u2013' : n) + '</b>' + (sub ? '<small style=\"letter-spacing:1px;font-weight:600;text-transform:none\">' + esc(sub) + '</small>' : '') + '</button>'; }\n  var STAGE_NAME = { topull: 'To pull', pulled: 'Pulled', checked: 'Checked', packed: 'Packed', labeled: 'Labeled', shipped: 'Shipped', delivered: 'Delivered', handed: 'Handed over' };\n  function queueTable(q, owner) { if (!q.length) return '<div class=\"sjST_empty\">Nothing in the queue.</div>'; return '<div class=\"sjST_tw\"><table class=\"sjST_tbl\"><tr><th>Order</th><th>Type</th><th>Customer</th><th>Pieces</th><th>Stage</th><th></th></tr>' + q.map(function (o) { return '<tr><td><b>' + esc(o.ref) + '</b></td><td>' + tag(o.kind) + '</td><td>' + (owner ? custLine(o.cust) : esc(o.cust.no)) + '</td><td>' + o.lines.length + '</td><td>' + esc(STAGE_NAME[o.stage]) + (o.hold ? ' <span class=\"sjST_tag bad\">On hold</span>' : '') + '</td><td><button class=\"sjST_b sm\" data-a=\"pick\" data-x=\"' + esc(o.ref) + '\">Open</button></td></tr>'; }).join('') + '</table></div>'; }\n  function shipTable(q) { if (!q.length) return '<div class=\"sjST_empty\">Nothing packed yet.</div>'; return '<div class=\"sjST_tw\"><table class=\"sjST_tbl\"><tr><th>Order</th><th>Ship to</th><th>Parcels</th><th>Carrier rule</th><th>Stage</th><th></th></tr>' + q.map(function (o) { return '<tr><td><b>' + esc(o.ref) + '</b><br><small>' + esc(o.cust.no) + '</small></td><td>' + esc(o.shipTo.label) + '<br><small>' + esc(o.shipTo.city + ', ' + o.shipTo.st) + '</small></td><td>' + o.parcels.length + '</td><td>' + esc(o.rule.carrier) + ' \u00b7 ' + money(o.rule.price) + '</td><td>' + esc(STAGE_NAME[o.stage]) + '</td><td><button class=\"sjST_b sm\" data-a=\"shipone\" data-x=\"' + esc(o.ref) + '\">Open</button></td></tr>'; }).join('') + '</table></div>'; }\n  function salesOrders(q) { if (!q.length) return '<div class=\"sjST_empty\">No orders for your clients yet.</div>'; return '<div class=\"sjST_tw\"><table class=\"sjST_tbl\"><tr><th>Order</th><th>Client</th><th>Type</th><th>Stage</th><th>Value</th></tr>' + q.map(function (o) { return '<tr><td><b>' + esc(o.ref) + '</b></td><td>' + custLine(o.cust) + '</td><td>' + tag(o.kind) + '</td><td>' + esc(STAGE_NAME[o.stage] || o.stage) + '</td><td>' + money(o.total) + '</td></tr>'; }).join('') + '</table></div>'; }\n\n  /* ---------- board ---------- */\n  function vBoard(d) {\n    var cols = [['topull', 'To pull'], ['pulled', 'Pulled'], ['checked', 'Checked'], ['packed', 'Packed']];\n    var O = (d.orders || []).slice().sort(function (a, b) { return (a.kind === 'invoice' ? 0 : 1) - (b.kind === 'invoice' ? 0 : 1); });\n    var h = '<div class=\"sjST_ey\">Order processing</div><h1 class=\"sjST_h1\">Pull. Check. Pack.</h1><p class=\"sjST_sub\">Invoiced orders sit on top \u2014 they\u2019re paid, so they go first. Parcel cap is ' + money(d.cap) + '; big orders split automatically.</p><div class=\"sjST_cols\">';\n    cols.forEach(function (c) { var list = O.filter(function (o) { return o.stage === c[0]; }); h += '<section class=\"sjST_col\"><h3><span>' + c[1] + '</span><span>' + list.length + '</span></h3>' + (list.length ? list.map(function (o) { var cats = {}; o.lines.forEach(function (l) { cats[l.cat] = 1; }); var left = o.lines.filter(function (l) { return l.state === 'open'; }).length; return '<button class=\"sjST_oc ' + (o.kind === 'invoice' ? 'inv' : '') + '\" data-a=\"pick\" data-x=\"' + esc(o.ref) + '\"><div class=\"r\">' + esc(o.ref) + '</div><div class=\"m\">' + tag(o.kind) + (o.hold ? ' <span class=\"sjST_tag bad\">Hold</span>' : '') + (o.partial ? ' <span class=\"sjST_tag warn\">Partial</span>' : '') + '</div><div class=\"m\">Customer ' + esc(o.cust.no) + ' \u00b7 ' + o.lines.length + ' pcs' + (c[0] === 'topull' ? ' \u00b7 ' + left + ' left' : '') + (o.parcels.length > 1 ? ' \u00b7 ' + o.parcels.length + ' parcels' : '') + '</div><div class=\"m\">' + esc(Object.keys(cats).join(' \u00b7 ')) + '</div></button>'; }).join('') : '<div style=\"font-size:12px;color:#6b6478;padding:6px\">Empty</div>') + '</section>'; });\n    return h + '</div>';\n  }\n  function vPick(d) {\n    var o = d.order; if (!o) return ''; var st = o.stage; var idx = ['topull', 'pulled', 'checked', 'packed'].indexOf(st);\n    var h = '<button class=\"sjST_b g sm\" data-a=\"board\">\u2039 All orders</button><div class=\"sjST_row\" style=\"margin-top:12px\"><div><div class=\"sjST_ey\">' + (st === 'topull' ? 'Pull' : st === 'pulled' ? 'Check' : st === 'checked' ? 'Pack' : 'Packed') + ' \u00b7 customer ' + esc(o.cust.no) + '</div><h1 class=\"sjST_h1\">' + esc(o.ref) + ' ' + tag(o.kind) + '</h1></div></div>';\n    h += '<div class=\"sjST_steps\">' + ['To pull', 'Pulled', 'Checked', 'Packed'].map(function (n, i) { return '<span class=\"' + (i < idx ? 'done' : i === idx ? 'on' : '') + '\">' + n + '</span>'; }).join('') + '</div>';\n    if (o.hold) h += '<div class=\"sjST_flash bad\">On hold until the missing pieces turn up. Find them and scan, or switch to ship-what-we-have.</div>';\n    var open = o.lines.filter(function (l) { return l.state === 'open'; }).length, unchecked = o.lines.filter(function (l) { return l.state !== 'missing' && !l.checked; }).length;\n    if (st === 'topull' || st === 'pulled') h += '<div class=\"sjST_scanw\"><label for=\"sjST_scan\">' + (st === 'topull' ? 'Scan or type stock number \u00b7 RFID tags work too' : 'Check pass \u00b7 scan every piece again') + '</label><input id=\"sjST_scan\" class=\"sjST_scan\" data-scan=\"' + (st === 'topull' ? 'pick' : 'check') + '\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"SJT-\u2026\" data-autofocus><div class=\"sjST_left\"><b>' + (st === 'topull' ? open : unchecked) + '</b><small>' + (st === 'topull' ? 'LEFT TO PULL' : 'LEFT TO CHECK') + '</small></div></div>';\n    var cats = {}; o.lines.forEach(function (l) { (cats[l.cat] = cats[l.cat] || []).push(l); });\n    var parcelOf = {}; o.parcels.forEach(function (p) { p.lines.forEach(function (id) { parcelOf[id] = p.n; }); });\n    Object.keys(cats).sort().forEach(function (c) {\n      h += '<div class=\"sjST_cat\">' + esc(c) + ' \u00b7 ' + cats[c].length + '</div>';\n      cats[c].forEach(function (l) {\n        var cls = l.state === 'missing' ? 'missing' : l.state === 'replaced' ? 'replaced' : l.state === 'found' ? 'found' : ''; if (st === 'pulled' && l.checked) cls += ' chk'; if (S.flashLine === l.id) cls += ' flash';\n        var chip = l.state === 'open' ? '<span class=\"sjST_tag\">To pull</span>' : l.state === 'missing' ? '<span class=\"sjST_tag bad\">Unable to be found</span>' : l.state === 'replaced' ? '<span class=\"sjST_tag warn\">Replaced</span>' : '<span class=\"sjST_tag ok\">Pulled</span>';\n        if (st !== 'topull' && l.state !== 'missing') chip += l.checked ? ' <span class=\"sjST_tag ok\">Checked</span>' : ' <span class=\"sjST_tag\">Not checked</span>';\n        h += '<div class=\"sjST_ln ' + cls + '\">' + pic(l.cat) + '<div class=\"sjST_ld\"><b>' + esc(l.desc) + '</b><small>' + esc(l.sku) + (l.price != null ? ' \u00b7 ' + money(l.price) : '') + (l.cost != null ? ' \u00b7 cost ' + money(l.cost) : '') + (parcelOf[l.id] && o.parcels.length > 1 ? ' \u00b7 parcel ' + parcelOf[l.id] : '') + '</small>' + (l.state === 'replaced' ? '<small><b style=\"display:inline;font-size:12px\">Packed instead: ' + esc(l.got) + '</b> \u2014 ' + esc(l.gotDesc) + '<br>Note: \u201c' + esc(l.note) + '\u201d</small>' : '') + (l.state === 'missing' ? '<small>Note: \u201c' + esc(l.note) + '\u201d</small>' : '') + '<div style=\"margin-top:4px\">' + chip + '</div></div>';\n        if (st === 'topull') h += '<div class=\"sjST_la\">' + (l.state === 'open' ? '<button class=\"sjST_b g sm\" data-a=\"replace\" data-x=\"' + l.id + '\">Use another</button><button class=\"sjST_b d sm\" data-a=\"missing\" data-x=\"' + l.id + '\">Can\u2019t find</button>' : '<button class=\"sjST_b g sm\" data-a=\"undo\" data-x=\"' + l.id + '\">Undo</button>') + '</div>';\n        h += '</div>';\n      });\n    });\n    h += '<div class=\"sjST_h2\">Parcels \u00b7 cap ' + money(o.cap) + ' each</div>' + o.parcels.map(function (p) { return '<div class=\"sjST_parcel\"><header><span>Parcel ' + p.n + ' of ' + o.parcels.length + '</span><span>' + p.lines.length + ' pcs \u00b7 ' + money(p.value) + (p.over ? ' \u00b7 OVER CAP' : '') + '</span></header><div>' + p.lines.map(function (id) { var l = o.lines.filter(function (z) { return z.id === id; })[0]; return esc((l.got || l.sku) + ' \u2014 ' + (l.state === 'replaced' ? l.gotDesc : l.desc)); }).join('<br>') + (p.over ? '<br><b style=\"color:#8a1f2b\">One piece is worth more than the cap. An owner must approve shipping it alone.</b>' : '') + '</div></div>'; }).join('');\n    h += '<div class=\"sjST_row\" style=\"margin-top:16px\">';\n    if (st === 'topull') h += '<button class=\"sjST_b\" data-a=\"stage\" data-x=\"pulled\"' + (open ? ' disabled' : '') + '>Mark pulled</button>' + (open ? '<span style=\"font-size:12px;color:#6b6478\">Every line needs a scan, a replacement or \u201ccan\u2019t find\u201d.</span>' : '');\n    if (st === 'pulled') h += '<button class=\"sjST_b\" data-a=\"stage\" data-x=\"checked\"' + (unchecked ? ' disabled' : '') + '>Mark checked</button><button class=\"sjST_b g\" data-a=\"stage\" data-x=\"topull\">Back to pulling</button>';\n    if (st === 'checked') h += '<button class=\"sjST_b\" data-a=\"stage\" data-x=\"packed\">Packed \u00b7 send to shipping</button><span style=\"font-size:12px;color:#6b6478\">Bag each parcel exactly as listed above.</span>';\n    if (st === 'packed') h += '<span class=\"sjST_tag ok\">With shipping now</span>';\n    return h + '</div>';\n  }\n\n  /* ---------- shipping ---------- */\n  function vShip(d) { return '<div class=\"sjST_ey\">Shipping</div><h1 class=\"sjST_h1\">Box it. Label it. Send it.</h1><p class=\"sjST_sub\">Labels never mention what\u2019s inside. Names are scrubbed by the owner\u2019s label rules before printing.</p>' + shipTable(d.orders || []); }\n  function vShipOne(d) {\n    var o = d.order; if (!o) return ''; var boxed = o.boxedIds || []; var c = (d.carriers || {});\n    var h = '<button class=\"sjST_b g sm\" data-a=\"shipq\">\u2039 Shipping queue</button><div class=\"sjST_ey\" style=\"margin-top:12px\">' + esc(STAGE_NAME[o.stage]) + ' \u00b7 customer ' + esc(o.cust.no) + '</div><h1 class=\"sjST_h1\">' + esc(o.ref) + ' ' + tag(o.kind) + (o.partial ? ' <span class=\"sjST_tag warn\">Partial</span>' : '') + '</h1>';\n    h += '<div class=\"sjST_steps\">' + ['Count', 'Label', 'Shipped', 'Delivered'].map(function (n, i) { var at = { packed: 0, labeled: 1, shipped: 2, delivered: 3 }[o.stage]; if (at === 0 && o.counted) at = 1; return '<span class=\"' + (i < at ? 'done' : i === at ? 'on' : '') + '\">' + n + '</span>'; }).join('') + '</div>';\n    if (o.stage === 'packed') h += '<div class=\"sjST_scanw\"><label for=\"sjST_scan\">Count into the box \u00b7 scan each piece</label><input id=\"sjST_scan\" class=\"sjST_scan\" data-scan=\"box\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"SJT-\u2026\" data-autofocus><div class=\"sjST_left\"><b>' + o.lines.filter(function (l) { return l.state !== 'missing'; }).length + '</b><small>PIECES</small></div></div>';\n    h += '<div class=\"sjST_split\"><div>';\n    o.parcels.forEach(function (p, i) {\n      h += '<div class=\"sjST_parcel\"><header><span>Parcel ' + p.n + ' of ' + o.parcels.length + '</span><span>Declared ' + money(p.value) + '</span></header><div>' + p.lines.map(function (id) { var l = o.lines.filter(function (z) { return z.id === id; })[0]; var ok = (S.boxed[o.ref] || {})[id] || o.counted; return '<div style=\"display:flex;gap:8px;align-items:center;padding:4px 0\">' + (ok ? '<span class=\"sjST_tag ok\">In box</span>' : '<span class=\"sjST_tag\">Count</span>') + ' ' + esc(l.got || l.sku) + ' \u2014 ' + esc(l.state === 'replaced' ? l.gotDesc : l.desc) + '</div>'; }).join('') + (o.tracking[i] ? '<div style=\"margin-top:6px\"><b>Tracking:</b> ' + esc(o.tracking[i]) + ' <span class=\"sjST_tag warn\">Test label</span></div>' : '') + '<div style=\"margin-top:8px\"><button class=\"sjST_b g sm\" data-a=\"print\" data-x=\"' + p.n + '\">Print memo \u00b7 parcel ' + p.n + '</button></div></div></div>';\n    });\n    h += '<div class=\"sjST_row\" style=\"margin-top:8px\">';\n    if (o.stage === 'packed') h += (o.counted ? '' : '<button class=\"sjST_b g\" data-a=\"countall\">Counted by hand</button>') + '<button class=\"sjST_b\" data-a=\"labels\"' + (o.counted ? '' : ' disabled') + '>Create labels (' + esc(o.rule.carrier) + ')</button>';\n    if (o.stage === 'labeled') h += '<button class=\"sjST_b\" data-a=\"sstage\" data-x=\"shipped\">Carrier has it \u00b7 mark shipped</button>';\n    if (o.stage === 'shipped') h += '<span class=\"sjST_tag ok\">In transit</span>' + (window.SJ_API_LIVE === true ? '' : '<button class=\"sjST_b s\" data-a=\"sstage\" data-x=\"delivered\">TEST \u00b7 carrier says delivered</button>');\n    if (o.stage === 'delivered') h += '<span class=\"sjST_tag ok\">Delivered \u00b7 signed for</span>';\n    h += '</div></div><div>';\n    h += '<div class=\"sjST_card\"><div class=\"sjST_ey\">Label preview</div><div class=\"sjST_label\" style=\"margin-top:8px\">FROM: ' + esc(o.fromName) + '<br>550 S HILL ST STE 1141<br>LOS ANGELES CA 90013<br><br>TO: ' + esc(String(o.shipTo.label).toUpperCase()) + '<br>' + esc(String(o.shipTo.addr).toUpperCase()) + '<br>' + esc((o.shipTo.city + ' ' + o.shipTo.st + ' ' + o.shipTo.zip).toUpperCase()) + '<br><br>CONTENTS: ' + esc(String(o.contents).toUpperCase()) + '<br>' + (o.rule.signature ? 'SIGNATURE REQUIRED' : 'NO SIGNATURE') + '</div><div style=\"font-size:12px;color:#6b6478;margin-top:8px\">Recipient name comes from the label rules \u2014 never the store name if it says what\u2019s inside.</div></div>';\n    h += '<div class=\"sjST_card\" style=\"margin-top:10px\"><div class=\"sjST_ey\">Carrier rule</div><div style=\"font-size:20px;font-weight:800;margin:6px 0 2px\">' + esc(o.rule.carrier) + ' \u00b7 ' + money(o.rule.price) + '</div><div style=\"font-size:12.5px;color:#4a4458\">' + esc(o.rule.service) + '<br>Why: ' + esc(o.rule.why) + '</div>' + (o.rule.warn ? '<div class=\"sjST_tag warn\" style=\"margin-top:6px\">' + esc(o.rule.warn) + '</div>' : '') + (o.stage === 'packed' ? '<label class=\"sjST_chk\" style=\"margin-top:10px\"><input type=\"checkbox\" data-c=\"saturday\"' + (o.saturday ? ' checked' : '') + '> Saturday delivery</label>' : '') + '<div style=\"font-size:11.5px;color:#6b6478;margin-top:8px\">FedEx: ' + (c.fedex && c.fedex.connected ? 'connected' : 'not connected \u2014 test labels') + ' \u00b7 UPS: ' + (c.ups && c.ups.connected ? 'connected' : 'not connected \u2014 test labels') + '</div></div>';\n    h += '<div class=\"sjST_card\" style=\"margin-top:10px\"><div class=\"sjST_ey\">Customer emails</div>' + ((o.emails || []).length ? o.emails.map(function (e) { return '<div style=\"font-size:12.5px;padding:5px 0;border-bottom:1px solid #EEE9F3\"><b>' + esc(e.subject) + '</b><br><span style=\"color:#6b6478\">' + esc(e.at) + (e.to ? ' \u00b7 ' + esc(e.to) : '') + ' \u00b7 ' + esc(e.status) + '</span></div>'; }).join('') : '<div style=\"font-size:12.5px;color:#6b6478;margin-top:6px\">Sent automatically: tracking when labels print, shipped when you mark it, a \u201chow does it look?\u201d note on delivery.</div>') + '</div>';\n    return h + '</div></div>';\n  }\n  function printParcel(n) {\n    var o = S.data.order; if (!o) return; var p = o.parcels.filter(function (z) { return z.n === +n; })[0]; var pr = document.getElementById('sjST_print'); if (!pr) { pr = document.createElement('div'); pr.id = 'sjST_print'; document.body.appendChild(pr); }\n    pr.innerHTML = '<div class=\"pr\"><div style=\"display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px\"><button class=\"sjST_b\" onclick=\"window.print()\" style=\"height:36px;padding:0 14px;background:#261d3d;color:#fff;border:0;font-weight:800;letter-spacing:1.5px;cursor:pointer\">PRINT</button><button onclick=\"this.closest(\\'#sjST_print\\').classList.remove(\\'on\\')\" style=\"height:36px;padding:0 14px;border:1px solid #261d3d;background:#fff;font-weight:800;letter-spacing:1.5px;cursor:pointer\">CLOSE</button></div>' +\n      '<div style=\"font-size:11px;letter-spacing:4px;font-weight:800;color:#6d497e\">' + (o.kind === 'memo' ? 'MEMO' : 'PACKING LIST') + ' \u00b7 ' + esc(o.ref) + '</div><h2 style=\"margin:6px 0 2px;font-size:24px\">Parcel ' + p.n + ' of ' + o.parcels.length + '</h2><div style=\"color:#4a4458;margin-bottom:12px\">Date ' + esc(o.created) + ' \u00b7 Customer ' + esc(o.cust.no) + ' \u00b7 Highlighted rows are in this parcel. The full ' + (o.kind === 'memo' ? 'memo' : 'order') + ' is shown for reference.</div>' +\n      '<table><tr><th>Stock</th><th>Description</th><th>Parcel</th></tr>' + o.lines.filter(function (l) { return l.state !== 'missing'; }).map(function (l) { var inP = p.lines.indexOf(l.id) >= 0; var pn = o.parcels.filter(function (z) { return z.lines.indexOf(l.id