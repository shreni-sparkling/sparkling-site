cursor:pointer;white-space:nowrap\">VIEW DETAILS</button></sc-if></div></div><button type=\"button\" class=\"sjLineRm\" sc-camel-on-click=\"{{ l.remove }}\" aria-label=\"Remove {{ l.sku }}\" title=\"Remove from your bag\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M6 12h12\"></path></svg></button></div></sc-for></div></div></sc-for><sc-if value=\"{{ hasPicks }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"background:#E7E2EC;padding:14px 16px;display:flex;flex-direction:column;gap:8px\"><sc-if value=\"{{ hasPicks }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"display:flex;flex-direction:column;gap:4px\"><span style=\"font-size:var(--fs-label);font-weight:600;letter-spacing:var(--ls-label);color:var(--st-muted)\">ESTIMATED VALUE</span><sc-for list=\"{{ pickGroups }}\" as=\"pg\"><div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:2px 12px;flex-wrap:wrap\"><span style=\"font-size:13px;color:var(--st-ink)\">{{ pg.totLbl }}</span><span style=\"font-family:var(--font-display);font-size:20px;line-height:1.15;font-weight:800;color:var(--st-ink);font-variant-numeric:tabular-nums\">{{ pg.totT }}</span></div></sc-for></div></sc-if><p style=\"margin:0;font-size:11px;line-height:16px;color:var(--sj-purple-900)\">Before applicable taxes and shipping. Availability and final pricing are confirmed by Sparkling Jewelry.</p></div></sc-if></div>\n<div style=\"display:flex;flex-direction:column;gap:12px;min-width:0;padding-top:12px\"><span style=\"font-size:var(--fs-label);font-weight:600;letter-spacing:var(--ls-label);color:var(--st-muted)\">03 \u00b7 YOUR BUSINESS DETAILS</span><div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(185px,100%),1fr));gap:10px 12px\">\n<label style=\"display:flex;flex-direction:column;gap:6px\"><span style=\"font-size:10px;font-weight:600;letter-spacing:1.8px;color:#3