(ce.programNo || '') + '\" style=\"width:100%\"></label><label class=\"muted\">Owner (salesperson)<input class=\"in\" id=\"sjCOwner\" value=\"' + esc(ce.owner || '') + '\" style=\"width:100%\"></label><label class=\"muted\">How they reached us<input class=\"in\" id=\"sjCSource\" value=\"' + esc(ce.source || '') + '\" placeholder=\"JCK, referral, walk-in\u2026\" style=\"width:100%\"></label><label class=\"muted\">Preferred channel<select class=\"in\" id=\"sjCChan\" style=\"width:100%\"><option value=\"email\"' + (ce.channel === 'email' || !ce.channel ? ' selected' : '') + '>Email</option><option value=\"sms\"' + (ce.channel === 'sms' ? ' selected' : '') + '>Text</option><option value=\"both\"' + (ce.channel === 'both' ? ' selected' : '') + '>Both</option></select></label><label style=\"display:flex;align-items:center;gap:8px\"><input type=\"checkbox\" id=\"sjCSms\" ' + (ce.sms ? 'checked' : '') + '> Agreed to texts</label><label class=\"muted\" style=\"grid-column:1/-1\">Notes<input class=\"in\" id=\"sjCNotes\" value=\"' + esc(ce.custNotes || ce.notes || '') + '\" style=\"width:100%\"></label>' +\n      '<label style=\"grid-column:1/-1;display:flex;align-items:center;gap:8px\"><input type=\"checkbox\" id=\"sjCKyc\" ' + (ce.kyc ? 'checked' : '') + '> KYC on file in the ERP \u2014 treat their orders as verified</label>' +\n      '<div style=\"grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap\"><button class=\"b pri\" type=\"submit\" ' + (S.busy ? 'disabled' : '') + '>SAVE</button><button class=\"b\" type=\"button\" data-a=\"custcancel\">CANCEL</button>' + (ce.row ? '<button class=\"b danger\" type=\"button\" data-a=\"custdel\" data-row=\"' + ce.row + '\">UNLINK</button>' : '') + '</div></form></div>'; }\n    h += '<div class=\"card\" style=\"margin-top:16px\"><h2>LINK YOUR ERP CUSTOMER LIST' + (o.customersDir ? ' \u00b7 ' + o.customersDir + ' LINKED' : '') + '</h2><div class=\"muted\" style=\"margin-bottom:8px\">Export customers from the ERP (Excel/CSV), copy the cells including the header row, paste here. Columns are recognised by their header: customer # / ERP, company or store, contact, email, phone, KYC (yes/no \u2014 blank means yes), program (RJO/NIJA), member #. Existing links are updated, new ones added \u2014 nothing is deleted.</div><form data-form=\"custimport\" style=\"display:grid;gap:8px\"><label class=\"muted\" style=\"display:grid;gap:4px\">UPLOAD THE FILE (CSV)<input class=\"in\" type=\"file\" id=\"sjCustFile\" accept=\".csv,.txt,.tsv\" style=\"padding:6px\"></label><div class=\"muted\">\u2026or paste:</div><textarea class=\"in\" id=\"sjCustPaste\" rows=\"4\" style=\"height:auto;padding:8px;font-family:ui-monospace,monospace;font-size:12px\" placeholder=\"Customer #\\tCompany\\tContact\\tEmail\\tPhone\\tKYC\\tProgram\\tMember #\\n10234\\tGold & Co\\tAnn Lee\\tann@goldco.com\\t213 555 1212\\tyes\\tRJO\\t4471\"></textarea><div><button class=\"b pri\" type=\"submit\" ' + (S.busy ? 'disabled' : '') + '>IMPORT / UPDATE LINKS</button></div></form></div>';\n    var ca = S.carts;\n    h += '<div class=\"card\" style=\"margin-top:16px\"><h2>ANONYMOUS CARTS \u00b7 ADDED STONES, NEVER SENT A REQUEST</h2><div class=\"muted\" style=\"margin-bottom:8px\">Visitors who put stones in the bag but never told us who they are. If they arrived from a Mailchimp campaign link, Mailchimp can tell us their name and email \u2014 press IDENTIFY. Otherwise you can attach a name by hand (e.g. after a call).</div>' +\n      '<div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px\"><button class=\"b pri\" data-a=\"mcresolve\" ' + (ca && ca.mcReady ? '' : 'disabled title=\"Connect Mailchimp first\"') + '>IDENTIFY VIA MAILCHIMP' + (ca && ca.unresolved ? ' \u00b7 ' + ca.unresolved + ' POSSIBLE' : '') + '</button><button class=\"b\" data-a=\"cartsload\">RELOAD</button></div>' +\n      (!ca ? '<div class=\"muted\">' + (S.cartsBusy ? 'Loading\u2026' : 'Press RELOAD.') + '</div>' : (ca.carts.length ? '<div class=\"tw\"><table><tr><th>LAST SEEN</th><th>WHO</th><th>STONES IN BAG</th><th>VISITS</th><th>DEVICE</th><th>FROM</th><th></th></tr>' + ca.carts.map(function (c) { return '<tr><td style=\"white-space:nowrap\">' + esc(c.last) + '</td><td>' + (c.email ? '<b>' + esc(c.name || '') + '</b><br>' + esc(c.email) + (c.company ? '<br>' + esc(c.company) : '') : '<span class=\"muted\">unknown \u00b7 ' + esc(c.visitor) + '</span>' + (c.mc ? '<br><span class=\"pill\" style=\"border-color:#B8860B;color:#B8860B\">CAME FROM MAILCHIMP</span>' : '')) + '</td><td>' + c.added.map(function (a) { return '<span class=\"pill\" style=\"margin:1px;' + (a.inStock ? '' : 'border-color:#C8554F;color:#C8554F') + '\" title=\"' + esc(a.label) + '\">' + esc(a.id) + '</span>'; }).join(' ') + '<br><span class=\"muted\">' + esc(c.added.slice(0, 2).map(function (a) { return a.label; }).join(' \u00b7 ')) + (c.added.length > 2 ? ' \u00b7 +' + (c.added.length - 2) : '') + '</span></td><td>' + c.sessions + '</td><td>' + esc(c.device) + '</td><td>' + esc(c.source || '') + '</td><td><button class=\"b\" data-cartid=\"' + esc(c.visitor) + '\">ATTACH NAME</button></td></tr>'; }).join('') + '</table></div>' : '<div class=\"muted\">No anonymous carts in this range.</div>')) + '</div>';\n    return h;\n  }\n  function buyerKey(email, phone, visitor) { return String(email || phone || visitor || '').toLowerCase(); }\n  function buyerPanel(email, phone, visitor) {\n    var k = buyerKey(email, phone, visitor); if (!k) return '';\n    var p = (S.buyers || {})[k];\n    if (!p) return '<div style=\"margin-top:10px\"><button class=\"b\" type=\"button\" data-buyer=\"' + esc(k) + '\" data-email=\"' + esc(email || '') + '\" data-phone=\"' + esc(phone || '') + '\" data-visitor=\"' + esc(visitor || '') + '\">' + (p === undefined ? 'BUYER PROFILE \u00b7 WHAT THEY LOOKED AT' : 'LOADING\u2026') + '</button></div>';\n    if (p === 'loading') return '<div class=\"muted\" style=\"margin-top:10px\">Loading their activity\u2026</div>';\n    if (!p.found) return '<div class=\"muted\" style=\"margin-top:10px\">No page activity recorded for this buyer yet (they may have ordered from another device or before tracking started).</div>';\n    var pill = function (t, c) { return '<span class=\"pill\" style=\"margin:1px' + (c ? ';border-color:' + c + ';color:' + c : '') + '\">' + esc(t) + '</span>'; };\n    return '<div style=\"margin-top:10px;padding:10px 12px;border:1px solid #BAAEC6;background:#FAF8FC\"><div style=\"display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap\"><b style=\"color:#261d3d\">BUYER PROFILE</b><span class=\"muted\">' + p.sessions + ' visit' + (p.sessions === 1 ? '' : 's') + ' \u00b7 ' + p.events + ' actions \u00b7 first ' + esc(p.first) + ' \u00b7 last ' + esc(p.last) + (p.visitors > 1 ? ' \u00b7 ' + p.visitors + ' devices' : '') + '</span></div>' +\n      (p.summary ? '<div style=\"margin-top:6px;font-size:13px\"><b>Looks for:</b> ' + esc(p.summary) + '</div>' : '') +\n      (p.carat || p.price ? '<div class=\"muted\" style=\"margin-top:4px\">' + (p.carat ? 'Opened stones from ' + p.carat.min.toFixed(2) + ' to ' + p.carat.max.toFixed(2) + ' ct (typically ' + p.carat.mid.toFixed(2) + ' ct)' : '') + (p.price ? (p.carat ? ' \u00b7 ' : '') + 'prices ' + $(p.price.min) + '\u2013' + $(p.price.max) + ' (typically ' + $(p.price.mid) + ')' : '') + '</div>' : '') +\n      (p.prefs.length ? '<div style=\"margin-top:6px\">' + p.prefs.map(function (f) { return '<div style=\"font-size:12px;margin:2px 0\"><span class=\"muted\" style=\"display:inline-block;min-width:110px\">' + esc(f.filter) + '</span>' + f.top.map(function (t) { return pill(t); }).join(' ') + '</div>'; }).join('') + '</div>' : '') +\n      (p.searches.length ? '<div style=\"font-size:12px;margin-top:4px\"><span class=\"muted\" style=\"display:inline-block;min-width:110px\">Searched</span>' + p.searches.map(function (t) { return pill('\u201c' + t[0] + '\u201d' + (t[1] > 1 ? ' \u00d7' + t[1] : '')); }).join(' ') + '</div>' : '') +\n      (p.viewed.length ? '<div style=\"font-size:12px;margin-top:4px\"><span class=\"muted\" style=\"display:inline-block;min-width:110px\">Opened</span>' + p.viewed.map(function (v) { return pill(v.label + (v.n > 1 ? ' \u00d7' + v.n : ''), v.inStock ? '' : '#B8860B'); }).join(' ') + '</div>' : '') +\n      (p.added.length ? '<div style=\"font-size:12px;margin-top:4px\"><span class=\"muted\" style=\"display:inline-block;min-width:110px\">Added to bag</span>' + p.added.map(function (v) { return pill(v.label, '#2E8B57'); }).join(' ') + (p.removed ? ' <span class=\"muted\">\u00b7 removed ' + p.removed + '</span>' : '') + '</div>' : '') +\n      '<div class=\"muted\" style=\"margin-top:6px;font-size:11px\">' + (p.tabs.length ? 'Tabs: ' + p.tabs.map(function (t) { return t[0]; }).join(', ') + ' \u00b7 ' : '') + 'Came from: ' + p.sources.map(function (t) { return t[0]; }).join(', ') + ' \u00b7 ' + p.devices.map(function (t) { return t[0]; }).join(', ') + (p.questions ? ' \u00b7 ' + p.questions + ' question' + (p.questions === 1 ? '' : 's') : '') + '</div></div>';\n  }\n  function loadBuyer(k, email, phone, visitor) { S.buyers = S.buyers || {}; S.buyers[k] = 'loading'; render(); post('admin_buyer', { email: email, phone: phone, visitor: visitor }).then(function (j) { S.buyers[k] = j.ok ? j : { found: false }; render(); }).catch(function () { S.buyers[k] = { found: false }; render(); }); }\n  function loadCustDir() { post('admin_customers', { act: 'list' }).then(function (j) { if (!j.ok || !S.custEdit) return; var e = S.custEdit; var live = function (id, k) { var el = root.querySelector('#' + id); if (el) e[k] = el.type === 'checkbox' ? el.checked : el.value; }; live('sjCErp', 'erp'); live('sjCCo', 'company'); live('sjCName', 'contact'); live('sjCEmail', 'email'); live('sjCPhone', 'phone'); live('sjCAlt', 'alt'); live('sjCProg', 'program'); live('sjCProgNo', 'programNo'); live('sjCOwner', 'owner'); live('sjCNotes', 'custNotes'); live('sjCKyc', 'kyc'); var d = j.customers.find(function (c) { return (e.email && c.email === String(e.email).toLowerCase()) || (e.phone && c.phone && c.phone.replace(/\\D/g, '').slice(-10) === String(e.phone).replace(/\\D/g, '').slice(-10)); }); if (d) { e.row = d.row; e.alt = d.alt; if (!e.erp) e.erp = d.erp; if (!e.program) e.program = d.program; if (!e.programNo) e.programNo = d.programNo; e.kyc = e.kyc || d.kyc; if (!e.owner) e.owner = d.owner; if (!e.custNotes) e.custNotes = d.notes; render(); } }).catch(function () {}); }\n  function loadCarts() { S.cartsBusy = true; post('admin_carts', { days: S.days }).then(function (j) { S.cartsBusy = false; if (j.ok) S.carts = j; if (S.tab === 'customers') render(); }).catch(function () { S.cartsBusy = false; }); }\n  function altsBlock(x) {\n    var A = (S.alts || {})[x.ref];\n    var h = '<div class=\"sjAlts\"><h2 style=\"margin-top:14px\">NOT IN STOCK? SEND THE CLOSEST MATCHES</h2><div class=\"muted\" style=\"margin-bottom:8px\">Don\u2019t just cancel. We search live inventory with the filters they used' + (x.filters ? ' (<b>' + esc(x.filters) + '</b>)' : '') + ' and the stones they picked, then draft the email for you.</div>';\n    if (!A) return h + '<button class=\"b pri\" type=\"button\" data-alts=\"' + esc(x.ref) + '\">FIND CLOSEST MATCHES</button></div>';\n    if (A === 'loading') return h + '<div class=\"muted\">Searching inventory\u2026</div></div>';\n    if (!A.ok) return h + '<div class=\"note err\">' + esc(A.error || 'Could not search.') + '</div></div>';\n    if (!A.list.length) return h + '<div class=\"muted\">Nothing close is in stock right now. Mark Not fulfilled and the email will say a specialist is pulling options by hand.</div><button class=\"b\" type=\"button\" data-altsend=\"' + esc(x.ref) + '\" style=\"margin-top:8px\">MARK NOT IN STOCK &amp; DRAFT EMAIL</button></div>';\n    return h + '<div style=\"display:grid;gap:6px\">' + A.list.map(function (o) { return '<label style=\"display:flex;gap:10px;align-items:flex-start;padding:8px 10px;border:1px solid #E3DDEA;cursor:pointer\"><input type=\"checkbox\" class=\"sjAltPick\" value=\"' + esc(o.id) + '\" checked style=\"margin-top:3px\"><span style=\"flex:1\"><b style=\"color:#261d3d\">' + esc(o.title) + '</b><br><span class=\"muted\">' + esc(o.sub || '') + '</span></span><b style=\"color:#261d3d\">' + esc(o.price || '') + '</b></label>'; }).join('') + '</div>' +\n      '<div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:8px\"><button class=\"b pri\" type=\"button\" data-altsend=\"' + esc(x.ref) + '\">MARK NOT IN STOCK &amp; DRAFT EMAIL WITH THESE</button><button class=\"b\" type=\"button\" data-alts=\"' + esc(x.ref) + '\">SEARCH AGAIN</button></div><div class=\"muted\" style=\"margin-top:6px\">The email goes to the Outbox for review (uses your memo above, if any). Untick any stone you don\u2019t want to offer.</div></div>';\n  }\n  var TPLN = { received: 'Request received (instant receipt)', confirmed: 'Order confirmed', in_progress: 'Order in progress', fulfilled: 'Order fulfilled', not_fulfilled: 'Not in stock \u00b7 closest matches', cancel: 'Order cancelled', available: 'Stone available again (to the buyer)', similar: 'Stone sold \u2014 similar options (to the buyer)', staff_alert: 'Team alert \u2014 buyers to follow up (to you)' };\n  function settingsView() {\n    var o = S.ops; if (!o) return '<div class=\"muted\">' + (S.opsBusy ? 'Loading\u2026' : 'Press REFRESH.') + '</div>';\n    var s = o.settings, h = S.opsMsg ? '<div class=\"note ' + (S.opsErr ? 'err' : 'ok') + '\">' + esc(S.opsMsg) + '</div>' : '';\n    var im = S.imp;\n    h += '<div class=\"grid\"><div class=\"card\" style=\"grid-column:1/-1\"><h2>OTHER PAGES \u2192 THIS ADMIN</h2><div class=\"muted\" style=\"margin-bottom:8px\">Your jewelry promo page (and any older page) writes to its own Google Sheet. Paste those sheet links here and their orders, visits and leads are copied into this admin automatically every 5 minutes \u2014 nothing is changed in the other sheets. Orders arrive as jewelry orders with the buyer\u2019s line items.</div>' +\n      '<form data-form=\"import\" style=\"display:grid;gap:8px\"><textarea class=\"in\" id=\"sjImpSheets\" rows=\"2\" style=\"height:auto;padding:8px\" placeholder=\"https://docs.google.com/spreadsheets/d/\u2026/edit  (one per line)\">' + esc(im ? im.sheets.map(function (x) { return 'https://docs.google.com/spreadsheets/d/' + x + '/edit'; }).join('\\n') : '') + '</textarea>' +\n      '<div style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:center\"><button class=\"b pri\" type=\"submit\" ' + (S.busy ? 'disabled' : '') + '>SAVE & IMPORT NOW</button><span class=\"muted\">' + (im && im.last && im.last.at ? 'Last import ' + esc(String(im.last.at).slice(0, 16).replace('T', ' ')) + ' \u00b7 ' + esc(im.last.summary || '') : (im ? 'Not imported yet.' : 'Loading\u2026')) + '</span></div></form></div>' +\n      '<div class=\"card\"><h2>AUTOMATION</h2><form data-form=\"opsset\" style=\"display:grid;gap:10px;font-size:13px\">' +\n      '<label><input type=\"checkbox\" id=\"sjSAutoHold\" ' + (s.autoHold ? 'checked' : '') + '> Hold in-stock stones the moment a customer requests them (until you release, cancel or fulfil)</label>' +\n      '<label>If the buyer goes quiet: draft \u201cstill interested?\u201d after <input class=\"in\" id=\"sjSNudge\" type=\"number\" min=\"1\" max=\"720\" value=\"' + (s.nudgeHours || 48) + '\" style=\"width:80px\"> hours, and a last call <input class=\"in\" id=\"sjSLast\" type=\"number\" min=\"1\" max=\"60\" value=\"' + (s.lastCallDays || 5) + '\" style=\"width:70px\"> days after that (drafts go to OUTBOX)</label>' +\n      '<label>Shipping fee shown on orders $<input class=\"in\" id=\"sjSShip\" type=\"number\" min=\"0\" value=\"' + (s.shippingFee == null ? 45 : s.shippingFee) + '\" style=\"width:90px\"> \u00b7 RJO members $<input class=\"in\" id=\"sjSRjo\" type=\"number\" min=\"0\" value=\"' + (s.rjoShippingFee == null ? '' : s.rjoShippingFee) + '\" placeholder=\"same\" style=\"width:90px\"></label>' +\n      '<input type=\"hidden\" id=\"sjSHoldH\" value=\"' + s.holdHours + '\">' +\n      '<label>Follow-up window: stop watching a wanted stone after <input class=\"in\" id=\"sjSFollow\" type=\"number\" min=\"1\" max=\"120\" value=\"' + s.followDays + '\" style=\"width:80px\"> days</label>' +\n      '<label><input type=\"checkbox\" id=\"sjSAutoSim\" ' + (s.autoSimilar ? 'checked' : '') + '> When a wanted stone sells, draft a \u201cclosest matches\u201d email for the buyer (no match = no draft)</label>' +\n      '<label><input type=\"checkbox\" id=\"sjSAlert\" ' + (s.autoStaffAlert ? 'checked' : '') + '> Email the team when a wanted stone becomes available again</label>' +\n      '<label>Max automatic drafts per day <input class=\"in\" id=\"sjSMax\" type=\"number\" min=\"0\" max=\"90\" value=\"' + s.autoMax + '\" style=\"width:80px\"></label>' +\n      '<label>Check OneDrive every <select id=\"sjSEvery\">' + [5, 10, 15, 30, 60].map(function (m) { return '<option value=\"' + m + '\" ' + (Number(s.syncEveryMin) === m ? 'selected' : '') + '>' + m + ' min</option>'; }).join('') + '</select> <span class=\"muted\">(the workbook refreshes every 15 min; faster only helps if that changes)</span></label>' +\n      '<label>Team alert email <input class=\"in\" id=\"sjSAlertTo\" value=\"' + esc(s.alertTo) + '\" style=\"width:100%\"></label>' +\n      '<label>Customer emails reply to <input class=\"in\" id=\"sjSReply\" value=\"' + esc(s.replyTo) + '\" style=\"width:100%\"></label>' +\n      '<label>Salespeople (sales-only logins) see <select id=\"sjSScope\"><option value=\"all\" ' + (s.salesScope !== 'assigned' ? 'selected' : '') + '>every order, inquiry and follow-up</option><option value=\"assigned\" ' + (s.salesScope === 'assigned' ? 'selected' : '') + '>only orders assigned to them + their clients (Rep on the account)</option></select></label>' +\n      '<label>Accounts-team address (trade references, applications, KYC, sign-in codes) <input class=\"in\" id=\"sjSAcct\" value=\"' + esc(s.accountsEmail || 'account@thesparklingjewelry.com') + '\" style=\"width:100%\"></label>' +\n      '<label>Phone shown in emails <input class=\"in\" id=\"sjSPhone\" value=\"' + esc(s.companyPhone) + '\" style=\"width:100%\"></label>' +\n      '<label>Live page link used in emails <input class=\"in\" id=\"sjSUrl\" value=\"' + esc(s.pageUrl) + '\" placeholder=\"https://\u2026netlify.app\" style=\"width:100%\"></label>' +\n      '<button class=\"b pri\" type=\"submit\">SAVE SETTINGS</button></form></div>';\n    if (S.role === 'owner') h += '<div class=\"card\"><h2>MAILCHIMP</h2><div class=\"muted\" style=\"margin-bottom:8px\">Lets the page recognise visitors who arrive from your Mailchimp campaigns (even if they never fill in the form) and lets you push page customers into your audience. Mailchimp \u2192 Account \u2192 Extras \u2192 API keys \u2192 create a key.</div><form data-form=\"mailchimp\" style=\"display:grid;gap:8px\"><input class=\"in\" id=\"sjMcKey\" type=\"password\" autocomplete=\"off\" placeholder=\"' + (s.mcSet ? 'API key saved \u2014 paste a new one to replace' : 'API key, e.g. 0123\u2026abcd-us21') + '\" style=\"width:100%\"><div style=\"display:flex;gap:6px;flex-wrap:wrap\"><input class=\"in\" id=\"sjMcList\" value=\"' + esc(s.mcList) + '\" placeholder=\"Audience ID (or press TEST and pick)\" style=\"flex:1;min-width:160px\"><input class=\"in\" id=\"sjMcListName\" value=\"' + esc(s.mcListName) + '\" placeholder=\"Audience name\" style=\"flex:1;min-width:140px\"></div>' + (S.mcLists && S.mcLists.length ? '<select id=\"sjMcPick\">' + S.mcLists.map(function (l) { return '<option value=\"' + esc(l.id) + '|' + esc(l.name) + '\">' + esc(l.name) + ' (' + l.members + ')</option>'; }).join('') + '</select>' : '') + '<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"b pri\" type=\"submit\">SAVE</button><button class=\"b\" type=\"button\" data-a=\"mctest\">TEST CONNECTION</button><button class=\"b\" type=\"button\" data-a=\"mcsync\" data-on=\"' + (s.mcSync === false ? '1' : '0') + '\">' + (s.mcSync === false ? 'SYNC IS PAUSED \u00b7 TURN ON' : 'WEBSITE \u2192 AUDIENCE SYNC: ON') + '</button><button class=\"b\" type=\"button\" data-a=\"mcbackfill\"' + (s.mcSet && s.mcList ? '' : ' disabled') + '>SYNC ALL EXISTING ACCOUNTS NOW</button></div><div class=\"muted\">With the key and an audience set, every new website login is added to the audience automatically (status <b>subscribed</b> only if they ticked the offers box, otherwise <b>transactional</b> \u2014 never inferred), tagged Signed up / KYC submitted / Approved / Buying group. Customers can opt out from their Profile and Mailchimp follows.</div><div class=\"muted\">Campaign links must keep Mailchimp\u2019s standard <code>?mc_cid=\u2026&amp;mc_eid=\u2026</code> parameters (they are added automatically when you link to the page from a campaign).</div></form></div>';\n    { var TABS = [['Client accounts', 'One row per login: email, name, company, role, verified, consent, saved searches', 'accounts'], ['Companies', 'One row per company: domain, owner, approval, RJO #/status, purchasing rules', 'companies'], ['Signups', 'Every signup with source, UTM, device, path (for the insights view)', 'signups'], ['Orders', 'Every order request incl. who placed it and the company', 'orders'], ['Info requests', '\u201cA quick update needed\u201d tasks and their answers/files', 'requests'], ['User activity', 'Searches, views, bag changes, orders per signed-in user', 'activity'], ['KYC applications', 'Scrubbed applications (no SSN / bank / signature \u2014 those stay in Jotform)', 'kyc'], ['References', 'Trade references and their answers', 'refs'], ['Account log', 'The per-account timeline', 'alog'], ['RJO members', 'Every member row ever imported from an RJO export', 'rjo'], ['EmailLog \u00b7 Outbox', 'Every email sent, skipped or waiting', 'emails']];\n      h += '<div class=\"card\"><h2>WHERE THE DATA LIVES</h2><div class=\"muted\" style=\"margin-bottom:8px\">Everything is in the Google Sheet behind this admin \u2014 open it any time, filter, pivot, share a tab, or download a tab here as CSV. Secrets (passwords, API keys) are never in the sheet.</div><div class=\"tw\"><table><thead><tr><th>TAB</th><th>WHAT\u2019S IN IT</th><th></th></tr></thead><tbody>' + TABS.map(function (x) { return '<tr><td><b>' + esc(x[0]) + '</b></td><td class=\"muted\">' + esc(x[1]) + '</td><td><button class=\"b\" data-export=\"' + x[2] + '\">CSV</button></td></tr>'; }).join('') + '</tbody></table></div>' + (S.status && S.status.sheetUrl ? '<div style=\"margin-top:8px\"><a class=\"b\" href=\"' + esc(S.status.sheetUrl) + '\" target=\"_blank\" rel=\"noopener\">OPEN THE GOOGLE SHEET</a></div>' : '') + '</div>'; }\n    { var J = S.jobs; h += '<div class=\"card\"><div style=\"display:flex;gap:8px;align-items:center;flex-wrap:wrap\"><h2 style=\"margin:0;flex:1\">SCHEDULED JOBS & FAILURES</h2><button class=\"b\" data-a=\"jobs\">' + (J ? 'REFRESH' : 'SHOW') + '</button></div>' + (J ? '<div class=\"grid\" style=\"margin-top:10px\"><div><h2>RUNS ON ITS OWN</h2>' + (J.jobs.length ? J.jobs.map(function (x) { return '<div class=\"row\"><div class=\"lb\">' + esc(x.label) + ' <span class=\"muted\">' + esc(x.fn) + '</span></div><div class=\"n\">' + esc(x.type) + '</div></div>'; }).join('') : '<div class=\"muted\">No triggers installed \u2014 run installSyncTrigger and installV13Triggers once in Apps Script.</div>') + '<div class=\"muted\" style=\"margin-top:6px\">Gmail sends left today: ' + esc(J.mailLeft == null ? '?' : J.mailLeft) + '</div></div><div><h2>RECENT FAILURES</h2>' + (J.failures.length || J.emailsFailed.length ? (J.failures.map(function (x) { return '<div class=\"row\"><div class=\"lb\">' + esc(x.at) + ' \u00b7 ' + esc(x.what) + ' ' + esc(x.target) + '<div class=\"muted\">' + esc(x.detail) + '</div></div></div>'; }).join('') + J.emailsFailed.map(function (x) { return '<div class=\"row\"><div class=\"lb\">' + esc(x.at) + ' \u00b7 email ' + esc(x.kind) + ' \u2192 ' + esc(x.to) + '<div class=\"muted\">' + esc(x.result) + '</div></div></div>'; }).join('')) : '<div class=\"muted\">Nothing failed recently.</div>') + '</div></div>' : '') + '</div>'; }\n    h += '<div class=\"card\"><h2>SEND A TEST EMAIL</h2><div class=\"muted\" style=\"margin-bottom:8px\">Emails are sent from your Google account (the one that owns the script), with reply-to set above.</div><form data-form=\"testmail\" style=\"display:grid;gap:8px\"><select id=\"sjTKind\">' + Object.keys(TPLN).map(function (k) { return '<option value=\"' + k + '\">' + TPLN[k] + '</option>'; }).join('') + '</select><input class=\"in\" id=\"sjTTo\" placeholder=\"your@email.com\"><button class=\"b\" type=\"submit\">SEND TEST</button></form>' +\n      (S.role === 'owner' ? '<h2 style=\"margin-top:20px\">SPARKLING INTELLIGENCE \u00b7 API KEY</h2><div class=\"muted\" style=\"margin-bottom:8px\">Lets your other app read orders, customers, follow-ups, emails, holds and insights (read-only). POST to the script URL with <code>{\"type\":\"api_export\",\"key\":\"\u2026\",\"what\":\"all\"}</code>.' + (S.apiStatus ? (S.apiStatus.hasKey ? ' <b style=\"color:#2E8B57\">A key is active</b> (made by ' + esc(S.apiStatus.meta.by) + ').' : ' No key yet.') : '') + '</div>' + (S.apiKey ? '<div class=\"note ok\">Copy it now \u2014 it won\u2019t be shown again:<div class=\"code\" style=\"font-size:13px;letter-spacing:1px;word-break:break-all\">' + esc(S.apiKey) + '</div></div>' : '') + '<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"b\" data-a=\"apikey\">CREATE / REPLACE KEY</button>' + (S.apiStatus && S.apiStatus.hasKey ? '<button class=\"b danger\" data-a=\"apioff\">REVOKE</button>' : '') + '</div>' : '') + '</div>';\n    if (S.role === 'owner') h += '<div class=\"card\" style=\"grid-column:1/-1\"><h2>POSTHOG (OPTIONAL \u00b7 ON TOP OF THE SHEET TRACKING)</h2><form data-form=\"posthog\" style=\"display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))\">' +\n      '<label style=\"font-size:12px\">Project API key (phc_\u2026)<input class=\"in\" id=\"sjPhTok\" value=\"' + esc(s.phToken) + '\" style=\"width:100%\" placeholder=\"phc_xxxxxxxx\"></label>' +\n      '<label style=\"font-size:12px\">Host<input class=\"in\" id=\"sjPhHost\" value=\"' + esc(s.phHost) + '\" style=\"width:100%\" placeholder=\"https://us.i.posthog.com\"></label>' +\n      '<label style=\"font-size:12px\">Project ID (number in your PostHog URL)<input class=\"in\" id=\"sjPhPid\" value=\"' + esc(s.phProjectId) + '\" style=\"width:100%\" placeholder=\"12345\"></label>' +\n      '<label style=\"font-size:12px\">Personal API key (read \u00b7 Query) ' + (s.phApiSet ? '<span class=\"pill\" style=\"border-color:#2E8B57;color:#2E8B57\">SAVED</span>' : '') + '<input class=\"in\" id=\"sjPhKey\" type=\"password\" autocomplete=\"off\" style=\"width:100%\" placeholder=\"' + (s.phApiSet ? 'leave blank to keep the saved key' : 'phx_\u2026') + '\"></label>' +\n      '<label style=\"font-size:12px;grid-column:1/-1\">Dashboard share link (optional, to embed it here)<input class=\"in\" id=\"sjPhDash\" value=\"' + esc(s.phDashboard) + '\" style=\"width:100%\" placeholder=\"https://us.posthog.com/shared/\u2026\"></label>' +\n      '<div style=\"grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap\"><button class=\"b pri\" type=\"submit\">SAVE POSTHOG</button>' + (s.phApiSet ? '<button class=\"b\" type=\"button\" data-a=\"phkeyoff\">REMOVE PERSONAL KEY</button>' : '') + '</div>' +\n      '<div class=\"muted\" style=\"grid-column:1/-1\">The project key is public (it goes on the page). The personal key is stored only in the script, never sent to the browser. Session replay / heatmaps: turn them on inside PostHog \u2192 Settings \u2192 Replay.</div></form></div>';\n    h += '</div>';\n    return h;\n  }\n  function popView() {\n    var p = S.pop; if (!p) return '<div class=\"muted\">' + (S.popBusy ? 'Loading\u2026' : 'Press REFRESH.') + '</div>';\n    var h = (S.opsMsg ? '<div class=\"note ' + (S.opsErr ? 'err' : 'ok') + '\">' + esc(S.opsMsg) + '</div>' : '') + '<div class=\"grid\"><div class=\"card\" style=\"grid-column:1/-1\"><h2>SMART SUGGESTIONS \u00b7 \u201cPOPULAR RIGHT NOW\u201d CHIPS ON THE PAGE</h2><div class=\"muted\" style=\"margin-bottom:10px\">The page shows up to 6 one-tap searches above the results. Automatic = the filter combinations real buyers use most (last 45 days, only ones that return stones, at least ' + p.min + ' different sessions). Pinned = your own list. Changes show on the page within an hour. <b>Currently paused on the page</b> unless Automatic or Pinned is chosen here \u2014 buyer data keeps collecting either way.</div>' +\n      '<form data-form=\"pop\" style=\"display:grid;gap:8px\"><div style=\"display:flex;gap:14px;flex-wrap:wrap;font-size:13px\">' + [['auto', 'Automatic (from buyer behaviour)'], ['pinned', 'Pinned (my list below)'], ['off', 'Off']].map(function (m) { return '<label><input type=\"radio\" name=\"sjPopMode\" value=\"' + m[0] + '\" ' + (p.mode === m[0] ? 'checked' : '') + '> ' + m[1] + '</label>'; }).join('') + '</div>' +\n      '<div class=\"muted\">Pinned searches, one per line, in the page\u2019s filter format \u2014 e.g. <code>shapes=round | size=1.00\u20131.49 | color=F,G</code>. Copy one from the automatic list, or build it: shapes, size, color, clarity, cut, pol, sym, fl, growth, hue, fint, plus ranges w / pr / ppc / L / W / ratio / depth / table as min-max (e.g. <code>w=1-1.5</code>).</div>' +\n      '<textarea class=\"in\" id=\"sjPins\" rows=\"6\" style=\"height:auto;padding:8px;font-family:ui-monospace,monospace;font-size:12px\">' + esc(p.pins.map(function (x) { return x.qs; }).join('\\n')) + '</textarea><button class=\"b pri\" type=\"submit\">SAVE</button></form></div>' +\n      '<div class=\"card\" style=\"grid-column:1/-1\"><h2>WHAT THE AUTOMATIC LIST WOULD SHOW</h2>' + (p.auto.length ? '<div class=\"tw\"><table><tr><th>SEARCH</th><th>SESSIONS</th><th>FILTER FORMAT</th></tr>' + p.auto.map(function (x) { return '<tr><td>' + esc(x.label) + '</td><td>' + x.n + '</td><td><code style=\"font-size:11px\">' + esc(x.qs) + '</code></td></tr>'; }).join('') + '</table></div>' : '<div class=\"muted\">Not enough buyer activity yet (needs the same filter combo in ' + p.min + '+ sessions).</div>') + '</div></div>';\n    return h;\n  }\n  function posthogView() {\n    var p = S.ph, h = '';\n    if (!p) return '<div class=\"muted\">' + (S.phBusy ? 'Loading PostHog\u2026' : 'Press REFRESH.') + '</div>';\n    if (!p.configured) return '<div class=\"card\"><h2>POSTHOG \u00b7 NOT CONNECTED YET</h2><div class=\"muted\" style=\"line-height:1.7\">PostHog adds session replays, heatmaps and funnels on top of the Google Sheet tracking. To turn it on:<br>1. In PostHog: <b>Settings \u2192 Project \u2192 Project API key</b> (starts with <code>phc_</code>) and note your region host (US: <code>https://us.i.posthog.com</code>, EU: <code>https://eu.i.posthog.com</code>).<br>2. Here: <b>Emails &amp; Settings \u2192 PostHog</b>, paste the key and host, save. The live page starts sending to PostHog within an hour \u2014 no re-upload needed.<br>3. Optional, to see PostHog numbers in this panel: add the <b>Project ID</b> (the number in your PostHog URL) and a <b>personal API key</b> (Settings \u2192 Personal API keys, read access to Query). Optional: a dashboard <b>share link</b> to embed it here.</div></div>';\n    h += '<div class=\"card\" style=\"margin-bottom:16px\"><div style=\"display:flex;gap:10px;flex-wrap:wrap;align-items:center\"><span class=\"pill\" style=\"border-color:#2E8B57;color:#2E8B57\">TRACKING ON</span><span class=\"muted\">The page sends pageviews plus every filter, search, stone and order event to PostHog (staff visits excluded).</span><span class=\"sp\"></span><a class=\"b\" style=\"display:flex;align-items:center;text-decoration:none\" href=\"' + esc(p.host) + '\" target=\"_blank\" rel=\"noopener\">OPEN POSTHOG</a></div></div>';\n    if (p.error) h += '<div class=\"note err\">PostHog numbers: ' + esc(p.error) + '</div>';\n    if (p.apiReady && !p.error) {\n      h += '<div class=\"kpis\"><div class=\"kpi\"><div class=\"v\">' + N(p.people) + '</div><div class=\"l\">PEOPLE (DISTINCT)</div></div><div class=\"kpi\"><div class=\"v\">' + N(p.pageviews) + '</div><div class=\"l\">PAGEVIEWS</div></div><div class=\"kpi\"><div class=\"v\">' + N(p.events) + '</div><div class=\"l\">EVENTS</div></div></div>';\n      h += '<div class=\"grid\"><div class=\"card\" style=\"grid-column:1/-1\"><h2>PAGEVIEWS PER DAY \u00b7 POSTHOG</h2>' + (p.daily.length ? cols(p.daily.map(function (d) { return d[1]; }), p.daily.map(function (d) { return d[0]; }), Math.ceil(p.daily.length / 10)) : '<div class=\"muted\">No pageviews yet.</div>') + '</div>';\n      h += '<div class=\"card\"><h2>TOP EVENTS (PEOPLE)</h2>' + bars(p.top.map(function (t) { return [t[0], t[2], t[1] + ' total']; })) + '</div><div class=\"card\"><h2>DEVICES</h2>' + bars(p.devices) + '</div><div class=\"card\"><h2>WHERE VISITORS CAME FROM</h2>' + bars(p.referrers) + '</div></div>';\n    } else if (!p.apiReady) h += '<div class=\"note\">To see PostHog numbers here, add the Project ID + a personal API key in Emails &amp; Settings \u2192 PostHog. Session replays and heatmaps are viewed in PostHog itself (OPEN POSTHOG).</div>';\n    if (p.dashboard) h += '<div class=\"card\" style=\"margin-top:16px\"><h2>YOUR POSTHOG DASHBOARD</h2><iframe class=\"ph\" src=\"' + esc(p.dashboard.replace('/shared/', '/embedded/')) + '\" allowfullscreen></iframe></div>';\n    return h;\n  }\n  function loadPH() { if (!has('reports')) return; S.phBusy = true; post('admin_posthog', { days: S.days }).then(function (j) { S.phBusy = false; if (j.ok) S.ph = j; else S.msg = j.error; if (S.tab === 'posthog') render(); }).catch(function () { S.phBusy = false; }); }\n  function loadPop() { S.popBusy = true; post('admin_popular').then(function (j) { S.popBusy = false; if (j.ok) S.pop = j; if (S.tab === 'insights' && S.sub === 'pop') render(); }).catch(function () { S.popBusy = false; }); }\n  /* ---------- INVENTORY \u00b7 value fixes + gemstones ---------- */\n  var FLD = { shape: 'Shape code', color: 'Color', clarity: 'Clarity', lab: 'Lab', cut: 'Cut', pol: 'Polish', sym: 'Symmetry', fl: 'Fluorescence', loc: 'Location', growth: 'Growth', fcol: 'Fancy color', fint: 'Fancy intensity', gtype: 'Gemstone type', gshape: 'Gemstone shape' };\n  function loadMaps() { if (!has('reports')) return; S.mapsBusy = true; post('admin_maps').then(function (j) { S.mapsBusy = false; if (j.ok) S.maps = j; if (S.tab === 'inventory') render(); }).catch(function () { S.mapsBusy = false; }); }\n  function mapsCard() {\n    var m = S.maps; var y = S.sync;\n    var h = '<div class=\"card\" style=\"grid-column:1/-1\"><h2>VALUE FIXES \u00b7 TELL THE PAGE WHAT THE SHEET MEANS</h2>';\n    if (y && y.issues && y.issues.length) h += '<div class=\"note err\"><b>Needs your clarification (' + y.issues.length + '):</b><br>' + y.issues.map(esc).join('<br>') + '</div>';\n    if (!m) return h + '<div class=\"muted\">' + (S.mapsBusy ? 'Loading\u2026' : 'Press REFRESH.') + '</div></div>';\n    var groups = m.groups; var shapes = m.values.shape || [];\n    h += '<div class=\"muted\" style=\"margin-bottom:10px\">Example: the sheet says <b>CUSQ</b> and the page files it under \u201cOther\u201d \u2014 pick the shape group it belongs to and the name buyers should see. Applies to every stone on the next sync (a sync runs as soon as you save).</div>';\n    h += '<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:16px\">';\n    h += '<div><h2>SHAPE CODES IN THE SHEET</h2><div class=\"tw\"><table><tr><th>CODE</th><th>STONES</th><th>SHOWN AS</th><th>GROUP (FILTER)</th><th>DISPLAY NAME</th><th></th></tr>' + shapes.map(function (sv) { var c = sv[0], ov = m.maps.shapes[c] || {}; return '<tr><td><b style=\"color:#261d3d\">' + esc(c) + '</b></td><td>' + N(sv[1]) + '<