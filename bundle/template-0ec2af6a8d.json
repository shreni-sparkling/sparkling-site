lick any shape, color, clarity or size group and the sheet updates instantly. Remove a filter with its \u00d7, or use Hide filters to give the list more room \u2014 the Filters button at the top brings them back while you scroll.','filter','The sheet now shows only matching diamonds.'],\\n\" +\n    \" ['tour-heads','Arrange the columns your way','Drag any column header by its \u22ee\u22ee and drop it where you want it. Try moving Total price next to Carat.','move','Moved. Your layout is saved for your next visit.'],\\n\" +\n    \" ['tour-cols','Show only the details you need','Click Columns, then tick or untick measurements, depth, table and more.','cols','Updated. Show all or Reset brings everything back.'],\\n\" +\n    \" ['tour-gemtab','Gemstones too','Need lab-grown rubies, sapphires or emeralds? They live on the Gemstones tab. Diamonds and gemstones go into the same bag and one request.','',''],\\n\" +\n    \" ['order','Add stones and send your request','Tick the box on any row to add it to your bag. In-stock stones are requested right away; on-hold stones go in as availability inquiries and we follow up when they free up. Send by WhatsApp or email \u2014 you get a request number to come back and edit anytime.','last','']];\\n\" +\n    \"const TOUR_M=[\\n\" +\n    \" [null,'Find and request diamonds in minutes','Live IGI-certified lab-grown inventory, refreshed every 15 minutes. Filter, pick and send a request by WhatsApp or email.',''],\\n\" +\n    \" ['m-filters','Filter your way','Tap Filters to pick shape, carat, color, clarity, price and more. The count updates as you choose; tap Show to see the list.','',''],\\n\" +\n    \" ['results','Tap a diamond for details','Tap any row for its IGI report, video and full specs. Tick its box to add it to your bag.','',''],\\n\" +\n    \" ['tour-gemtab','Gemstones too','Lab-grown rubies, sapphires and emeralds are on the Gemstones tab. Everything goes into one bag and one request.','',''],\\n\" +\n    \" ['order','Send your request','Your stones collect here with the estimated total. In-stock stones are requested; on-hold stones become inquiries we follow up on. Send by WhatsApp or email and keep your request number to edit later.','last','']];\";\n  function hash(str) { var h = 5381; for (var i = 0; i < str.length; i++) h = ((h << 5) + h + str.charCodeAt(i)) | 0; return (h >>> 0).toString(36); }\n  var JEWTAB = '<a id=\"tour-jewtab\" href=\"jewelry.html\" style=\"display:flex;align-items:center;min-height:44px;padding:0 18px;font-size:12px;font-weight:700;letter-spacing:2px;color:#3B5255;text-decoration:none;border-bottom:3px solid transparent\" style-hover=\"color:var(--sj-teal-900)\">JEWELRY</a>';\n  function steps(api, adminJs, uxJs, pageJs, VERSION) {\n    var CONST = \"/* ===== SPARKLING ADMIN ADD-ON (re-applied by the patcher on every new design version) ===== */\\n\" +\n      \"const ADMIN_API='\" + api + \"';\\n\" +\n      \"const HAS_API=/^https:\\\\/\\\\/script\\\\.google\\\\.com\\\\/macros\\\\/s\\\\/[^/]+\\\\/exec$/.test(ADMIN_API);window.__SJ_ADMIN_API=HAS_API?ADMIN_API:'';\\n\" +\n      \"const TOUR_V='__TOURV__';\\n\" +\n      /* the export's loader sometimes skips the add-on <script> tags (race with the design runtime) \u2192 run any that didn't start */\n      \"(function(){var boot=function(){[['sj-admin-src','__sjAdminLoaded'],['sj-page-src','__sjPage'],['sj-ux-src','__sjUX'],['sj-patcher-src','SparklingPatcher']].forEach(function(p){try{if(window[p[1]])return;var el=document.getElementById(p[0]);if(!el||!el.textContent)return;var s=document.createElement('script');s.textContent=el.textContent;(document.body||document.documentElement).appendChild(s);s.remove();}catch(e){}});};[600,2000,5000].forEach(function(ms){setTimeout(boot,ms);});})();\\n\" +\n      \"try{const vk='sj_diamond_order_view',vr=localStorage.getItem(vk);if(vr){const vo=JSON.parse(vr);if(vo&&vo.hide&&vo.hide.ppc&&!vo.ppc2){delete vo.hide.ppc;vo.ppc2=1;localStorage.setItem(vk,JSON.stringify(vo));}}}catch(e){}\\n\" +\n      \"const MIRROR=body=>{if(!LEGACY_ENDPOINT||LEGACY_ENDPOINT===ADMIN_API)return;try{if(localStorage.getItem('sj_staff'))return;}catch(e){}try{fetch(LEGACY_ENDPOINT,{method:'POST',mode:'no-cors',keepalive:body.length<60000,headers:{'Content-Type':'text/plain;charset=utf-8'},body}).catch(()=>{});}catch(e){}};\\n\" +\n      \"const QS=q=>{const o=[];try{Object.keys(FIELD).forEach(k=>{if(q[k]&&q[k].length)o.push(k+'='+q[k].join(','));});RK.forEach(k=>{const r=q[k];if(r&&(r.min||r.max))o.push(k+'='+(r.min||'')+'-'+(r.max||''));});}catch(e){}if(q.text&&q.text.trim())o.push('text='+q.text.trim().replace(/[|=]/g,' '));if(q.video)o.push('video=yes');if(q.avail&&q.avail!=='all')o.push('avail='+q.avail);return o.join(' | ');};\\n\";\n    var FETCHINV = \"fetchInv(){const local=()=>fetch(__LOCAL__).then(r=>r.json());if(Array.isArray(window.__sjOverride)){this.setState({invUpd:'Admin preview (not live)'});return Promise.resolve(window.__sjOverride);}if(!HAS_API)return local();\\n\" +\n      \"    if(this._lateRows){const r=this._lateRows;this._lateRows=null;return Promise.resolve(r);}\\n\" +\n      \"    const list=(new URLSearchParams(location.search).get('list'))||(function(){try{return localStorage.getItem('sj_list')||''}catch(e){return ''}})();\\n\" +\n      \"    const accept=j=>{if(j&&j.ok&&Array.isArray(j.rows)&&j.rows.length){window.__sjFeed=j;this._invV=j.version||0;try{if(j.codes)Object.assign(CODE,j.codes);if(j.names)Object.assign(CODENAME,j.names);}catch(e){}this.setState({invUpd:j.updatedLabel||''});return j.rows;}throw new Error('empty');};\\n\" +\n      \"    /* 1) data/inventory.json on this site (gzipped by the CDN, fast) \u2192 2) the Google Script \u2192 3) the built-in list. A copy is kept in the browser cache so repeat visits paint instantly. */\\n\" +\n      \"    const liveApi=()=>fetch(ADMIN_API+'?action=inventory&list='+encodeURIComponent(list)+'&t='+Date.now()).then(r=>r.json());\\n\" +\n      \"    const dataFile=()=>list?Promise.reject(new Error('list')):fetch('data/inventory.json?t='+Date.now(),{cache:'no-cache'}).then(r=>{if(!r.ok)throw new Error('no data file');return r.json();}).then(j=>{if(!j||!j.ok||!j.rows||!j.rows.length)throw new Error('empty data file');return j;});\\n\" +\n      \"    const fresh=dataFile().catch(liveApi).then(j=>{try{if(window.caches&&j&&j.ok)caches.open('sj-feed').then(c=>c.put('/sj-inv-'+(list||'default'),new Response(JSON.stringify(j),{headers:{'Content-Type':'application/json'}}))).catch(()=>{});}catch(e){}return j;});\\n\" +\n      \"    const cached=(window.caches?caches.open('sj-feed').then(c=>c.match('/sj-inv-'+(list||'default'))).then(r=>r?r.json():null):Promise.resolve(null)).catch(()=>null);\\n\" +\n      \"    return cached.then(cj=>{\\n\" +\n      \"      if(cj&&cj.rows&&cj.rows.length){fresh.then(j=>{if(j&&j.version&&j.version!==cj.version){this._lateRows=accept(j);this.load(true);}}).catch(()=>{});return accept(cj);}\\n\" +\n      \"      return Promise.race([fresh.then(accept),new Promise(r=>setTimeout(()=>r(null),2500))]).then(rows=>{if(rows)return rows;fresh.then(j=>{this._lateRows=accept(j);this.load(true);}).catch(()=>{});return local();}).catch(local);\\n\" +\n      \"    });}\\n\" +\n      \"  watchInv(){if(!HAS_API||this._wi)return;this._wi=setInterval(()=>{if(document.hidden||Array.isArray(window.__sjOverride))return;fetch(ADMIN_API+'?action=version&t='+Date.now()).then(r=>r.json()).then(j=>{if(j&&j.ok&&j.version&&this._invV&&j.version!==this._invV)this.load(true);}).catch(()=>{});},180000);}\\n  \";\n    var RESULTS = \"ps=ps||this._ps||{};this._ps=s;if(this._qRef!==s.q&&s.all){this._qRef=s.q;clearTimeout(this._rq);this._rq=setTimeout(()=>{try{const qs=QS(this.state.q);if(!qs||qs===this._lastQS)return;this._lastQS=qs;this.ev('results',{value:String(this.compute().res.length),detail:qs});}catch(e){}},1800);}\";\n    var BTN = '<button id=\"sj-admin-btn\" type=\"button\" title=\"Admin login\" style=\"height:28px;padding:0 10px;border:1px solid #C9CDD2;border-radius:0;background:#FFFFFF;color:#5B6770;font-size:9px;font-weight:700;letter-spacing:1.8px;cursor:pointer;display:flex;align-items:center;gap:6px\"><svg width=\"10\" height=\"11\" viewBox=\"0 0 10 11\" fill=\"none\" aria-hidden=\"true\"><rect x=\"1\" y=\"4.5\" width=\"8\" height=\"6\" stroke=\"currentColor\"/><path d=\"M3 4.5V3a2 2 0 0 1 4 0v1.5\" stroke=\"currentColor\"/></svg>ADMIN</button>';\n    return [\n      { id: 'constants', core: true, label: 'Connect to the Google Script', re: /const ENDPOINT='([^']*)';/, fn: function (m, old) { return CONST + \"const LEGACY_ENDPOINT='\" + old + \"';const ENDPOINT=HAS_API?ADMIN_API:LEGACY_ENDPOINT;\"; },\n        fallback: /<script type=\"text\\/x-dc\"[^>]*>\\n?/, fbfn: function (m) { return m + CONST + \"const LEGACY_ENDPOINT='';const ENDPOINT=ADMIN_API;\"; } },\n      { id: 'tourCopy', core: false, only: 'split', label: 'Guided tour copy (mentions gemstones, holds, WhatsApp/email)', re: /const TOUR=\\[[\\s\\S]*?\\];\\s*const TOUR_M=\\[[\\s\\S]*?\\]\\];/, fn: function () { return TOUR; } },\n      { id: 'tourAuto', core: false, label: 'Tour opens automatically for new visitors (and again when the tour changes)', re: /seen=!!localStorage\\.getItem\\('sj_tour_done'\\)/, fn: function () { return \"seen=localStorage.getItem('sj_tour_done')===TOUR_V\"; } },\n      { id: 'tourAuto2', core: false, label: 'Tour completion remembers the tour version', re: /localStorage\\.setItem\\('sj_tour_done','1'\\)/, fn: function () { return \"localStorage.setItem('sj_tour_done',TOUR_V)\"; }, needs: 'tourAuto' },\n      { id: 'teamLogin', core: false, label: '\u201cTeam login\u201d links open the Admin panel', re: /href=\"\\{\\{ adminUrl \\}\\}\"/, all: true, fn: function () { return 'href=\"#admin\" data-sj-admin=\"1\"'; } },\n      { id: 'channel', core: false, label: 'Record whether a request was sent by WhatsApp or email (+ membership & delivery choices)', re: /const body=\\{type:isUpdate\\?'update':'order',/, fn: function (m) { return m + \"channel:ch==='wa'?'WhatsApp':'Email',extra:(window.__sjExtra?window.__sjExtra():{}),\"; } },\n      { id: 'ppcDefault', core: false, label: 'Price per carat shows by default (before Total price)', re: /const HIDE_T=\\{L:1,W:1,H:1,depth:1,table:1,growth:1,id:1,ppc:1,/, fn: function () { return \"const HIDE_T={L:1,W:1,H:1,depth:1,table:1,growth:1,id:1,\"; } },\n      { id: 'ppcKeep', core: false, label: 'Price per carat is the last column to auto-hide on narrow screens', re: /const DROP=\\['video','ppc','growth','report','table','depth','ratio','fl','sym','pol','H','W','L','cut'\\];/, fn: function () { return \"const DROP=['video','growth','report','table','depth','ratio','fl','sym','pol','H','W','L','cut','ppc'];\"; } },\n      { id: 'gemTab', core: false, only: 'split', label: 'Gemstones tab points at gemstones.html', re: /href=\"Gemstone Order Page\\.dc\\.html\"/, fn: function () { return 'href=\"gemstones.html\"'; } },\n      { id: 'jewelryTab', core: false, only: 'split', label: 'Third tab: JEWELRY (studs & tennis bracelet offers)', re: /GEMSTONES<\\/a><\\/nav>/, fn: function () { return 'GEMSTONES</a>' + JEWTAB + '</nav>'; } },\n      { id: 'liveInventory', core: true, label: 'Live inventory from the Google Script (with built-in fallback)',\n        re: /load\\(\\)\\{this\\.setState\\(\\{all:null,err:false\\}\\);fetch\\((RES\\('diamonds'\\)\\|\\|'data\\/diamonds\\.json'|AR\\('data\\/diamonds\\.json'\\))\\)\\.then\\(r=>r\\.json\\(\\)\\)\\.then\\(a=>\\{/,\n        fn: function (m, local) { return FETCHINV.replace('__LOCAL__', local) + \"load(soft){if(!soft)this.setState({all:null,err:false});this.watchInv();this.fetchInv().then(a=>{\"; } },\n      { id: 'softReloadErrors', core: false, label: 'Quiet background refresh', re: /\\}\\)\\.catch\\(\\(\\)=>this\\.setState\\(\\{err:true\\}\\)\\);\\}/, fn: function () { return \"}).catch(()=>{if(!soft)this.setState({err:true});});}\"; } },\n      { id: 'rowGuard', core: false, label: 'Skip malformed inventory rows', re: /const all=a\\.map\\(r=>\\{/, fn: function () { return \"const all=a.filter(r=>Array.isArray(r)&&r[1]).map(r=>{\"; } },\n      { id: 'stockSince', core: false, label: 'Featured sort: date each stone has been in stock (from the Google Script)', re: /gm:r\\[22\\]\\|\\|'UNK',/, fn: function (m) { return m + 'since:+r[30]||0,pop:+r[31]||0,imp:+r[32]||0,'; } },\n      { id: 'sortDefault', core: false, label: 'Default sort is FEATURED (most looked-at + in-stock pieces being tested)', re: /sort:'price\\|1'/, fn: function () { return \"sort:'feat|1'\"; } },\n      { id: 'sortKeys', core: false, label: 'Sort choices: Featured \u00b7 Carat \u00b7 Price \u00b7 Price/ct \u00b7 Color \u00b7 Clarity', re: /const SORTK=\\[\\[.*?\\]\\];/, fn: function () { return \"const SORTK=[['feat','Featured','longest in stock first',''],['wt','Carat','largest first','smallest first',-1],['price','Price','lowest first','highest first'],['ppc','Price/ct','lowest first','highest first'],['color','Color','D first','D last'],['clar','Clarity','highest first','lowest first']];\"; } },\n      { id: 'sortOptsList', core: false, label: 'Phone sort menu: each field in both directions, Featured once', re: /SORTK\\.forEach\\(\\(\\[k,t,a,b\\]\\)=>\\{sortOpts\\.push\\(\\{v:k\\+'\\|1',t:t\\+' \u2191 \u00b7 '\\+a\\}\\);sortOpts\\.push\\(\\{v:k\\+'\\|-1',t:t\\+' \u2193 \u00b7 '\\+b\\}\\);\\}\\);/, fn: function () { return \"SORTK.forEach(([k,t,a,b,i])=>{if(k==='feat'){sortOpts.push({v:'feat|1',t:'Featured \u00b7 longest in stock first'});return;}const d1=i===-1?'-1':'1',d2=i===-1?'1':'-1';sortOpts.push({v:k+'|'+d1,t:t+(d1==='-1'?' \u2193 \u00b7 ':' \u2191 \u00b7 ')+a});sortOpts.push({v:k+'|'+d2,t:t+(d2==='-1'?' \u2193 \u00b7 ':' \u2191 \u00b7 ')+b});});\"; }, needs: 'sortKeys' },\n      { id: 'sortShortFeat', core: false, label: 'Phone sort label shows FEATURED without an arrow', re: /const sortShort=\\(sk1\\?sk1\\[1\\]:/, fn: function () { return \"const sortShort=sk0[0]==='feat'?'