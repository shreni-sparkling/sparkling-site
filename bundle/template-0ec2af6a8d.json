put type=\"tel\" value=\"{{ phone }}\" sc-camel-on-change=\"{{ setPhone }}\" placeholder=\"(555) 555-5555\" style=\"height:46px;padding:0 12px;border:{{ phoneBd }};border-radius:0;color:var(--sj-teal-900);font-size:15px\"><sc-if value=\"{{ phoneErr }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"font-size:12px;font-weight:600;color:var(--sj-error)\">Enter a phone number with at least 10 digits.</span></sc-if></label>\n<label style=\"grid-column:1 / -1;display:flex;flex-direction:column;gap:6px\"><span style=\"font-size:10px;font-weight:600;letter-spacing:1.8px;color:#3B5255\">ORDER NOTES <span style=\"font-weight:400;letter-spacing:0;color:var(--sj-grey-500)\">(optional)</span></span><textarea value=\"{{ notes }}\" sc-camel-on-change=\"{{ setNotes }}\" rows=\"1\" placeholder=\"Memo or invoice, matching pairs, setting plans, delivery timing\" style=\"padding:10px 12px;min-height:44px;border:1px solid #C3CFCC;border-radius:0;color:var(--sj-teal-900);font-size:15px;line-height:22px;resize:vertical\"></textarea></label>\n</div><sc-if value=\"{{ pickErr }}\" hint-placeholder-val=\"{{ false }}\"><p style=\"margin:0 0 12px;font-size:13px;font-weight:600;color:var(--sj-error)\">Add at least one stone to your order.</p></sc-if>\n<div style=\"display:flex;flex-direction:column;gap:6px\"><span style=\"font-size:var(--fs-label);font-weight:600;letter-spacing:var(--ls-label);color:var(--st-muted)\">{{ sendHead }}</span><a href=\"{{ waLink }}\" sc-camel-on-click=\"{{ submitWaLink }}\" target=\"_blank\" rel=\"noopener\" style=\"display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--sj-teal-100);border:1px solid var(--sj-teal-200);color:var(--sj-teal-900);font-size:12.5px;line-height:1.35;text-decoration:none\"><span style=\"flex:0 0 auto;font-size:10px;font-weight:800;letter-spacing:1.5px;color:#FFFFFF;background:var(--sj-teal-800);padding:3px 6px\">FASTEST</span><span>WhatsApp gets the quickest reply. <b style=\"color:var(--sj-purple-900);text-decoration:underline;text-underline-offset:2px\">Send this request on WhatsApp to {{ waLbl }} \u2197</b></span></a><div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(min(150px,100%),1fr));gap:6px\"><button sc-camel-on-click=\"{{ submitEmail }}\" disabled=\"{{ sending }}\" style=\"min-height:40px;display:flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:0;background:var(--sj-purple-900);color:#FFFFFF;font-size:11px;font-weight:700;letter-spacing:1.4px;cursor:pointer\" style-hover=\"background:#3A2049\"><svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\"></rect><path d=\"M3 7l9 6 9-6\"></path></svg>EMAIL</button><button sc-camel-on-click=\"{{ submitWa }}\" disabled=\"{{ sending }}\" style=\"min-height:40px;display:flex;align-items:center;justify-content:center;gap:8px;border:2px solid var(--sj-purple-900);border-radius:0;background:#FFFFFF;color:var(--sj-purple-900);font-size:11px;font-weight:700;letter-spacing:1.4px;cursor:pointer\" style-hover=\"background:#F3EEF7\"><svg width=\"18\" height=\"18\" sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3.5 20l1.2-4.2A8.5 8.5 0 1 1 20.5 11.5z\"></path><path d=\"M9 9.5c.3 1.8 1.7 3.6 3.6 4.5l1.2-1 1.7.8-.4 1.6c-3.4.2-6.6-3-6.6-6.4l1.6-.4.8 1.7z\"></path></svg>WHATSAPP</button><button sc-camel-on-click=\"{{ submitSite }}\" disabled=\"{{ sending }}\" style=\"min-height:40px;display:flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:0;background:#3A2049;color:#FFFFFF;font-size:11px;font-weight:800;letter-spacing:1.6px;cursor:pointer\" style-hover=\"background:#604173\"><svg width=\"18\" height=\"18\" sc-camel-view-box=\