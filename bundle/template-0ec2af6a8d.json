.woff\") format(\"woff\");\n  font-weight: 700; font-style: normal; font-display: swap;\n}\n\n/* Brittany Signature \u2014 the real brand cursive accent face.\n   Use for collection names ONLY (never body, never pricing, never CTAs). */\n@font-face {\n  font-family: \"Brittany Signature\";\n  src: url(\"12cbc737-2fbe-40a2-aeda-e83067853d0e\") format(\"truetype\");\n  font-weight: 400; font-style: normal; font-display: swap;\n}\n\n:root {\n  /* ---------- Brand colors (cool-toned, NO gold/warm) -------------- */\n  /* Deep teals \u2014 primary brand voice */\n  --sj-teal-900:    #2F4243;   /* deepest, headlines on light */\n  --sj-teal-800:    #465E62;   /* primary brand teal \u2014 buttons, footer accents */\n  --sj-teal-700:    #5D7F83;   /* hover/secondary */\n  --sj-teal-500:    #7E9E9D;   /* mid-teal, dividers, captions */\n\n  /* Bright/light teal \u2014 modern secondary */\n  --sj-teal-200:    #DAEBEB;   /* backgrounds, soft chips */\n  --sj-teal-100:    #F0F9F9;   /* surface tint */\n\n  /* Royal purple \u2014 heritage/luxury anchor (footer, accents) */\n  --sj-purple-900:  #604073;   /* footer, deep brand panel */\n  --sj-purple-700:  #6F4D85;\n  --sj-purple-200:  #917DA0;   /* lavender mid */\n  --sj-lavender:    #DCD0E8;   /* lavender wash */\n\n  /* Cream + neutrals */\n  --sj-cream:       #F8F8F8;   /* default page background */\n  --sj-white:       #FFFFFF;\n  --sj-charcoal:    #434345;   /* body text */\n  --sj-ink:         #000000;\n\n  /* Greys */\n  --sj-grey-500:    #8C8E90;\n  --sj-grey-300:    #A8A9AC;\n  --sj-grey-200:    #E4E5E6;\n  --sj-grey-100:    #F0F0F0;\n\n  /* Sage \u2014 Classic Collection ONLY */\n  --sj-sage:        #B7C9B0;\n  --sj-sage-deep:   #7E9387;\n\n  /* Status (sparingly) */\n  --sj-error:       #B8526D;   /* berry, not red */\n  --sj-success:     #5D7F83;   /* tealed success */\n  --sj-info:        #5470A8;\n\n  /* ---------- Semantic ------------------------------------------- */\n  --bg:             var(--sj-cream);\n  --bg-alt:         var(--sj-white);\n  --bg-tint:        var(--sj-teal-100);\n  --bg-deep:        var(--sj-purple-900);\n\n  --fg:             var(--sj-charcoal);\n  --fg-strong:      var(--sj-teal-900);\n  --fg-muted:       var(--sj-teal-700);\n  --fg-faint:       var(--sj-grey-500);\n  --fg-on-deep:     var(--sj-cream);\n\n  --brand:          var(--sj-teal-800);\n  --brand-hover:    var(--sj-teal-700);\n  --brand-deep:     var(--sj-purple-900);\n\n  --line:           var(--sj-grey-200);\n  --line-strong:    var(--sj-teal-800);\n\n  /* ---------- Type scale ----------------------------------------- */\n  --font-display:   \"Open Sauce Sans\", \"Inter\", system-ui, sans-serif;\n  --font-body:      \"Open Sauce Sans\", \"Inter\", system-ui, sans-serif;\n  --font-script:    \"Brittany Signature\", \"Allura\", cursive;\n\n  /* Sizes \u2014 large display for trade-show / hero, scales down for UI */\n  --fs-hero:        clamp(48px, 6vw, 96px);  /* @kind font */\n  --fs-display:     40px;\n  --fs-h1:          24px;\n  --fs-h2:          20px;\n  --fs-h3:          18px;\n  --fs-h4:          16px;\n  --fs-body:        14px;\n  --fs-small:       12px;\n  --fs-micro:       10px;\n\n  --lh-tight:       1.0;  /* @kind font */\n  --lh-snug:        1.15;  /* @kind font */\n  --lh-body:        1.45;  /* @kind font */\n  --lh-loose:       1.6;  /* @kind font */\n\n  /* Letter-spacing \u2014 set in stone for headlines (uppercase, tight) */\n  --ls-tight:       -0.01em;\n  --ls-normal:      0;  /* @kind font */\n  --ls-wide:        0.06em;   /* uppercase nav, eyebrows */\n  --ls-widest:      0.18em;   /* spec chips, micro labels */\n\n  /* ---------- Spacing -------------------------------------------- */\n  --sp-1: 4px;  --sp-2: 8px;  --sp-3: 12px; --sp-4: 16px;\n  --sp-5: 20px; --sp-6: 24px; --sp-8: 32px; --sp-10: 40px;\n  --sp-12: 48px; --sp-16: 64px; --sp-20: 80px;\n  --page-margin: 75px;            /* desktop page gutter */\n  --page-margin-mobile: 20px;\n\n  /* ---------- Radii ---------------------------------------------- */\n  --r-xs: 4px;\n  --r-sm: 8px;\n  --r-md: 12px;       /* inputs, secondary chips */\n  --r-lg: 15px;       /* primary buttons */\n  --r-xl: 20px;\n  --r-pill: 999px;\n\n  /* ---------- Shadows -------------------------------------------- */\n  --shadow-card:    0 1px 2px rgba(47,66,67,0.06), 0 4px 16px rgba(47,66,67,0.06);\n  --shadow-pop:     0 8px 32px rgba(47,66,67,0.14);\n  --shadow-deep:    0 20px 60px rgba(96,65,115,0.25);\n\n  /* ---------- Motion --------------------------------------------- */\n  --ease-out:       cubic-bezier(.2,.8,.2,1);  /* @kind other */\n  --ease-in-out:    cubic-bezier(.4,0,.2,1);  /* @kind other */\n  --t-fast:         140ms;  /* @kind other */\n  --t-base:         220ms;  /* @kind other */\n  --t-slow:         420ms;  /* @kind other */\n}\n\n/* ---------- Element defaults --------------------------------------- */\nhtml, body {\n  font-family: var(--font-body);\n  font-size:   var(--fs-body);\n  line-height: var(--lh-body);\n  color:       var(--fg);\n  background:  var(--bg);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\n\nh1, .h1 {\n  font-family: var(--font-display);\n  font-size:   var(--fs-display);\n  font-weight: 700;\n  line-height: var(--lh-tight);\n  letter-spacing: var(--ls-tight);\n  color: var(--fg-strong);\n  text-transform: uppercase;\n}\n\nh2, .h2 {\n  font-family: var(--font-display);\n  font-size:   var(--fs-h1);\n  font-weight: 600;\n  line-height: var(--lh-snug);\n  letter-spacing: var(--ls-tight);\n  color: var(--fg-strong);\n}\n\nh3, .h3 {\n  font-family: var(--font-display);\n  font-size:   var(--fs-h2);\n  font-weight: 600;\n  line-height: var(--lh-snug);\n  color: var(--fg-strong);\n}\n\nh4, .h4 {\n  font-family: var(--font-display);\n  font-size:   var(--fs-h3);\n  font-weight: 600;\n  line-height: var(--lh-snug);\n  color: var(--fg-strong);\n}\n\np, .body {\n  font-size: var(--fs-body);\n  line-height: var(--lh-body);\n  color: var(--fg);\n}\n\n.eyebrow {\n  font-size: var(--fs-micro);\n  text-transform: uppercase;\n  letter-spacing: var(--ls-widest);\n  color: var(--fg-muted);\n  font-weight: 600;\n}\n\n.script {\n  font-family: var(--font-script);\n  font-weight: 400;\n  letter-spacing: 0;\n  text-transform: none;\n}\n\n.spec-chip {\n  display: inline-flex;\n  gap: 8px;\n  font-size: var(--fs-micro);\n  letter-spacing: var(--ls-widest);\n  text-transform: uppercase;\n  color: var(--fg-muted);\n  font-weight: 600;\n}\n.spec-chip > span + span::before {\n  content: \"/\";\n  margin-right: 8px;\n  color: var(--sj-grey-300);\n}\n</style>\n<style>/* Sparkling Jewelry \u2014 design system entry stylesheet.\n   Consumers link this one file. */\n/* =====================================================================\n   Sparkling Jewelry \u2014 Colors & Type Tokens\n   B2B wholesale lab-grown diamonds. Cool-toned, elevated, price-confident.\n   ===================================================================== */\n\n/* ---------- Fonts (Open Sauce + Brittany Signature) ---------------- */\n/* Open Sauce: display + body. Brittany Signature: cursive accent for\n   collection names ONLY. Salvager + EuroSans + Albert Sans are RETIRED. */\n\n@font-face {\n  font-family: \"Open Sauce Sans\";\n  src: url(\"https://fonts.cdnfonts.com/s/85181/OpenSauceSans-Regular.woff\") format(\"woff\");\n  font-weight: 400; font-style: normal; font-display: swap;\n}\n@font-face {\n  font-family: \"Open Sauce Sans\";\n  src: url(\"https://fonts.cdnfonts.com/s/85181/OpenSauceSans-Medium.woff\") format(\"woff\");\n  font-weight: 500; font-style: normal; font-display: swap;\n}\n@font-face {\n  font-family: \"Open Sauce Sans\";\n  src: url(\"https://fonts.cdnfonts.com/s/85181/OpenSauceSans-SemiBold.woff\") format(\"woff\");\n  font-weight: 600; font-style: normal; font-display: swap;\n}\n@font-face {\n  font-family: \"Open Sauce Sans\";\n  src: url(\"https://fonts.cdnfonts.com/s/85181/OpenSauceSans-Bold.woff\") fo