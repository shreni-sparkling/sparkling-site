h:90px\"> % <span class=\"muted\">(+10 = everything 10% higher than the sheet; 0 = sheet prices)</span></label>' +\n      '<label>Who sees prices <select id=\"sjPm\"><option value=\"show\" ' + (p.priceMode === 'show' ? 'selected' : '') + '>Everyone</option><option value=\"hide\" ' + (p.priceMode === 'hide' ? 'selected' : '') + '>Only people with a price-list link (others see \u201cprices on request\u201d)</option></select></label>' +\n      '<button class=\"b pri\" type=\"submit\">SAVE</button></form>' +\n      '<h2 style=\"margin-top:18px\">PRICE-LIST LINKS</h2><div class=\"muted\" style=\"margin-bottom:8px\">Each link shows the page with its own adjustment, e.g. a VIP list at +0% or a trade-show list at +8%. Send the link; the browser remembers it.</div><form data-form=\"plist\" style=\"display:flex;gap:6px;flex-wrap:wrap\"><input class=\"in\" id=\"sjPlLabel\" placeholder=\"Label (e.g. JIS show)\" style=\"flex:1;min-width:120px\"><input class=\"in\" id=\"sjPlCode\" placeholder=\"code (optional)\" style=\"width:130px\"><input class=\"in\" id=\"sjPlPct\" type=\"number\" step=\"0.5\" placeholder=\"% adj.\" style=\"width:90px\"><button class=\"b\" type=\"submit\">CREATE LINK</button></form>' +\n      (p.lists.length ? '<table style=\"margin-top:8px\">' + p.lists.map(function (l) { return '<tr><td><b style=\"color:#261d3d\">' + esc(l.label || l.code) + '</b><br><span class=\"muted\">' + (l.markupPct >= 0 ? '+' : '') + l.markupPct + '%</span></td><td><input class=\"in\" readonly value=\"' + esc(l.url || ('?list=' + l.code)) + '\" style=\"width:100%;font-size:11px\"></td><td><button class=\"b\" data-pldel=\"' + esc(l.code) + '\">REMOVE</button></td></tr>'; }).join('') + '</table>' : '') + '</div>';\n    h += '<div class=\"card\"><h2>ONE-OFF PRICE OVERRIDES</h2><div class=\"muted\" style=\"margin-bottom:8px\">Set a specific price for a specific stone (wins over the sheet price and the % adjustment).</div><form data-form=\"override\" style=\"display:flex;gap:6px;flex-wrap:wrap\"><input class=\"in\" id=\"sjOvId\" placeholder=\"Stock #\" style=\"width:150px\"><input class=\"in\" id=\"sjOvP\" type=\"number\" step=\"0.01\" placeholder=\"Price $ (blank = remove)\" style=\"width:170px\"><button class=\"b pri\" type=\"submit\">SET</button>' + (p.overrides.length ? '<button class=\"b\" type=\"button\" data-a=\"ovclear\">CLEAR ALL</button>' : '') + '</form>' +\n      (p.overrides.length ? '<div class=\"tw\" style=\"margin-top:8px\"><table><tr><th>STOCK #</th><th>SHEET</th><th>NOW</th><th></th></tr>' + p.overrides.map(function (x) { return '<tr><td><b style=\"color:#261d3d\">' + esc(x.id) + '</b>' + (x.known ? '' : ' <span style=\"color:#C8554F\">not in inventory</span>') + '</td><td>' + (x.base != null ? $(x.base) : '\u2014') + '</td><td><b>' + $(x.price) + '</b></td><td><button class=\"b\" data-ovdel=\"' + esc(x.id) + '\">REMOVE</button></td></tr>'; }).join('') + '</table></div>' : '<div class=\"muted\" style=\"margin-top:8px\">None.</div>') + '</div>';\n    h += '<div class=\"card\" style=\"grid-column:1/-1\"><h2>BUYING GROUPS (RJO \u00b7 NIJA \u00b7 \u2026)</h2><div class=\"muted\" style=\"margin-bottom:8px\">Buyers pick their group in the order form and enter their member number. The order shows the member quote; you VERIFY it on the order (Orders \u2192 open \u2192 Membership) and the discount is confirmed. Promoted / sale stones never get the member discount. Memo terms are not offered on the site.</div>' +\n      '<form data-form=\"programs\"><div class=\"tw\"><table id=\"sjProgT\"><tr><th>CODE</th><th>LABEL SHOWN</th><th>% OFF LOOSE</th><th>EXTRA % OVER $</th><th>EXTRA % OVER $</th><th>SHIPPING $</th><th>NOTE</th><th></th></tr>' + Object.keys(s.programs || {}).map(function (k) { var pr = s.programs[k]; var t1 = (pr.tiers || [])[0] || ['', ''], t2 = (pr.tiers || [])[1] || ['', '']; return '<tr data-prog=\"' + esc(k) + '\"><td><b style=\"color:#261d3d\">' + esc(k) + '</b></td><td><input class=\"in\" data-pf=\"label\" value=\"' + esc(pr.label) + '\" style=\"width:140px\"></td><td><input class=\"in\" data-pf=\"pct\" type=\"number\" step=\"0.5\" value=\"' + pr.pct + '\" style=\"width:70px\"></td><td><input class=\"in\" data-pf=\"t1a\" type=\"number\" value=\"' + esc(t1[0]) + '\" placeholder=\"10000\" style=\"width:90px\"> \u2192 <input class=\"in\" data-pf=\"t1p\" type=\"number\" step=\"0.25\" value=\"' + esc(t1[1]) + '\" placeholder=\"0.5\" style=\"width:60px\">%</td><td><input class=\"in\" data-pf=\"t2a\" type=\"number\" value=\"' + esc(t2[0]) + '\" placeholder=\"50000\" style=\"width:90px\"> \u2192 <input class=\"in\" data-pf=\"t2p\" type=\"number\" step=\"0.25\" value=\"' + esc(t2[1]) + '\" placeholder=\"1\" style=\"width:60px\">%</td><td><input class=\"in\" data-pf=\"shipping\" type=\"number\" value=\"' + (pr.shipping == null ? '' : pr.shipping) + '\" placeholder=\"' + (s.shippingFee == null ? 45 : s.shippingFee) + '\" style=\"width:70px\"></td><td><input class=\"in\" data-pf=\"note\" value=\"' + esc(pr.note || '') + '\" style=\"width:160px\"></td><td><button class=\"b\" type=\"button\" data-progdel=\"' + esc(k) + '\">REMOVE</button></td></tr>'; }).join('') + '</table></div>' +\n      '<div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;align-items:center\"><input class=\"in\" id=\"sjProgNew\" placeholder=\"New code (e.g. NIJA)\" style=\"width:160px\"><button class=\"b\" type=\"button\" data-a=\"progadd\">ADD GROUP</button><span class=\"sp\"></span><label style=\"font-size:12px\"><input type=\"checkbox\" id=\"sjPickup\" ' + (s.pickup ? 'checked' : '') + '> Offer free pick-up at the LA office</label><button class=\"b pri\" type=\"submit\">SAVE GROUPS</button></div></form></div>';\n    h += '<div class=\"card\" style=\"grid-column:1/-1\"><h2>BUNDLE DEALS \u00b7 N STONES FOR ONE PRICE</h2><div class=\"muted\" style=\"margin-bottom:8px\">Every stone in a bundle gets a \u201cBUNDLE \u00b7 name \u00b7 N stones for $X\u201d button on the page; one tap adds all of them to the buyer\u2019s bag with a note. If a stone sells on its own the bundle shows as PARTIAL until you edit it.</div>' +\n      '<form data-form=\"bundle\" style=\"display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))\"><input type=\"hidden\" id=\"sjBId\"><input class=\"in\" id=\"sjBName\" placeholder=\"Bundle name (e.g. JIS show lot A)\"><input class=\"in\" id=\"sjBTotal\" type=\"number\" step=\"1\" placeholder=\"Total price $\"><input class=\"in\" id=\"sjBNote\" placeholder=\"Note shown to buyers (optional)\"><textarea class=\"in\" id=\"sjBIds\" rows=\"2\" style=\"grid-column:1/-1;height:auto;padding:8px\" placeholder=\"Stock numbers, comma or line separated\"></textarea><div style=\"grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap\"><button class=\"b pri\" type=\"submit\">SAVE BUNDLE</button><button class=\"b\" type=\"button\" data-a=\"bclear\">CLEAR FORM</button></div></form>' +\n      (b.length ? '<div class=\"tw\" style=\"margin-top:12px\"><table><tr><th>BUNDLE</th><th>STONES</th><th>LIST VALUE</th><th>BUNDLE PRICE</th><th>STATUS</th><th></th></tr>' + b.map(function (x) { return '<tr><td><b style=\"color:#261d3d\">' + esc(x.name) + '</b><br><span class=\"muted\">' + esc(x.note) + '</span></td><td>' + x.stones.map(function (st) { return '<span class=\"pill\" style=\"margin:1px;' + (st.inStock ? '' : 'border-color:#C8554F;color:#C8554F') + '\" title=\"' + esc(st.label) + '\">' + esc(st.id) + '</span>'; }).join(' ') + '</td><td>' + $(x.listSum) + '</td><td><b>' + $(x.total) + '</b><br><span class=\"muted\">' + (x.listSum ? Math.round((1 - x.total / x.listSum) * 100) + '% off list' : '') + '</span></td><td>' + (x.active ? (x.missing ? '<span style=\"color:#C8554F\">PARTIAL \u00b7 ' + x.missing + ' not available</span>' : '<span style=\"color:#2E8B57\">LIVE</span>') : '<span class=\"muted\">OFF</span>') + '</td><td style=\"white-space:nowrap\"><button class=\"b\" data-bedit=\"' + esc(x.id) + '\">EDIT</button> <button class=\"b\" data-btoggle=\"' + esc(x.id) + '\">' + (x.active ? 'TURN OFF' : 'TURN ON') + '</button> <button class=\"b danger\" data-bdel=\"' + esc(x.id) + '\">DELETE</button></td></tr>'; }).join('') + '</table></div>' : '<div class=\"muted\" style=\"margin-top:8px\">No bundles yet.</div>') + '</div>';\n    h += jewelryCard();\n    h += '</div>';\n    return h;\n  }\n  function jewelryCard() {\n    var j = S.jewelry; if (!j) return '<div class=\"card\" style=\"grid-column:1/-1\"><h2>JEWELRY OFFERS</h2><div class=\"muted\">Loading\u2026</div></div>';\n    var N = j.names || { studs: 'Stud earrings \u00b7 per pair', bracelet: '7\u2033 tennis bracelets (14K gold)' };\n    var row = function (p, x) { return '<tr data-jrow=\"' + p + '|' + x.ctw + '\"' + (x.soldOut ? ' style=\"background:#F3F3F3\"' : '') + '><td><b style=\"color:#261d3d\">' + x.ctw + ' ct</b></td><td class=\"muted\">' + $(x.defPrice) + (x.defVol ? ' \u00b7 ' + $(x.defVol) + ' at 10+' : '') + '</td><td><input class=\"in\" data-jf=\"price\" type=\"number\" step=\"1\" value=\"' + x.price + '\" style=\"width:88px\" aria-label=\"' + x.ctw + ' ct price\"></td><td>' + (p === 'studs' ? '<input class=\"in\" data-jf=\"vol\" type=\"number\" step=\"1\" value=\"' + (x.vol || '') + '\" placeholder=\"\u2014\" style=\"width:84px\" aria-label=\"' + x.ctw + ' ct 10+ price\">' : '<span class=\"muted\">\u2014</span>') + '</td>' +\n      '<td><label style=\"display:inline-flex;gap:6px;align-items:center;font-size:12px;white-space:nowrap\"><input type=\"checkbox\" data-jf=\"so\"' + (x.soldOut ? ' checked' : '') + '> Sold out</label></td>' +\n      '<td>' + (x.soldOut ? '<span class=\"pill\" style=\"border-color:#6b6380;color:#6b6380\">SOLD OUT</span> ' : '') + (x.sale ? '<span class=\"pill\" style=\"border-color:#B8526D;color:#B8526D\">SALE \u00b7 was ' + $(x.defPrice) + '</span>' : x.custom ? '<span class=\"pill\">CUSTOM</span>' : (x.soldOut ? '' : '<span class=\"muted\">default</span>')) + '</td><td style=\"white-space:nowrap\"><button class=\"b\" type=\"button\" data-jsave=\"' + p + '|' + x.ctw + '\">SAVE</button>' + (x.custom || x.soldOut ? ' <button class=\"b\" type=\"button\" data-jreset=\"' + p + '|' + x.ctw + '\">RESET</button>' : '') + '</td></tr>'; };\n    var block = function (p) { if (!j.table[p]) return ''; return '<div><h2 style=\"font-size:11px\">' + esc(String(N[p] || p).toUpperCase()) + '</h2><div class=\"tw\"><table><tr><th>SIZE</th><th>DEFAULT</th><th>PRICE</th><th>' + (p === 'studs' ? '10+ PAIRS' : '') + '</th><th></th><th></th><th></th></tr>' + j.table[p].map(function (x) { return row(p, x); }).join('') + '</table></div></div>'; };\n    return '<div class=\"card\" style=\"grid-column:1/-1\"><h2>JEWELRY OFFERS \u00b7 GOLD & SILVER</h2><div class=\"muted\" style=\"margin-bottom:8px\">Set prices on the Jewelry Offers tab. Lower a price and the page shows the old price struck through with a SALE tag. Tick <b>Sold out</b> and that size shows a SOLD OUT band and can\u2019t be picked. The 10+ price is what a buyer pays per pair from 10 pairs of that size. Member discounts never apply to jewelry offers.</div>' +\n      '<div style=\"display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr))\">' + ['studs', 'bracelet', 'sbr', 'snk', 'dbty'].map(block).join('') + '</div>' +\n      '<div style=\"margin-top:10px\"><button class=\"b\" type=\"button\" data-a=\"jreset\" ' + (S.busy ? 'disabled' : '') + '>RESET ALL TO DEFAULT PRICES</button></div></div>';\n  }\n  /* ---------- page designs: new Claude Design export \u2192 patched here in the browser \u2192 saved + published ---------- */\n  function srcOf(id) { var el = document.getElementById(id); return el ? el.textContent : ''; }\n  function pagesView() {\n    var p = S.pages, b = S.pageBuild; var h = S.opsMsg ? '<div class=\"note ' + (S.opsErr ? 'err' : 'ok') + '\">' + esc(S.opsMsg) + '</div>' : '';\n    h += '<div class=\"grid\">';\n    h += '<div class=\"card\"><h2>UPLOAD A NEW DESIGN</h2><div class=\"muted\" style=\"margin-bottom:8px\">Export the page from Claude Design (standalone HTML) and drop it here. The Admin panel, live inventory, tracking and ordering hooks are added automatically \u2014 nothing in the Google Sheet is touched, so orders, customers and insights are never lost.</div>' +\n      (b ? '<div class=\"note ' + (b.ok ? 'ok' : 'err') + '\">' + esc(b.ok ? b.name + ' \u00b7 ready (' + b.kind + ' page, ' + Math.round(b.html.length / 1024) + ' KB)' : 'Could not prepare this file: ' + b.error) + '</div><div style=\"font-size:12px;line-height:1.7;max-height:260px;overflow:auto;border:1px solid #E6E1EC;padding:8px 10px;margin:8px 0\">' + b.report.map(function (x) { return '<div style=\"color:' + (x.ok ? '#2E8B57' : (x.core ? '#C8554F' : '#B8860B')) + '\">' + (x.ok ? '\u2713' : '\u2717') + ' ' + esc(x.label) + (x.note ? ' <span class=\"muted\">\u2014 ' + esc(x.note) + '</span>' : '') + '</div>'; }).join('') + '</div>' +\n        (b.ok ? '<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button class=\"b pri\" type=\"button\" data-a=\"pagesave\" ' + (S.busy ? 'disabled' : '') + '>SAVE AS ' + esc(b.name).toUpperCase() + '</button><button class=\"b\" type=\"button\" data-a=\"pagedl\">DOWNLOAD FILE</button><button class=\"b\" type=\"button\" data-a=\"pageclear\">DISCARD</button></div>' : '<button class=\"b\" type=\"button\" data-a=\"pageclear\">TRY ANOTHER FILE</button>') :\n        '<label class=\"drop\" id=\"sjPageDrop\"><b>Drop the Claude Design export here</b><span class=\"muted\">or click to choose the .html file. Diamonds (v7 with all three tabs), the gemstone page or the jewelry page \u2014 it recognises which one it is.</span><input type=\"file\" accept=\".html,text/html\" id=\"sjPageFile\" style=\"display:none\"></label>') + '</div>';\n    h += '<div class=\"card\"><h2>SITE FILES & PUBLISH</h2>' + (!p ? '<div class=\"muted\">Loading\u2026</div>' :\n      '<div class=\"muted\" style=\"margin-bottom:8px\">These are the files that make up the live site. Publishing sends them to Netlify in one step.' + (p.netlify.lastDeploy ? ' Last published ' + esc(String(p.netlify.lastDeploy.when).slice(0, 16).replace('T', ' ')) + ' by ' + esc(p.netlify.lastDeploy.by) + '.' : '') + '</div>' +\n      (p.files.length ? '<table>' + p.files.map(function (f) { return '<tr><td><b style=\"color:#261d3d\">' + esc(f.name) + '</b><br><span class=\"muted\">' + Math.round(f.size / 1024) + ' KB \u00b7 ' + esc(f.updated) + '</span></td><td style=\"text-align:right;white-space:nowrap\"><button class=\"b\" type=\"button\" data-pagedl2=\"' + esc(f.name) + '\">DOWNLOAD</button> <button class=\"b danger\" type=\"button\" data-pagedel=\"' + esc(f.name) + '\">REMOVE</button></td></tr>'; }).join('') + '</table>' : '<div class=\"muted\">No files saved yet. Upload a design on the left.</div>') +\n      '<div style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;align-items:center\"><button class=\"b pri\" type=\"button\" data-a=\"pagepub\" ' + (S.busy || !p.files.length || !p.netlify.tokenSet || !p.netlify.site ? 'disabled' : '') + '>PUBLISH TO ' + esc((p.netlify.site || 'NETLIFY').toUpperCase()) + '</button>' + (p.netlify.tokenSet && p.netlify.site ? '' : '<span class=\"muted\">Add the Netlify site + token below to publish from here; until then, download and drag the file onto Netlify.</span>') + ' <a class=\"muted\" href=\"' + esc(p.folderUrl) + '\" target=\"_blank\" rel=\"noopener\">Open the Drive folder \u2197</a></div>' +\n      (S.role === 'owner' ? '<h2 style=\"margin-top:16px\">NETLIFY</h2><form data-form=\"netlify\" style=\"display:grid;gap:8px;max-width:420px\"><label style=\"font-size:12px\">Site name<input class=\"in\" id=\"sjNfSite\" placeholder=\"sparklingdiamond.netlify.app\" value=\"' + esc(p.netlify.site || '') + '\"></label><label style=\"font-size:12px\">Personal access token ' + (p.netlify.tokenSet ? '<span class=\"pill\" style=\"border-color:#2E8B57;color:#2E8B57\">SAVED</span>' : '') + '<input class=\"in\" id=\"sjNfTok\" type=\"password\" placeholder=\"' + (p.netlify.tokenSet ? '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022 (leave blank to keep)' : 'nfp_\u2026') + '\"></label><div class=\"muted\">Netlify \u2192 your avatar \u2192 User settings \u2192 Applications \u2192 Personal access tokens \u2192 New access token. It is stored only in the Script Properties.</div><div style=\"display:flex;gap:8px\"><button class=\"b pri\" type=\"submit\">SAVE</button><button class=\"b\" type=\"button\" data-a=\"nftest\">TEST CONNECTION</button></div></form>' : '')) + '</div>';\n    h += '<div class=\"card\" style=\"grid-column:1/-1\"><h2>VERSION HISTORY</h2><div class=\"muted\" style=\"margin-bottom:8px\">Every save keeps the previous file. Roll back restores it to the site files (then press PUBLISH).</div>' + (p && p.history.length ? '<div class=\"tw\"><table><tr><th>WHEN</th><th>FILE</th><th>SIZE</th><th></th></tr>' + p.history.map(function (f) { return '<tr><td>' + esc(f.when) + '</td><td>' + esc(f.name) + '</td><td>' + Math.round(f.size / 1024) + ' KB</td><td><button class=\"b\" type=\"button\" data-pageroll=\"' + esc(f.id) + '\">ROLL BACK</button></td></tr>'; }).join('') + '</table></div>' : '<div class=\"muted\">No previous versions yet.</div>') + '</div>';\n    return h + '</div>';\n  }\n  function loadPages() { if (!has('inventory')) return; post('admin_pages', { act: 'status' }).then(function (j) { if (j.ok) S.pages = j; if (S.tab === 'pages') render(); }).catch(function () {}); }\n  function pagesCall(type, data) { S.busy = true; render(); post(type, data).then(function (j) { S.busy = false; S.opsErr = !j.ok; S.opsMsg = j.ok ? (j.msg || 'Done.') : j.error; if (j.ok && j.files) S.pages = j; render(); }).catch(function () { S.busy = false; S.opsErr = true; S.opsMsg = 'Could not reach the Google Script.'; render(); }); }\n  function buildPage(file) {\n    if (!file) return; var r = new FileReader();\n    r.onload = function () {\n      var html = String(r.result || ''); var P = window.SparklingPatcher;\n      if (!P) { S.pageBuild = { ok: false, error: 'The page builder is not available in this copy of the page.', report: [] }; render(); return; }\n      window.__SJ_PATCHER_SRC = srcOf('sj-patcher-src');\n      S.opsMsg = 'Preparing ' + file.name + '\u2026'; S.opsErr = false; render();\n      Promise.resolve(P.patch(html, { api: API(), adminJs: srcOf('sj-admin-src'), pageJs: srcOf('sj-page-src'), uxJs: srcOf('sj-ux-src'), version: file.name.replace(/\\.html?$/i, '') + ' \u00b7 ' + new Date().toISOString().slice(0, 10) })).then(function (res) {\n        var name = res.kind === 'gemstones' ? 'gemstones.html' : res.kind === 'jewelry' ? 'jewelry.html' : 'index.html';\n        S.pageBuild = { ok: !!res.ok, error: res.error || '', report: res.report || [], html: res.html || '', kind: res.kind || '', name: name, src: file.name }; S.opsMsg = ''; render();\n      }).catch(function (e) { S.pageBuild = { ok: false, error: String(e && e.message || e), report: [] }; S.opsMsg = ''; render(); });\n    };\n    r.readAsText(file);\n  }\n  function download(name, text) { var a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([text], { type: 'text/html' })); a.download = name; document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 2000); }\n  function loadJewelry() { if (!has('inventory')) return; post('admin_jewelry', { act: 'get' }).then(function (j) { if (j.ok) S.jewelry = j; if (S.tab === 'pricing') render(); }).catch(function () {}); }\n  function jewelryCall(data) { S.busy = true; render(); post('admin_jewelry', data).then(function (j) { S.busy = false; S.opsErr = !j.ok; S.opsMsg = j.ok ? (j.msg || 'Saved.') : j.error; if (j.ok) S.jewelry = j; render(); }).catch(function () { S.busy = false; render(); }); }\n  function loadPricing() { if (!has('inventory')) return; post('admin_pricing', { act: 'get' }).then(function (j) { if (j.ok) S.pricing = j; return post('admin_bundles', { act: 'list' }); }).then(function (j) { if (j && j.ok) S.bundles = j.bundles; if (S.tab === 'pricing') render(); loadJewelry(); }).catch(function () {}); }\n  function pricingCall(type, data) { S.busy = true; render(); post(type, data).then(function (j) { S.busy = false; S.opsErr = !j.ok; S.opsMsg = j.ok ? (j.msg || 'Saved.') : j.error; if (j.ok && j.overrides) S.pricing = j; if (j.ok && j.bundles) S.bundles = j.bundles; if (j.ok && j.settings && S.ops) S.ops.settings = j.settings; render(); }).catch(function () { S.busy = false; render(); }); }\n\n  /* ---------- admin tour ---------- */\n  function tourSteps() {\n    var all = [\n      ['overview', '[data-tab=overview]', 'Home', 'Your day at a glance: new requests, emails waiting for approval, stones that came back, sync health. Everything here links to its section. The date range at the top applies to every report.'],\n      ['orders', '[data-tab=orders]', 'Orders', 'Every request from every page \u2014 diamonds, gemstones and jewelry offers, including the ones imported from the promo page. Click a row to open it: set the status (New \u2192 Contacted \u2192 Confirmed \u2192 Paused \u2192 In progress \u2192 Fulfilled / Not fulfilled / Cancelled), add a memo that goes into the customer email, verify RJO / NIJA membership, see the exact filters the buyer used and where they came from. Known customers (linked to an ERP # with KYC on file) show a green VERIFIED badge \u2014 no re-checking. Questions about a stone (video, photos, details) arrive here too, marked QUESTION, with the reply waiting in the Outbox. MINE shows only your own customers.'],\n      ['vmatch', '[data-tab=vmatch]', 'Video matches', 'Diamonds with no video of their own borrow the photo and video of their closest twin, labelled \u201csimilar diamond shown\u201d and never with a link to the real video. Twins and good matches switch on automatically every time inventory updates. The rest wait here: USE THIS VIDEO or DON\u2019T USE, and the site picks it up within 5 minutes.'],\n      ['outbox', '[data-tab=outbox]', 'Outbox \u00b7 approve emails', 'No customer email leaves without a person looking at it. Open an email to see it exactly as the customer will, edit the text, reassign it to a colleague, then APPROVE & SEND or REJECT. Automatic emails (still interested?, last call, a wanted stone is back, similar stones) all land here first.'],\n      ['follow', '[data-tab=follow]', 'Follow-ups', 'Stones buyers asked for while they were on hold, and sourcing requests. When a stone frees up or a match arrives, the buyer\u2019s email is drafted for you. NOTIFY / SEND SIMILAR do it by hand.'],\n      ['customers', '[data-tab=customers]', 'Customers', 'One line per buyer with order count, open orders and value, their owner, and the channel they use (WhatsApp / email). LINK attaches their ERP customer # and KYC status, or paste the whole ERP customer export once \u2014 from then on their orders are verified automatically. Below: anonymous carts \u2014 people who added stones but never sent \u2014 and the Mailchimp match-up that puts names on them.'],\n      ['inventory', '[data-tab=inventory]', 'Inventory & sync', 'What the page shows right now, the OneDrive workbook sync (every 15 min, 24/7), TEST CONNECTION, SYNC NOW, and a manual CSV upload. \u201cValue fixes\u201d is where you tell the page what an unknown shape code or availability word means \u2014 it emails you once when the sheet says something new.'],\n      ['promos', '[data-tab=promos]', 'Promotions & sale', 'Flag stock numbers as PROMO or SALE (fixed price or % off). The page highlights them; members never get an extra discount on promoted stones.'],\n      ['pricing', '[data-tab=pricing]', 'Pricing \u00b7 groups \u00b7 bundles', 'Adjust every price by a %, hide prices unless someone has a price-list link, one-off overrides, RJO / NIJA rules (6% off loose, tiers, $35 shipping), bundles (N stones for one price), and the stud / tennis-bracelet prices for the Jewelry Offers tab \u2014 lower one and the page shows the old price struck through.'],\n      ['insights', '[data-tab=insights]', 'Insights', 'What buyers do on the page: visits, funnel and drop-off, every filter option (demand vs what you stock), searches that found nothing, popular stones, page UX problems, and smart suggestions for buying and promoting. Jewelry-page activity is included.'],\n      ['posthog', '[data-tab=posthog]', 'PostHog', 'If you connect PostHog, its dashboard and quick numbers show here next to the Google Sheet tracking.'],\n      ['emails', '[data-tab=emails]', 'Email design', 'The templates for every automatic email with a live preview, your own HTML signature, the company signature, logo and footer, and the sales@ sending address.'],\n      ['settings', '[data-tab=settings]', 'Automation & settings', 'Link the other pages\u2019 Google Sheets so their orders and visits flow in; hold rules; the \u201cstill interested?\u201d and last-call timing; shipping fees; sync interval; PostHog and Mailchimp keys; the API key for Sparkling Intelligence.'],\n      ['pages', '[data-tab=pages]', 'Page designs', 'Drop a new Claude Design export here. It is prepared automatically and can be published to Netlify with one click. Every version is kept \u2014 roll back any time. Orders and data are never inside the HTML, so a new design never loses anything.'],\n      ['team', '[data-tab=team]', S.role === 'owner' ? 'Team & security' : 'My account', S.role === 'owner' ? 'Add or remove staff, decide who may publish inventory (max 2), require 2-step verification, reset logins, sign people out everywhere, and print offline recovery codes for yourself.' : 'Change your password, set up 2-step verification and your email signature.']\n    ];\n    return all.filter(function (st) { return tabsFor().some(function (t) { return t[0] === st[0]; }); });\n  }\n  function tourStart() { S.tour = 0; var st = tourSteps()[0]; if (st && S.tab !== st[0]) { S.tab = st[0]; } render(); }\n  function tourStop(done) { S.tour = nu