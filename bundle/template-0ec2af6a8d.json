' +\n        '<button class=\"b pri\" type=\"submit\">CREATE + SEND THE PASSWORD LINK</button></form>' +\n        (S.newCode && S.newCode.emailed ? '<div class=\"note ok\"><b>' + esc(S.newCode.username) + '</b> \u2014 password link emailed to <b>' + esc(S.newCode.email) + '</b> (valid ' + S.newCode.expiresHours + ' hours, works once). Backup code if the email doesn\u2019t land: <span class=\"code\">' + esc(S.newCode.setupCode) + '</span></div>' : '') +\n        (S.newCode && !S.newCode.emailed ? '<div class=\"note ok\"><b>' + esc(S.newCode.username) + '</b> \u2014 one-time code, valid ' + S.newCode.expiresHours + ' hours:<br><span class=\"code\">' + esc(S.newCode.setupCode) + '</span><br>Or send this link: <input class=\"in\" style=\"width:100%;margin-top:6px\" readonly value=\"' + esc(location.href.split('#')[0] + '#sjsetup=' + S.newCode.username + '.' + S.newCode.setupCode) + '\"><div class=\"muted\" style=\"margin-top:6px\">Verify who you\u2019re talking to first, then deliver it directly (text or in person). It\u2019s shown only once.</div></div>' : '') + '</div>';\n      h += '<div class=\"card\" style=\"grid-column:1/-1\"><h2>USERS & PERMISSIONS</h2>' + (S.teamMsg ? '<div class=\"note ' + (S.teamErr ? 'err' : 'ok') + '\">' + esc(S.teamMsg) + '</div>' : '') + (t ? '<div class=\"tw\"><table><tr><th>USER</th><th>ROLE</th><th>EMAIL</th><th>INVENTORY</th><th>REPORTS</th><th>REQUESTS</th><th>SALES</th><th>STATUS</th><th>2-STEP</th><th>LAST LOGIN</th><th></th></tr>' + t.users.map(function (u) {\n        var me = u.user === S.user, own = u.role === 'owner';\n        var cb = function (p) { var on = (u.perms || []).indexOf(p) >= 0; var lock = own && p !== 'inventory'; return '<td><input type=\"checkbox\" data-perm=\"' + p + '\" data-u=\"' + esc(u.user) + '\" data-v=\"' + u.version + '\" ' + (on ? 'checked' : '') + (lock ? ' disabled title=\"Owners always have this\"' : '') + '></td>'; };\n        var st = !u.active ? '<span style=\"color:#C8554F\">Deactivated</span>' : u.hasPassword ? 'Active' : u.pendingCode ? 'Waiting for code (until ' + esc(u.codeExpires) + ')' : 'Needs a new code';\n        var acts = me ? '<span class=\"muted\">You</span>' : '<button class=\"b\" data-uact=\"reset\" data-u=\"' + esc(u.user) + '\" data-v=\"' + u.version + '\">RESET</button> <button class=\"b\" data-uact=\"revoke\" data-u=\"' + esc(u.user) + '\" data-v=\"' + u.version + '\">SIGN OUT EVERYWHERE</button> <button class=\"b\" data-uact=\"' + (u.active ? 'deactivate' : 'activate') + '\" data-u=\"' + esc(u.user) + '\" data-v=\"' + u.version + '\">' + (u.active ? 'DEACTIVATE' : 'REACTIVATE') + '</button> ' + (S.confirmDel === u.user ? '<button class=\"b danger\" data-uact=\"delete\" data-u=\"' + esc(u.user) + '\" data-v=\"' + u.version + '\">CONFIRM DELETE</button>' : '<button class=\"b danger\" data-uact=\"askdel\" data-u=\"' + esc(u.user) + '\">DELETE</button>');\n        return '<tr><td><b style=\"color:#261d3d\">' + esc(u.user) + '</b></td><td><select data-role=\"1\" data-u=\"' + esc(u.user) + '\" data-v=\"' + u.version + '\" ' + (me ? 'disabled' : '') + '><option value=\"staff\"' + (own ? '' : ' selected') + '>staff</option><option value=\"owner\"' + (own ? ' selected' : '') + '>owner</option></select></td>' + '<td class=\"muted\" style=\"font-size:11px\">' + esc(u.email || '\u2014') + '</td>' + cb('inventory') + cb('reports') + cb('requests') + cb('sales') + '<td>' + st + '</td><td>' + (u.twofa ? 'On' : 'Off') + '</td><td>' + esc(u.lastLogin ? new Date(u.lastLogin).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : '\u2014') + '</td><td style=\"white-space:nowrap\">' + acts + '</td></tr>';\n      }).join('') + '</table></div><div class=\"muted\" style=\"margin-top:8px\">Only ' + (t.inventoryMax || 2) + ' people can have Inventory (upload, sync, publish). Changes are checked on the server; if two owners edit the same person at once, the second is asked to reload.</div>' : '<div class=\"muted\">Loading\u2026</div>') + '</div>';\n      if (t && t.audit) h += '<div class=\"card\" style=\"grid-column:1/-1\"><h2>SECURITY LOG (LATEST 40)</h2><div class=\"tw\"><table><tr><th>WHEN</th><th>WHO</th><th>ACTION</th><th>DETAILS</th></tr>' + t.audit.map(function (a) { return '<tr><td>' + esc(a[0]) + '</td><td>' + esc(a[1]) + '</td><td>' + esc(a[2]) + '</td><td>' + esc(a[3]) + '</td></tr>'; }).join('') + '</table></div><div class=\"muted\">Full history is in the AuditLog tab of the Google Sheet. Passwords and codes are never logged.</div></div>';\n      if (t && t.devices) {\n        var DV = t.devices; var LG = t.logins || []; var lf = S.loginF || '';\n        h += '<div class=\"card\" style=\"grid-column:1/-1\"><h2>DEVICES \u00b7 WHO SIGNS IN FROM WHERE</h2><div class=\"muted\" style=\"margin-bottom:8px\">Every successful sign-in is recorded with the device, browser, system, screen and timezone. A sign-in from a device never seen before emails the owners. (Apps Script does not expose IP addresses.)</div>' +\n          '<table class=\"t\"><tr><th>LOGIN</th><th>DEVICES</th></tr>' + Object.keys(DV).sort().map(function (u) { return '<tr><td><b>' + esc(u) + '</b></td><td>' + DV[u].map(function (d) { return '<div style=\"margin:2px 0\">' + esc(d.label) + (d.screen ? ' \u00b7 ' + esc(d.screen) : '') + (d.tz ? ' \u00b7 ' + esc(d.tz) : '') + ' <span class=\"muted\">\u00b7 ' + d.n + ' sign-in' + (d.n === 1 ? '' : 's') + ' \u00b7 first ' + esc(d.first) + ' \u00b7 last ' + esc(d.last) + '</span></div>'; }).join('') + '</td></tr>'; }).join('') + '</table></div>';\n        h += '<div class=\"card\" style=\"grid-column:1/-1\"><h2>SIGN-INS \u00b7 LAST ' + LG.length + '</h2><div style=\"display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px\"><button class=\"b ' + (lf === '' ? 'pri' : '') + '\" data-loginf=\"\">ALL</button>' + Object.keys(DV).sort().map(function (u) { return '<button class=\"b ' + (lf === u ? 'pri' : '') + '\" data-loginf=\"' + esc(u) + '\">' + esc(u.toUpperCase()) + '</butt